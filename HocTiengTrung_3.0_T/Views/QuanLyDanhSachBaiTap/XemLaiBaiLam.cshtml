@using HocTiengTrung_3._0_T.Models12.LuuLichSu
@model IEnumerable<ChiTietLichSuModels>

@{
    ViewData["Title"] = "Chi tiết kết quả luyện tập";
    int stt = 1;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary mb-0"><i class="fas fa-history me-2"></i>Chi tiết bài làm</h2>
            <p class="text-muted small mb-0">Xem lại các câu hỏi đã thực hiện</p>
        </div>
        <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm rounded-pill mb-2">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            var cauHoi = item.IdCauHoiNavigation;
            // Ép kiểu an toàn cho bool?
            bool isCorrect = item.LaDung ?? false;

            <div class="card mb-4 shadow-sm @(isCorrect ? "border-success" : "border-danger")">
                <div class="card-header d-flex justify-content-between align-items-center @(isCorrect ? "bg-success text-white" : "bg-danger text-white")">
                    <strong class="fs-5">Câu @(stt++):</strong>
                    <span>
                        <i class="fas @(isCorrect ? "fa-check-circle" : "fa-times-circle") me-1"></i>
                        @(isCorrect ? "Chính xác!" : "Chưa đúng")
                    </span>
                </div>

                <div class="card-body">
                    <h5 class="card-title text-dark mb-3">@cauHoi?.NoiDung</h5>

                    @if (!string.IsNullOrEmpty(cauHoi?.AmThanhPath))
                    {
                        <div class="mb-3 p-2 bg-light rounded d-inline-block border">
                            <audio controls class="align-middle" style="height: 35px;">
                                <source src="@cauHoi.AmThanhPath" type="audio/mpeg">
                                Trình duyệt của bạn không hỗ trợ.
                            </audio>
                        </div>
                    }

                    <div class="list-group">
                        @if (cauHoi?.DapAns != null)
                        {
                            foreach (var da in cauHoi.DapAns)
                            {
                                string bietDanh = "";
                                string classMau = "list-group-item-light";

                                // Logic hiển thị màu sắc đáp án
                                bool laDapAnDung = da.LaDapAnDung;
                                bool laCauNguoiDungChon = (item.CauTraLoiNguoiDung == da.NoiDungDapAn);

                                if (laDapAnDung)
                                {
                                    classMau = "list-group-item-success fw-bold";
                                    bietDanh = " <i class='fas fa-check-circle text-success'></i> <small class='text-success'>(Đáp án đúng)</small>";
                                }

                                if (laCauNguoiDungChon && !laDapAnDung)
                                {
                                    classMau = "list-group-item-danger fw-bold";
                                    bietDanh = " <i class='fas fa-times-circle text-danger'></i> <small class='text-danger'>(Bạn đã chọn)</small>";
                                }
                                else if (laCauNguoiDungChon && laDapAnDung)
                                {
                                    bietDanh = " <i class='fas fa-check-double text-success'></i> <small class='text-success'>(Bạn chọn đúng)</small>";
                                }

                                <div class="list-group-item @classMau d-flex justify-content-between align-items-center mb-1 rounded border">
                                    <span>@da.NoiDungDapAn</span>
                                    <span>@Html.Raw(bietDanh)</span>
                                </div>
                            }
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(cauHoi?.GiaiThich))
                    {
                        <div class="mt-4 p-3 bg-light border-start border-info border-4 rounded-end">
                            <h6 class="text-info"><i class="fas fa-lightbulb text-warning me-2"></i>Giải thích & Dịch nghĩa:</h6>
                           
                            <p class="mb-0 text-secondary" style="font-style: italic; white-space: pre-line;">
                                @cauHoi.GiaiThich
                            </p>
                           
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5">
            <img src="https://cdn-icons-png.flaticon.com/512/7486/7486744.png" width="120" class="mb-3 opacity-50" />
            <h4 class="text-muted">Không tìm thấy dữ liệu bài làm.</h4>
            <a href="@Url.Action("LichSuLuyenTap")" class="btn btn-primary mt-3">Quay lại lịch sử</a>
        </div>
    }
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <style>
        .list-group-item {
            transition: transform 0.2s;
            border-left-width: 5px !important;
        }

        .card {
            border-radius: 12px;
            border: none;
        }

        .card-header {
            border-bottom: none;
            padding: 12px 20px;
        }

        .shadow-sm {
            box-shadow: 0 .125rem .25rem rgba(0,0,0,.075) !important;
        }

        /* Tùy chỉnh màu sắc để trông hiện đại hơn */
        .bg-success {
            background-color: #2ecc71 !important;
        }

        .bg-danger {
            background-color: #e74c3c !important;
        }

        .list-group-item-success {
            background-color: #eafaf1;
            border-left-color: #2ecc71 !important;
        }

        .list-group-item-danger {
            background-color: #fdedec;
            border-left-color: #e74c3c !important;
        }
    </style>
}