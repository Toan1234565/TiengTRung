@model List<HocTiengTrung_3._0_T.Models12.BaiTap.CauHoiModels>
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Quản lý câu hỏi Admin";
    int currentCapDo = ViewBag.CurrentCapDo ?? 1;
    int currentLoai = ViewBag.CurrentLoai ?? 1;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    bool trangThai = ViewBag.CurrentTrangThai ?? true;

    var context = HttpContextAccessor.HttpContext;
    var user = context?.User;
    var session = context?.Session;
    string currentVaiTro = User.FindFirst("TenVaiTro")?.Value
                        ?? Context.Session.GetString("TenVaiTro")
                        ?? "";
    string vaiTroClean = (currentVaiTro ?? "").Trim();
    bool isQuanLy = vaiTroClean.Equals("Quản lý trung tâm", StringComparison.OrdinalIgnoreCase)
                   || (user?.IsInRole("Quản lý trung tâm") ?? false);
    var loaiDeDict = new Dictionary<int, string>
    {
        // Các loại đề cũ
        {1, "Trắc nghiệm"},
        {2, "Điền vào chỗ trống"},
        {3, "Sắp xếp câu"},
        {4, "Dịch thuật Trung - Việt"},
        {5, "Dịch Thuật Việt - Trung"},
        {1002, "Luyện nghe"},
        {1003, "Sửa lỗi sai"},
        {1004, "Đọc hiểu đoạn văn"},
        {1016,"Sắp xếp hội thoại"},
        {1021,"Sữa lỗi sai tự luận"},
        {1022,"Đọc hiểu trắc nghiệm"},
        {1025, "Luyện nói đọc câu"},
        {1026, "Luyện nghe và lặp lại"},

        // Các loại đề mới được bổ sung từ file "image_d5ef88.png"
        {1005, "Trắc nghiệm 2.0 "},
        {1006, "Điền vào chỗ trống 2.0 "},
        {1007, "Sắp xếp câu 2.0 "},
        {1008, "Dịch thuật Trung - Việt 2.0 "},
        {1009, "Dịch thuật Việt - Trung 2.0 "},
        {1010, "Sửa lỗi sai 2.0"},
        {1011, "Đọc hiểu 2.0"},
        {1012, "Dịch thuật Việt - Trung Tự luận 2.0"},
        {1013, "Dịch thuật Trung - Việt Tự luận 2.0"},
        {1014,"Luyện nghe ghi chép 2.0 "},
        {1015, "Sắp xếp hội thoại 2.0"},
         {1017, "Sữa lỗi sai tự luận 2.0"},
         {1018, "Luyện nghe đúng sai"},
         {1019, "Luyên nghe trắc nghiêm "}
    };
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@500;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f8f9fa;
            color: #333;
        }

        .filter-section {
            background: #fff;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.05);
            margin-bottom: 25px;
        }

        /* Table Excel Style */
        .table-container {
            background: #fff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 2px 12px rgba(0,0,0,0.05);
        }

        .table {
            margin-bottom: 0;
            vertical-align: middle;
        }

            .table thead {
                background-color: #f1f3f5;
                border-bottom: 2px solid #dee2e6;
            }

                .table thead th {
                    font-weight: 600;
                    color: #495057;
                    text-transform: uppercase;
                    font-size: 0.85rem;
                    padding: 15px;
                }

            .table tbody tr:hover {
                background-color: #f8f9fa;
            }

            .table td {
                padding: 12px 15px;
                border-color: #f1f3f5;
            }

        /* Custom Checkbox */
        .form-check-input:checked {
            background-color: #198754;
            border-color: #198754;
        }

        .chu-han-txt {
            font-family: 'Noto Sans SC', sans-serif;
            font-weight: 500;
            color: #dc3545;
            font-size: 1.1rem;
        }

        .pagination-container {
            margin-top: 2rem;
        }
    </style>
</head>
<body>
    <main class="container-fluid py-4 px-4">
        <h3 class="fw-bold mb-4">Danh sách câu hỏi HSK</h3>
        @if(isQuanLy)
        {
            <div class="mb-3">
                <a href="/QuanLyDanhSachBaiTap/QuanLyLoaiBaiTapAdmin" class="btn btn-primary text-white w-100 btn-rounded shadow-sm fw-medium">
                    <i class="bi bi-list-task me-2"></i> Quản lý loại bài tập
                </a>
            </div>
        }
        
        <div class="filter-section mb-4">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <form method="get" action="@Url.Action("DanhSachQuanLyAdmin")" class="row g-4 align-items-end">
                    <input type="hidden" name="page" value="1" />

                    <div class="col-md-2">
                        <label class="form-label text-muted small fw-bold text-uppercase"><i class="fas fa-layer-group me-1"></i> Cấp độ</label>
                        <select name="idCapDo" class="form-select border-1 rounded-3 shadow-none" onchange="this.form.submit()">
                            @for (int i = 1; i <= 6; i++)
                            {
                                <option value="@i" selected="@(currentCapDo == i ? "selected" : null)">HSK @i</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label text-muted small fw-bold text-uppercase"><i class="fas fa-list-ul me-1"></i> Loại bài tập</label>
                        <select name="idLoai" class="form-select border-1 rounded-3 shadow-none" onchange="this.form.submit()">
                            @foreach (var loai in loaiDeDict)
                            {
                                <option value="@loai.Key" selected="@(currentLoai == loai.Key ? "selected" : null)">@loai.Value</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label text-muted small fw-bold text-uppercase"><i class="fas fa-toggle-on me-1"></i> Trạng thái</label>
                        <select name="trangThai" class="form-select border-1 rounded-3 shadow-none" onchange="this.form.submit()">
                            <option value="true" selected="@(trangThai ? "selected" : null)">Hoạt động</option>
                            <option value="false" selected="@(!trangThai ? "selected" : null)">Không hoạt động</option>
                        </select>
                    </div>

                    <div class="col-md-4 text-md-end">
                        <div class="btn-group" role="group">
                            <button type="button" id="btnDeleteSelected" class="btn btn-outline-danger px-3">
                                <i class="fas fa-trash-alt me-1"></i> Xóa
                            </button>
                            <button type="button" id="btnDeactivateSelected" class="btn btn-outline-warning">
                                Vô hiệu hóa
                            </button>
                            <button type="button" id="btnActivateSelected" class="btn btn-outline-success">
                                Kích hoạt
                            </button>
                            <a href="@Url.Action("DanhSachQuanLyAdmin")" class="btn btn-outline-secondary px-3">
                                <i class="fas fa-sync-alt"></i>
                            </a>
                        </div>
                    </div>
                </form>
                
            </div>
        </div>

        <div class="table-container">
            <table class="table">
                <thead>
                    <tr>
                        <th style="width: 40px;">
                            <input class="form-check-input" type="checkbox" id="selectAll">
                        </th>
                        <th style="width: 80px;">Mã số</th>
                        <th>Nội dung (Chữ Hán)</th>
                        <th>Phiên âm / Ý nghĩa</th>                      
                        <th style="width: 120px;" class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <input class="form-check-input item-checkbox" type="checkbox" value="@item.IdCauHoi">
                                </td>
                                <td class="text-muted small">#@item.IdCauHoi</td>
                                <td>
                                    <span class="chu-han-txt">@item.DoanVan</span>
                                </td>
                                <td>
                                    <div class="text-dark">@item.NoiDung</div>
                                    @if (!string.IsNullOrEmpty(item.GiaiThich))
                                    {
                                        <div class="text-muted small fst-italic">@item.GiaiThich</div>
                                    }
                                </td>
                              
                                <td class="text-center">
                                    <div class="btn-group">
                                        @if (!string.IsNullOrEmpty(item.AmThanhPath))
                                        {
                                            <button class="btn btn-link text-success p-1" title="Nghe" onclick="playAudio('@item.AmThanhPath', this)">
                                                <i class="fas fa-volume-up"></i>
                                            </button>
                                        }
                                        <button type="button" class="btn btn-link text-primary p-1" title="Sửa" onclick="openEditModal(@item.IdCauHoi)">
                                            <i class="fas fa-edit"></i>
                                        </button>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">Không tìm thấy dữ liệu phù hợp.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div class="pagination-container">
                <nav>
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("DanhSachQuanLyAdmin", new { idCapDo = currentCapDo, idLoai = currentLoai, page = currentPage - 1 })">Trước</a>
                        </li>
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            if (p == 1 || p == totalPages || (p >= currentPage - 2 && p <= currentPage + 2))
                            {
                                <li class="page-item @(currentPage == p ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("DanhSachQuanLyAdmin", new { idCapDo = currentCapDo, idLoai = currentLoai, page = p })">@p</a>
                                </li>
                            }
                        }
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("DanhSachQuanLyAdmin", new { idCapDo = currentCapDo, idLoai = currentLoai, page = currentPage + 1 })">Sau</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </main>
    <div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="editModalLabel"><i class="fas fa-edit me-2"></i>Chỉnh sửa câu hỏi <span id="displayId"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="formEditCauHoi">
                        <input type="hidden" id="editIdCauHoi" name="IdCauHoi">
                        <input type="hidden" id="editIdDoanVan" name="IdDoanVan">

                        <div class="row">
                            <div class="col-md-6 border-end">
                                <h6 class="fw-bold text-primary border-bottom pb-2">Thông tin chung</h6>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Nội dung câu hỏi (Chữ Hán/Đề bài)</label>
                                    <textarea class="form-control" id="editNoiDung" rows="2" required></textarea>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Cấp độ</label>
                                        <select class="form-select" id="editIdCapDo">
                                            @for (int i = 1; i <= 6; i++)
                                            {
                                                <option value="@i">HSK @i</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Loại bài tập</label>
                                        <select class="form-select" id="editIdLoai">
                                            <option value="1">Trắc nghiệm</option>
                                            <option value="1002">Luyện nghe</option>
                                            <option value="1004">Đọc hiểu</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Đường dẫn âm thanh (nếu có)</label>
                                    <input type="text" class="form-control" id="editAmThanhPath">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold">Giải thích đáp án</label>
                                    <textarea class="form-control" id="editGiaiThich" rows="3"></textarea>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <h6 class="fw-bold text-success border-bottom pb-2">Đoạn văn đi kèm (Nếu có)</h6>
                                <div id="doanVanSection" class="p-2 bg-light rounded">
                                    <div class="mb-2">
                                        <label class="form-label small">Tiêu đề đoạn văn</label>
                                        <input type="text" class="form-control form-control-sm" id="editTieuDeDV">
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small">Nội dung (Hán tự)</label>
                                        <textarea class="form-control form-control-sm" id="editNoiDungHanDV" rows="3"></textarea>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small">Phiên âm (Pinyin)</label>
                                        <textarea class="form-control form-control-sm" id="editNoiDungPinyinDV" rows="2"></textarea>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small">Dịch tiếng Việt</label>
                                        <textarea class="form-control form-control-sm" id="editNoiDungVietDV" rows="2"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr>

                        <h6 class="fw-bold text-danger border-bottom pb-2">Danh sách 4 đáp án (Chọn vòng tròn cho đáp án đúng)</h6>
                        <div id="dapAnContainer" class="row">
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" class="btn btn-primary" onclick="saveChanges()">Lưu thay đổi</button>
                </div>
            </div>
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/quanly_baitap/edit_baitap.js"></script>
    <script>
            document.addEventListener("DOMContentLoaded", function() {
                // Kiểm tra cờ từ chối quyền truy cập
                const isAccessDenied = "@(TempData["AccessDenied"]?.ToString() ?? "")" === "true";
                const errorMessage = "@Html.Raw(TempData["ErrorMessage"]?.ToString() ?? "Bạn không có quyền truy cập chức năng này!")";

                if (isAccessDenied) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Truy cập bị từ chối!',
                        text: errorMessage,
                        timer: 2500, // Tự động đóng sau 2.5 giây
                        timerProgressBar: true,
                        confirmButtonText: 'Quay lại Trang chủ',
                        confirmButtonColor: '#d33',
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    }).then(() => {
                        // Chuyển hướng ngay về trang chủ
                        window.location.href = "/";
                    });

                    // Tự động chuyển hướng phòng khi người dùng không bấm nút
                    setTimeout(function() {
                        window.location.href = "/";
                    }, 2600);
                }
            });
        $(document).ready(function () {
            // 1. Khởi tạo Bootstrap Modal
            editModal = new bootstrap.Modal(document.getElementById('editModal'));

            // 2. Xử lý Checkbox "Chọn tất cả"
            $('#selectAll').on('change', function () {
                $('.item-checkbox').prop('checked', this.checked);
            });


            // 4. Xử lý Vô hiệu hóa hàng loạt
            // Thay đoạn gắn sự kiện cũ bằng cách này
            $('#btnDeactivateSelected').off('click').on('click', function (e) {
                e.preventDefault(); // Ngăn chặn mọi hành vi mặc định (nếu có)
                console.log("Nút đã được click");
                handleBulkAction('DEACTIVATE');
            });

            $('#btnDeleteSelected').off('click').on('click', function (e) {
                e.preventDefault();
                handleBulkAction('DELETE');
            });

            $('#btnActivateSelected').off('click').on('click', function (e) {
                e.preventDefault();
                handleBulkAction('ACTIVATE');
            });
        });

        function handleBulkAction(actionType) {
            let selectedIds = [];
            $('.item-checkbox:checked').each(function () {
                selectedIds.push(parseInt($(this).val()));
            });

            if (selectedIds.length === 0) {
                Swal.fire({
                    title: 'Thông báo',
                    text: 'Vui lòng chọn ít nhất một câu hỏi!',
                    icon: 'warning',
                    confirmButtonColor: '#3085d6'
                });
                return;
            }


            if (actionType === 'DELETE') {
                confirmDeleteBulk(selectedIds);
            } else if (actionType === 'DEACTIVATE') {
                confirmDeactivateBulk(selectedIds);
            } else if (actionType === 'ACTIVATE') { // Thêm logic này
                confirmActivateBulk(selectedIds);
            }
        }
                // --- 5. VÔ HIỆU HÓA CÂU HỎI (Soft Delete) ---
        function confirmDeactivateBulk(ids) {
            Swal.fire({
                title: `Vô hiệu hóa ${ids.length} câu hỏi?`,
                text: "Các câu hỏi này sẽ tạm thời bị ẩn khỏi giao diện học tập.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#ffc107',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    Swal.fire({ title: 'Đang xử lý...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

                    try {
                        const response = await fetch('/api/quanlybaitap/vo-hieu-hoa-hang-loat', {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(ids)
                        });

                        const result = await response.json();
                        if (result.success) {
                            Swal.fire('Thành công', result.message, 'success')
                                .then(() => location.reload());
                        } else {
                            Swal.fire('Thất bại', result.message, 'error');
                        }
                    } catch (error) {
                        Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ.', 'error');
                    }
                }
            });
        }
                // Thêm hàm này vào dưới hàm confirmDeactivateBulk
        function confirmActivateBulk(ids) {
            Swal.fire({
                title: `Kích hoạt ${ids.length} câu hỏi?`,
                text: "Các câu hỏi này sẽ hiển thị trở lại trên giao diện học tập.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#198754', // Màu xanh lá
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    Swal.fire({ title: 'Đang xử lý...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

                    try {
                        // Lưu ý: Đường dẫn khớp với [HttpPatch("kich-hoat-hang-loat")]
                        const response = await fetch('/api/quanlybaitap/kich-hoat-hang-loat', {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(ids)
                        });

                        const result = await response.json();
                        if (result.success) {
                            Swal.fire('Thành công', result.message, 'success')
                                .then(() => location.reload());
                        } else {
                            Swal.fire('Thất bại', result.message, 'error');
                        }
                    } catch (error) {
                        Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ.', 'error');
                    }
                }
            });
        }
    </script>
</body>
</html>