@model List<HocTiengTrung_3._0_T.Models12.BaiTap.CauHoiModels>
@{
    // 1. Khởi tạo danh sách gốc để phòng hờ Model bị null
    var baseList = Model ?? new List<HocTiengTrung_3._0_T.Models12.BaiTap.CauHoiModels>();

    // 2. Lấy câu hỏi đầu tiên TRƯỚC để trích xuất các thông tin phân loại
    var firstQ = baseList.FirstOrDefault();
    int idCapDo = firstQ?.IdCapDo ?? 0;
    int idLoai = firstQ?.IdLoai ?? 0;

    // 3. Bây giờ mới dùng idLoai để quyết định số lượng phần tử lấy ra (Take)
    var displays = baseList.Take(10).ToList();
    if (idLoai == 1012 || idLoai == 1013)
    {
        displays = baseList.Take(5).ToList();
    }

    // 4. Các biến logic khác
    bool isReadingComprehension = idLoai == 1004 || idLoai == 1011;
    bool isSubmitted = ViewBag.IsSubmitted ?? false;

    // 5. Trích xuất poolWords
    List<string> poolWords = new List<string>();
    if (idLoai == 2 || idLoai == 1006)
    {
        poolWords = displays
            .Where(q => q.DapAns != null) // Bảo vệ chống Null danh sách đáp án
            .Select(q => q.DapAns.FirstOrDefault(d => d.LaDapAnDung)?.NoiDungDapAn)
            .Where(w => !string.IsNullOrEmpty(w))
            .OrderBy(x => Guid.NewGuid())
            .ToList();
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"]</title>

    @* <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"> *@
    <link rel="stylesheet" href="~/css/dannhsachbaitap/lambaithucte.css" asp-append-version="true" />
    
        
</head>
<body>
   
    <main>
        <div class="container quiz-wrapper py-4"
             id="quiz-container-data"
             data-total="@displays.Count"
             data-capdo="@idCapDo"
             data-loai="@idLoai">

            <div class="quiz-container bg-white shadow-lg rounded-4 p-3 p-md-5 animate__animated animate__fadeIn">
                @* Header & Progress Section *@
                <div class="quiz-header mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <a href="javascript:void(0);" onclick="confirmBack()" class="btn btn-sm btn-outline-secondary rounded-pill px-3 transition-all">
                            <i class="fas fa-chevron-left me-1"></i> Quay lại
                        </a>
                        <div class="progress-info text-center">
                            <span class="text-muted fw-bold d-block small">TIẾN ĐỘ LUYỆN TẬP</span>
                            <span class="badge bg-light text-dark border shadow-sm">
                                Câu hỏi <span id="current-idx" class="text-primary">1</span>/@displays.Count
                            </span>
                        </div>
                        <div id="score-text" class="badge bg-success fs-6 shadow-sm px-3 py-2">
                            <i class="fas fa-check-circle me-1"></i> Đúng: 0
                        </div>
                    </div>

                    <div class="progress mb-2" style="height: 10px; border-radius: 20px;">
                        <div id="quiz-progress" class="progress-bar progress-bar-striped progress-bar-animated"
                             role="progressbar" style="width: 0%; background: linear-gradient(45deg, #fd7e14, #ffbc00);"></div>
                    </div>
                </div>

                @* 1. Reading Comprehension Passage *@
                @if (isReadingComprehension && firstQ?.DoanVan != null)
                {
                    <div class="reading-passage-box p-4 mb-4 shadow-sm rounded-4 border-top border-4 border-primary bg-light">
                        <h4 class="text-primary d-flex align-items-center mb-3">
                            <i class="fas fa-book-open me-2"></i> @firstQ.DoanVan.TieuDe
                        </h4>
                        <div class="passage-content">
                            <div class="text-chinese fw-normal mb-3 p-3 bg-white rounded-3 border" style="font-size: 1.35rem; line-height: 2; letter-spacing: 1px;">
                                @firstQ.DoanVan.NoiDungHan
                            </div>

                            <div id="reading-explanation" style="display: @(isSubmitted ? "block" : "none")">
                                <div class="result-explanation mt-3 p-3 border-start border-4 border-info bg-info bg-opacity-10 rounded-end">
                                    <h6 class="text-info fw-bold"><i class="fas fa-language me-2"></i> Dịch nghĩa & Phiên âm:</h6>
                                    @if (!string.IsNullOrEmpty(firstQ.DoanVan.NoiDungPinyin))
                                    {
                                        <div class="text-pinyin mb-2 text-muted fst-italic">@firstQ.DoanVan.NoiDungPinyin</div>
                                    }
                                    @if (!string.IsNullOrEmpty(firstQ.DoanVan.NoiDungViet))
                                    {
                                        <div class="text-viet text-dark">@firstQ.DoanVan.NoiDungViet</div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                        
                }

                @* 2. Fill-in-the-blank Word Pool *@
                @if ((idLoai == 2 || idLoai == 1006) && poolWords != null && poolWords.Any())
                {
                    <div class="word-pool-sticky mb-4 animate__animated animate__fadeInDown">
                        @* Xóa bỏ overflow-hidden nếu sticky không hoạt động *@
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-warning text-dark fw-bold py-2 text-center">
                                <i class="fas fa-th-large me-2"></i> DANH SÁCH TỪ VỰNG GỢI Ý
                            </div>
                            <div class="card-body bg-light">
                                <div class="d-flex flex-wrap gap-2 justify-content-center">
                                    @{
                                        char letterPool = 'A';
                                    }
                                    @foreach (var word in poolWords)
                                    {
                                        <div class="pool-item-card px-3 py-2 bg-white border rounded-3 shadow-sm d-flex align-items-center" data-letter="@letterPool">
                                            <span class="badge bg-warning text-dark me-2">@letterPool</span>
                                            <span class="fw-bold text-chinese">@word</span>
                                        </div>
                                        letterPool++;
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                }

                @* 3. Question Content Area *@
                <div id="quiz-content">
                    @for (int i = 0; i < displays.Count; i++)
                    {
                        var q = displays[i];
                        bool isFillBlank = q.IdLoai == 2 || q.IdLoai == 1006;
                        bool isReorder = q.IdLoai == 3 || q.IdLoai == 1007 || q.IdLoai == 1012 || q.IdLoai == 1013 || q.IdLoai == 1017;
                        bool isListening = (q.IdLoai == 1002 || q.IdLoai == 1014) && !string.IsNullOrEmpty(q.AmThanhPath);
                        bool isReading = q.IdLoai == 1004 || q.IdLoai == 1 || q.IdLoai == 1011;
                        bool isConversationReorder = q.IdLoai == 1015 || q.IdLoai == 1016;
                        bool luyennghedungsai = q.IdLoai == 1018;
                        bool luyennghetracnghiem = q.IdLoai == 1019;
                        bool isLuyenNoiDocCau = q.IdLoai == 1024 || q.IdLoai == 1025;
                        bool isLuyenNgheLapLai = q.IdLoai == 1026 || q.IdLoai == 1027;

                        string typeClass = isFillBlank ? "type-dienkhuyet" : isReorder ? "type-sapxep" : "type-tracnghiem";
                        string typeName = isFillBlank ? "Điền từ" : (isReorder ? "Sắp xếp" : (isListening ? "Chính tả" : "Trắc nghiệm"));
                        bool isSpeakingType = isLuyenNoiDocCau || isLuyenNgheLapLai;

                        <div class="question-container mb-5 border-bottom pb-4 animate__animated animate__fadeIn"
                             id="step-@i"
                             data-id-cauhoi="@q.IdCauHoi"
                             data-type="@q.IdLoai">

                            <div class="d-flex align-items-center mb-3">
                                <span class="badge rounded-pill @typeClass me-2 px-3">Câu @(i + 1): @typeName</span>
                                <hr class="flex-grow-1 my-0 opacity-25">
                            </div>

                            <div class="question-box px-2">
                                @* Case 1: Điền từ (Fill in the blank) *@
                                @if (isFillBlank)
                                {
                                    <div class="question-item-card p-4 rounded-4 bg-white border-dashed mb-3">
                                        <div class="row g-3 align-items-center">
                                            <div class="col-lg-9">
                                                <p class="text-chinese lh-lg mb-0 fs-5 text-dark">
                                                    @q.NoiDung
                                                </p>
                                            </div>
                                            <div class="col-lg-3">
                                                <input type="text" class="form-control border-2 fill-blank-input text-center fw-bold shadow-sm"
                                                       id="input-@i"
                                                       maxlength="1"
                                                       placeholder="Nhập đáp án..."
                                                       data-correct="@q.DapAns.FirstOrDefault(d => d.LaDapAnDung)?.NoiDungDapAn">
                                            </div>
                                        </div>
                                    </div>
                                }

                                @* Case 2: Trắc nghiệm (Reading/Multiple Choice) *@
                                else if (isReading)
                                {
                                    <h5 class="text-chinese mb-4 lh-base">@q.NoiDung</h5>
                                    <div class="answers-list d-grid gap-3">
                                        @foreach (var ans in q.DapAns)
                                        {
                                            <button class="btn btn-answer btn-outline-dark text-start p-3 rounded-3 d-flex align-items-center shadow-sm transition-all"
                                                    data-is-correct="@ans.LaDapAnDung.ToString().ToLower()"
                                                    onclick="selectAnswer(this, @i)">
                                                <span class="answer-text">@ans.NoiDungDapAn</span>
                                            </button>
                                        }
                                    </div>
                                }

                                @* Case 3: Nghe chép chính tả (Listening) *@
                                else if (isListening)
                                {
                                    <div class="listening-box text-center p-4 bg-light rounded-4 mb-3">

                                        <!-- Bộ điều khiển tốc độ -->
                                        <div class="d-flex align-items-center justify-content-end mb-2">
                                            <label for="speed-@i" class="me-2 text-muted" style="font-size: 0.9rem;">Tốc độ:</label>
                                            <select id="speed-@i" class="form-select form-select-sm w-auto"
                                                    onchange="document.getElementById('audio-@i').playbackRate = parseFloat(this.value)">
                                                <option value="0.5">0.5x (Rất chậm)</option>
                                                <option value="0.75">0.75x (Chậm)</option>
                                                <option value="0.8">0.8x</option>
                                                <option value="1.0" selected>1.0x (Chuẩn)</option>
                                                <option value="1.25">1.25x (Nhanh)</option>
                                            </select>
                                        </div>

                                        <!-- Thẻ Audio với ID động -->
                                        <audio id="audio-@i" controls class="w-100 mb-3">
                                            <source src="@q.AmThanhPath" type="audio/mpeg">
                                            Trình duyệt của bạn không hỗ trợ thẻ audio.
                                        </audio>

                                        <textarea id="input-@i" class="form-control border-2" rows="2"
                                                  placeholder="Nhập nội dung bạn nghe được..."
                                                  data-correct="@q.DapAns.FirstOrDefault(d => d.LaDapAnDung)?.NoiDungDapAn"></textarea>
                                    </div>
                                }
                                else if (luyennghedungsai)
                                {
                                    <h5 class="text-chinese mb-4 lh-base">@q.NoiDung</h5>

                                    <!-- Thanh điều khiển: Tốc độ & Âm lượng -->
                                    <div class="d-flex align-items-center justify-content-end gap-3 mb-2">
                                        <!-- Chọn Tốc độ -->
                                        <div class="d-flex align-items-center">
                                            <label for="speed-@i" class="me-2 text-muted" style="font-size: 0.9rem;">Tốc độ:</label>
                                            <select id="speed-@i" class="form-select form-select-sm w-auto"
                                                    onchange="document.getElementById('audio-@i').playbackRate = parseFloat(this.value)">
                                                <option value="0.5">0.5x (Rất chậm)</option>
                                                <option value="0.75">0.75x (Chậm)</option>
                                                <option value="0.8">0.8x</option>
                                                <option value="1.0" selected>1.0x (Chuẩn)</option>
                                                <option value="1.25">1.25x (Nhanh)</option>
                                            </select>
                                        </div>
                                    </div>

                                    <!-- Tự động áp dụng kích âm ngay khi bấm Play bằng onplay -->
                                    <audio id="audio-@i" controls class="w-100 mb-3" onplay="autoApplyVolume(this)">
                                        <source src="@q.AmThanhPath" type="audio/mpeg">
                                        Trình duyệt của bạn không hỗ trợ thẻ audio.
                                    </audio>

                                    <div class="answers-list d-grid gap-3">
                                        @foreach (var ans in q.DapAns.Take(2))
                                        {
                                            <button class="btn btn-answer btn-outline-dark text-start p-3 rounded-3 d-flex align-items-center shadow-sm transition-all"
                                                    data-is-correct="@ans.LaDapAnDung.ToString().ToLower()"
                                                    onclick="selectAnswer(this, @i)">
                                                <span class="answer-text">@ans.NoiDungDapAn</span>
                                            </button>
                                        }
                                    </div>
                                }
                                else if (luyennghetracnghiem)
                                {
                                    <!-- Thanh điều khiển: Tốc độ & Âm lượng -->
                                    <div class="d-flex align-items-center justify-content-end gap-3 mb-2">
                                        <!-- Chọn Tốc độ -->
                                        <div class="d-flex align-items-center">
                                            <label for="speed-@i" class="me-2 text-muted" style="font-size: 0.9rem;">Tốc độ:</label>
                                            <select id="speed-@i" class="form-select form-select-sm w-auto"
                                                    onchange="document.getElementById('audio-@i').playbackRate = parseFloat(this.value)">
                                                <option value="0.5">0.5x (Rất chậm)</option>
                                                <option value="0.75">0.75x (Chậm)</option>
                                                <option value="0.8">0.8x</option>
                                                <option value="1.0" selected>1.0x (Chuẩn)</option>
                                                <option value="1.25">1.25x (Nhanh)</option>
                                            </select>
                                        </div>

                                    </div>

                                    <!-- Tự động áp dụng kích âm ngay khi bấm Play bằng onplay -->
                                    <audio id="audio-@i" controls class="w-100 mb-3" onplay="autoApplyVolume(this)">
                                        <source src="@q.AmThanhPath" type="audio/mpeg">
                                        Trình duyệt của bạn không hỗ trợ thẻ audio.
                                    </audio>

                                       
                                    <div class="answers-list d-grid gap-3">
                                        @foreach (var ans in q.DapAns.Take(q.IdCapDo == 3 ? 3 : 4))
                                        {
                                            <button class="btn btn-answer btn-outline-dark text-start p-3 rounded-3 d-flex align-items-center shadow-sm transition-all"
                                                    data-is-correct="@ans.LaDapAnDung.ToString().ToLower()"
                                                    onclick="selectAnswer(this, @i)">
                                                <span class="answer-text">@ans.NoiDungDapAn</span>
                                            </button>
                                        }
                                    </div>
                                }
                                @* Case 4: Sắp xếp câu (Reorder) *@
                                else if (isReorder)
                                {
                                    <div class="reorder-box p-4 bg-light rounded-4">
                                        @if (idLoai == 3 || idLoai == 1007)
                                        {
                                            <h6 class="text-muted mb-3">Sắp xếp câu thành câu hoàn chỉnh:</h6>
                                        }
                                        else if (idLoai == 1012)
                                        {
                                            <h6 class="text-muted mb-3">Dịch các câu từ tiếng Việt sang Trung:</h6>
                                        }
                                        else if (idLoai == 1013)
                                        {
                                            <h6 class="text-muted mb-3">Dịch các câu từ tiếng Trung sang Việt:</h6>
                                        }
                                        else
                                        {
                                            <h6 class="text-muted mb-3">Sửa câu sao cho đúng:</h6>
                                        }
                                        <h5 class="mb-3 text-primary">@q.NoiDung</h5>
                                        <textarea id="input-@i" class="form-control border-2 fw-bold text-chinese" rows="2"
                                                  placeholder="Gõ câu trả lời tại đây..."
                                                  data-correct="@q.DapAns.FirstOrDefault(d => d.LaDapAnDung)?.NoiDungDapAn"></textarea>
                                    </div>
                                }
                                else if (isConversationReorder)
                                {
                                    <div class="question-container conversation-reorder-box p-4 bg-white border-0 rounded-4 shadow-sm mb-4 position-relative overflow-hidden"
                                         data-id-cauhoi="@q.IdCauHoi"
                                         data-type="1017"
                                         style="box-shadow: 0 .5rem 1rem rgba(0,0,0,.08)!important;">

                                        <div class="position-absolute top-0 start-0 w-100 bg-primary" style="height: 4px; opacity: 0.8;"></div>

                                        <h5 class="text-primary mb-4 lh-base fw-bold d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10 p-2 rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                                                <i class="fas fa-comments text-primary fs-5"></i>
                                            </div>
                                            Sắp xếp các câu dưới đây thành đoạn hội thoại hợp lý:
                                        </h5>

                                        <div class="bg-light bg-gradient p-4 rounded-4 mb-4 border-0 shadow-sm">
                                            @{
                                                // Lấy ra đáp án đúng làm kết quả so sánh
                                                var correctAnswer = q.DapAns.FirstOrDefault(d => d.LaDapAnDung);

                                                // Lọc ra các đáp án cần sắp xếp (A, B, C)
                                                var sortableAnswers = q.DapAns.Where(d => d.IdDapAn != correctAnswer?.IdDapAn).ToList();

                                                char letterLabel = 'A';
                                            }

                                            <div class="d-flex flex-column gap-3">
                                                @foreach (var ans in sortableAnswers)
                                                {
                                                    <div class="answer-item bg-white p-3 rounded-3 d-flex align-items-center shadow-sm border border-2 transition-all hover-border-primary" style="cursor: default; border-color: transparent;">
                                                        <span class="badge bg-primary rounded-pill fs-6 me-3 px-3 py-2 shadow-sm">@(letterLabel++)</span>
                                                        <span class="answer-text fs-5 text-dark fw-medium" style="line-height: 1.6;">@ans.NoiDungDapAn</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <div class="input-area bg-primary bg-opacity-10 p-4 rounded-4 border border-primary border-opacity-25 shadow-sm text-center transition-all">
                                            <label for="input-@i" class="fw-bold text-primary fs-5 mb-3 d-block">
                                                <i class="fas fa-keyboard me-2"></i>Nhập thứ tự đúng
                                            </label>
                                            <input type="text" class="form-control form-control-lg border-2 text-center text-uppercase fw-bold text-primary shadow-sm reorder-input mx-auto"
                                                   id="input-@i"
                                                   style="max-width: 250px; font-size: 1.8rem; letter-spacing: 10px; border-radius: 12px;"
                                                   placeholder="VD: BCA"
                                                   autocomplete="off"
                                                   data-correct="@(correctAnswer?.NoiDungDapAn ?? "")">
                                            <small class="text-muted mt-2 d-block">* Viết liền các chữ cái, không chứa khoảng trắng</small>
                                        </div>
                                    </div>
                                }
                                @* Case: Luyện nói đọc câu (1024, 1025) & Luyện nghe và lặp lại (1026, 1027) *@
                                else if (isSpeakingType)
                                {
                                    var dapAnDung = q.DapAns.FirstOrDefault(d => d.LaDapAnDung)?.NoiDungDapAn ?? q.NoiDung;

                                    <div class="speaking-box p-4 bg-light rounded-4 text-center mb-3 border shadow-sm">
                                        @if (isLuyenNgheLapLai)
                                        {
                                            <div class="mb-3">
                                                <span class="badge bg-info-subtle text-info border px-3 py-2 rounded-pill mb-2">
                                                    <i class="fas fa-headphones me-1"></i> Hãy nghe thật kỹ rồi bấm Micro để nói lại
                                                </span>
                                                @if (!string.IsNullOrEmpty(q.AmThanhPath))
                                                {
                                                    <audio id="audio-@i" controls class="w-100 mb-2">
                                                        <source src="@q.AmThanhPath" type="audio/mpeg">
                                                        Trình duyệt không hỗ trợ audio.
                                                    </audio>
                                                }
                                            </div>
                                            <!-- Chữ Hán câu mẫu có thể bấm để xem hoặc làm mờ nhẹ -->
                                            <p class="text-chinese fs-4 text-dark mb-3 fw-bold">@q.NoiDung</p>
                                        }
                                        else
                                        {
                                            <!-- Luyện nói đọc câu -->
                                            <span class="badge bg-warning-subtle text-dark border px-3 py-2 rounded-pill mb-2">
                                                <i class="fas fa-bullhorn me-1"></i> Đọc to câu tiếng Trung sau:
                                            </span>
                                            <h3 class="text-chinese fw-bold text-primary my-3" style="font-size: 1.85rem; letter-spacing: 1px;">
                                                @q.NoiDung
                                            </h3>
                                            @if (!string.IsNullOrEmpty(q.AmThanhPath))
                                            {
                                                <div class="mb-3">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="document.getElementById('audio-@i').play()">
                                                        <i class="fas fa-volume-up me-1"></i> Nghe mẫu phát âm
                                                    </button>
                                                    <audio id="audio-@i" src="@q.AmThanhPath" class="d-none"></audio>
                                                </div>
                                            }
                                        }

                                        <!-- Khu vực Micro thu âm & nhận diện giọng nói -->
                                        <div class="mic-action-area my-3">
                                            <button type="button"
                                                    class="btn btn-outline-danger btn-mic rounded-circle shadow p-3"
                                                    id="btn-mic-@i"
                                                    onclick="toggleRecordSpeech(@i)"
                                                    style="width: 75px; height: 75px;">
                                                <i class="fas fa-microphone fs-2"></i>
                                            </button>
                                            <p id="mic-status-@i" class="small text-muted mt-2 mb-0">Bấm nút Micro để bắt đầu nói</p>
                                        </div>

                                        <!-- Ô ẩn/hiển thị câu trả lời nhận diện được từ giọng nói -->
                                        <input type="hidden"
                                               class="speaking-result-input"
                                               id="input-@i"
                                               data-target-text="@q.NoiDung"
                                               data-correct="@dapAnDung"
                                               value="" />

                                        <div id="transcript-box-@i" class="transcript-display p-3 bg-white rounded-3 border d-none">
                                            <small class="text-muted d-block mb-1">Văn bản AI ghi nhận được:</small>
                                            <span class="text-chinese fs-5 fw-bold text-dark" id="transcript-text-@i"></span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <h5 class="text-chinese mb-4 lh-base">@q.NoiDung</h5>
                                    <div class="answers-list d-grid gap-3">
                                        @foreach (var ans in q.DapAns)
                                        {
                                            <button class="btn btn-answer btn-outline-dark text-start p-3 rounded-3 d-flex align-items-center shadow-sm transition-all"
                                                    data-is-correct="@ans.LaDapAnDung.ToString().ToLower()"
                                                    onclick="selectAnswer(this, @i)">
                                                <span class="answer-text">@ans.NoiDungDapAn</span>
                                            </button>
                                        }
                                    </div>
                                }
                                @* Explanation Box (Ẩn mặc định) *@
                                @if (idLoai == 1012 || idLoai == 1013)
                                {
                                    <div class="explanation-box mt-4" id="expl-@i" style="display:none;">
                                        <div class="p-3 bg-success bg-opacity-10 rounded-3 border-start border-4 border-success">
                                            <small class="text-success d-block fw-bold mb-1"><i class="fas fa-lightbulb me-2"></i> Đáp án tham khảo (nếu AI lỗi):</small>
                                            <div class="small text-dark" style="white-space: pre-line;">@q.GiaiThich</div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    @if (idLoai == 1010 || idLoai == 1003)
                                    {
                                        <h6 class="text-muted mb-3">Chọn từ bị sai ở câu: </h6>
                                    }
                                    <div class="explanation-box mt-4" id="expl-@i" style="display:none;">
                                        <div class="p-3 bg-success bg-opacity-10 rounded-3 border-start border-4 border-success">
                                            <small class="text-success d-block fw-bold mb-1"><i class="fas fa-lightbulb me-2"></i> GIẢI THÍCH:</small>
                                            <div class="small text-dark" style="white-space: pre-line;">@q.GiaiThich</div>
                                        </div>
                                    </div>
                                }

                            </div>
                        </div>
                    }
                    <div id="review-actions" class="text-center mt-4 mb-3" style="display: none;">
                        <button type="button"
                                onclick="backToDanhSach()"
                                class="btn btn-secondary text-white rounded-pill px-4 py-3 shadow-sm fw-bold me-2">
                            <i class="fas fa-list me-2"></i> Danh sách đề
                        </button>

                    </div>
                </div>

                <div class="text-center mt-5 mb-5">
                    <button type="button" id="btn-submit-all" onclick="submitFullQuiz()" class="btn btn-primary btn-lg rounded-pill px-5 shadow-lg">
                        <i class="fas fa-check-double me-2"></i> HOÀN THÀNH & NỘP BÀI
                    </button>
                </div>



                @* Result Screen *@
                <div id="result-screen" class="text-center p-5 animate__animated animate__zoomIn" style="display:none;">
                    <div class="result-icon mb-4">
                        <div class="trophy-wrapper position-relative d-inline-block">
                            <i class="fas fa-trophy text-warning" style="font-size: 6rem;"></i>
                            <i class="fas fa-crown position-absolute top-0 start-50 translate-middle-x text-danger" style="font-size: 2rem; margin-top: -15px;"></i>
                        </div>
                    </div>
                    <h2 class="fw-bold mb-2">Hoàn thành xuất sắc, Hoàng đế!</h2>
                    <p class="text-muted mb-4">Bạn đã vượt qua bài luyện tập này với số điểm:</p>
                    <div class="display-2 fw-bold text-primary mb-4">
                        <span id="final-score">0</span><small class="fs-2 text-muted">/@displays.Count</small>
                    </div>
                    <div id="save-status" class="mb-4 alert alert-info py-2 d-inline-block px-4 rounded-pill"></div>

                    <div class="d-flex flex-wrap gap-3 justify-content-center mt-2">
                        <button class="btn btn-warning text-white rounded-pill px-4 py-2 shadow" onclick="reviewMyQuiz()">
                            <i class="fas fa-search me-2"></i> Xem lại bài
                        </button>
                        <button class="btn btn-outline-primary rounded-pill px-4 py-2 shadow-sm" onclick="location.reload()">
                            <i class="fas fa-redo me-2"></i> Làm lại
                        </button>
                        <button type="button"
                                onclick="backToDanhSach()"
                                class="btn btn-secondary text-white rounded-pill px-4 py-3 shadow-sm fw-bold me-2">
                            <i class="fas fa-list me-2"></i> Danh sách đề
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <div class="modal fade" id="evaluationModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="evaluationModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body text-center py-4">
                    <h5 class="mb-3" id="evaluationModalLabel">Đang xử lý kết quả</h5>
                    <p id="evaluationModal-text" class="mb-0 text-muted">
                        Vui lòng chờ trong giây lát...
                    </p>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/quanly_baitap/lichsua_luu.js" asp-append-version="true"></script>
    <script>
        // Nhúng trực tiếp trạng thái đăng nhập của ASP.NET Core vào JS
        window.isAuthenticated = @(User.Identity.IsAuthenticated ? "true" : "false");
    </script>
</body>
</html>