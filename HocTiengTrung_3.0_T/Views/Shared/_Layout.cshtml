                                    </div>
                                    <div class="ms-2 text-start">
                                        <p class="mb-0 user-name-text">@hoTenHienThi</p>
                                        <p class="mb-0 user-role-text">
                                            @if (isKimHoa)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold" style="font-size: 0.75rem;">
                                                    <i class="fa-solid fa-leaf me-1"></i>Kim Hoa
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-dark fw-normal" style="font-size: 0.75rem;">@(string.IsNullOrEmpty(currentVaiTro) ? "Học viên" : currentVaiTro)</span>
                                            }
                                        </p>
                                    </div>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg mt-2 border-0 text-center text-lg-start">
                                   
                                    @if (isQuanLy)
                                    {
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="QuanLyTrungTam" asp-action="ChiTietTrungTam" asp-route-id="@idTrungTam">
                                                <i class="fa-solid fa-school me-2 text-success d-none d-lg-inline"></i>Quản lý trung tâm
                                            </a>
                                        </li>
                                    }
                                    else if (isGiangVien)
                                    {
                                        <li>
                                            <a class="dropdown-item py-2"
                                               asp-controller="QuanLyTrungTam"
                                               asp-action="ChiTietNhanSu"
                                               asp-route-id="@currentIdTaiKhoan">
                                                <i class="fa-solid fa-chalkboard-user me-2 text-success d-none d-lg-inline"></i>Hồ sơ giảng viên
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="QuanLyLopHoc" asp-action="DanhSachLopHoc">
                                                <i class="fa-solid fa-book-open-reader me-2 text-primary d-none d-lg-inline"></i>Lớp học phụ trách
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="QuanLyTaiKhoan" asp-action="HoSoNguoiDung">
                                                <i class="fa-solid fa-circle-user me-2 text-primary d-none d-lg-inline"></i>Hồ sơ cá nhân
                                            </a>
                                        </li>
                                    }
                                        <li>
                                        <a class="dropdown-item py-2" href="#">
                                            <i class="fa-solid fa-star me-2 text-warning d-none d-lg-inline"></i>Thành tích học tập
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item py-2 text-danger fw-bold" asp-controller="QuanLyTaiKhoan" asp-action="DangXuat">
                                            <i class="fa-solid fa-right-from-bracket me-2 d-none d-lg-inline"></i>Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="QuanLyTaiKhoan" asp-action="DangNhap" class="text-decoration-none text-dark fw-bold d-none d-lg-block me-2" style="font-size: 16px;">
                                Đăng nhập
                            </a>
                            <a asp-controller="QuanLyTaiKhoan" asp-action="DangKy" class="btn btn-start shadow-sm">
                                <i class="fa-solid fa-user-plus me-1"></i>Đăng ký
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-5">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="text-center text-lg-start">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 col-md-12 mb-4">
                    @if (isKimHoa)
                    {
                        <h5 class="fw-bold" style="color: #b32428;">
                            <i class="fa-solid fa-spa text-success me-1"></i> Tiếng Trung
                        </h5>
                        <p class="text-muted small mt-3">
                            Trung tâm tiếng Trung  - Cơ sở đào tạo chất lượng cao, đồng hành cùng bạn trên con đường chinh phục HSK và giao tiếp tiếng Trung tự tin.
                        </p>
                    }
                    else
                    {
                        <h5 class="fw-bold"><i class="fa-solid fa-dragon text-danger"></i> Học Tiếng Trung .v3</h5>
                        <p class="text-muted small mt-3">
                            Nền tảng học tiếng Trung trực tuyến hiện đại, giúp bạn chinh phục HSK một cách dễ dàng và hiệu quả nhất.
                        </p>
