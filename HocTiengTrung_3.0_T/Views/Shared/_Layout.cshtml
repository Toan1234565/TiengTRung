                    </ul>

                    <!-- User Actions / Hồ sơ -->
                    <div class="user-actions-wrapper d-flex align-items-center justify-content-center justify-content-lg-start gap-2 mt-3 mt-lg-0">
                        @if (isLoggedIn)
                        {
                            <div class="dropdown">
                                <a class="d-flex align-items-center text-decoration-none dropdown-toggle" href="#" id="userDropdown" data-bs-toggle="dropdown">
