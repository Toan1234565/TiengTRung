@using Microsoft.AspNetCore.Http
@{
    // Lấy thông tin Trung tâm từ Claims hoặc Session đã lưu lúc Đăng nhập
    string currentIdTrungTam = User.FindFirst("IdTrungTam")?.Value
                               ?? Context.Session.GetString("IdTrungTam")
                               ?? "0";

    string currentMaTrungTam = User.FindFirst("MaTrungTam")?.Value
                               ?? Context.Session.GetString("MaTrungTam")
                               ?? "";

}

<div class="card border-0 shadow-sm">
    <style>
            .table-log {
                font-size: 0.875rem;
            }

            .table-responsive-log {
                max-height: 65vh;
                overflow-y: auto;
                position: relative;
            }

            .table-log thead th {
                position: sticky;
                top: 0;
                z-index: 10;
                background-color: #f8f9fa !important;
                border-bottom: 2px solid #dee2e6;
                box-shadow: inset 0 -1px 0 #dee2e6;
            }

            .log-row:hover {
                background-color: #fcfcff !important;
                transition: 0.2s;
            }

            .text-action {
                font-weight: 500;
                color: #333;
                line-height: 1.6;
            }

            .change-detail-box {
                background: #f8f9fa;
                border-left: 3px solid #0dcaf0;
                padding: 10px 15px;
                margin-top: 8px;
                border-radius: 6px;
            }

            .data-label {
                font-weight: bold;
                font-size: 0.72rem;
                text-transform: uppercase;
                display: block;
                margin-bottom: 4px;
            }

            .data-text {
                color: #444;
                word-break: break-all;
                font-family: 'Consolas', 'Courier New', monospace;
                font-size: 0.8rem;
                max-height: 180px;
                overflow-y: auto;
            }

            .badge-action {
                font-size: 0.75rem;
                padding: 4px 8px;
                font-weight: 600;
            }
    </style>

    <!-- Thanh tìm kiếm và bộ lọc nhanh -->
    <div class="card-header bg-white py-3 border-bottom">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="small text-muted">
                Đang xem nhật ký cơ sở:
                <strong class="text-primary font-monospace">@(string.IsNullOrWhiteSpace(currentMaTrungTam) ? (currentIdTrungTam != "0" ? $"ID: {currentIdTrungTam}" : "Chưa xác định") : currentMaTrungTam)</strong>
            </span>
        </div>
        <div class="row g-2 align-items-center">
            <div class="col-md-5 col-sm-12">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" id="logKeywordInput" class="form-control border-start-0" placeholder="Tìm kiếm tên, tài khoản, mô tả, IP..." onkeyup="if(event.key === 'Enter') loadLichSuThayDoi(1)">
                </div>
            </div>
            <div class="col-md-4 col-sm-6">
                <select id="logHanhDongSelect" class="form-select form-select-sm" onchange="loadLichSuThayDoi(1)">
                    <option value="">-- Tất cả hành động --</option>
                    <option value="INSERT">Tạo mới (INSERT)</option>
                    <option value="UPDATE">Cập nhật (UPDATE)</option>
                    <option value="DELETE">Xóa (DELETE)</option>
                    <option value="ASSIGN_ROLE">Gán vai trò (ASSIGN_ROLE)</option>
                    <option value="RESET_PASSWORD">Đổi mật khẩu (RESET_PASSWORD)</option>
                    <option value="IMPORT_EXCEL_LOPHOC">Nhập Excel lớp học</option>
                </select>
            </div>
            <div class="col-md-3 col-sm-6 text-end">
                <button type="button" class="btn btn-sm btn-outline-primary w-100" onclick="loadLichSuThayDoi(1)">
                    <i class="fa-solid fa-rotate me-1"></i> Làm mới nhật ký
                </button>
            </div>
        </div>
    </div>

    <!-- Bảng hiển thị danh sách nhật ký -->
    <div class="table-responsive table-responsive-log">
        <table class="table table-hover align-middle table-log mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 25%;">Thời gian & Người thực hiện</th>
                    <th style="width: 75%;">Nội dung hoạt động & Chi tiết thay đổi</th>
                </tr>
            </thead>
            <tbody id="logTableBody">
                <tr>
                    <td colspan="2" class="text-center py-5 text-muted">
                        <i class="fa-regular fa-clock-rotate-left fa-2x mb-2 d-block"></i>
                        Đang chờ tải dữ liệu nhật ký...
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Phân trang -->
    <div id="logPagination" class="mt-3 d-flex justify-content-center pb-3"></div>
</div>

<script>
    const API_LOG_URL = '/api/lichsuthaydoi/danh-sach';

    // Nhúng trực tiếp Session/Claim từ Razor vào biến JavaScript
    const SESSION_ID_TRUNG_TAM = parseInt('@currentIdTrungTam') || 0;
    const SESSION_MA_TRUNG_TAM = '@currentMaTrungTam'.trim();

    function formatLogData(data) {
        if (!data || data === "null" || data === "") {
            return '<span class="text-muted fst-italic">Không có dữ liệu</span>';
        }
        try {
            let obj = (typeof data === 'string') ? JSON.parse(data) : data;
            if (typeof obj === 'object' && obj !== null) {
                return Object.entries(obj)
                    .map(([key, val]) => `<div class="mb-1"><span class="text-secondary fw-semibold">${key}:</span> <span class="text-dark">${val ?? 'N/A'}</span></div>`)
                    .join('');
            }
            return `<div class="text-secondary">${data}</div>`;
        } catch (e) {
            return `<div class="text-secondary">${data}</div>`;
        }
    }

    function getBadgeHanhDong(action) {
        if (!action) return '<span class="badge bg-secondary badge-action">KHÁC</span>';
        const act = action.toUpperCase();
        if (act.includes('INSERT')) return `<span class="badge bg-success-subtle text-success badge-action">${action}</span>`;
        if (act.includes('UPDATE')) return `<span class="badge bg-warning-subtle text-warning badge-action">${action}</span>`;
        if (act.includes('DELETE')) return `<span class="badge bg-danger-subtle text-danger badge-action">${action}</span>`;
        if (act.includes('PASSWORD')) return `<span class="badge bg-info-subtle text-info badge-action">${action}</span>`;
        if (act.includes('ROLE')) return `<span class="badge bg-primary-subtle text-primary badge-action">${action}</span>`;
        return `<span class="badge bg-light text-dark border badge-action">${action}</span>`;
    }

    function loadLichSuThayDoi(page = 1) {
        const $body = $('#logTableBody');
        const $pagination = $('#logPagination');
        const keyword = $('#logKeywordInput').val()?.trim() || '';
        const hanhDong = $('#logHanhDongSelect').val() || '';

        // KIỂM TRA BẢO VỆ: Nếu rỗng cả Id lẫn Mã trung tâm trong Session/Claim
        if (SESSION_ID_TRUNG_TAM <= 0 && (!SESSION_MA_TRUNG_TAM || SESSION_MA_TRUNG_TAM === "0")) {
            $body.html(`
                    <tr>
                        <td colspan="2" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-triangle-exclamation text-warning fa-2x mb-2 d-block"></i>
                            Không xác định được trung tâm của tài khoản hiện tại. Nhật ký trống!
                        </td>
                    </tr>
                `);
            $pagination.empty();
            return;
        }

        $body.html('<tr><td colspan="2" class="text-center py-5"><div class="spinner-border spinner-border-sm text-primary me-2"></div> Đang nạp nhật ký truy vết...</td></tr>');
        $pagination.empty();

        // Luôn truyền cứng IdTrungTam và MaTrungTam đã trích xuất từ Session/Claim vào API
        const queryUrl = `${API_LOG_URL}?page=${page}&pageSize=10` +
            `&idTrungTam=${SESSION_ID_TRUNG_TAM}` +
            `&maTrungTam=${encodeURIComponent(SESSION_MA_TRUNG_TAM)}` +
            `&keyword=${encodeURIComponent(keyword)}` +
            `&hanhDong=${encodeURIComponent(hanhDong)}`;

        $.ajax({
            url: queryUrl,
            type: 'GET',
            xhrFields: {
                withCredentials: true // Gửi kèm Cookie/Session của trình duyệt
            },
            success: function(res) {
                if (res.success && res.data && res.data.length > 0) {
                    let html = '';
                    res.data.forEach(item => {
                        const dateFormatted = item.thoiGian ? new Date(item.thoiGian).toLocaleString('vi-VN') : 'N/A';
                        const ipText = item.diaChiIp ? `<span class="badge bg-light text-secondary border font-monospace mt-1">${item.diaChiIp}</span>` : '';
                        const hasChangeData = (item.duLieuCu && item.duLieuCu !== "null") || (item.duLieuMoi && item.duLieuMoi !== "null");

                        const hoTenDisplay = item.tenNguoiDung ? item.tenNguoiDung : (item.tenTaiKhoan ? item.tenTaiKhoan : 'Hệ thống');
                        const subAccountInfo = item.tenNguoiDung && item.tenTaiKhoan
                            ? `<small class="text-muted d-block font-monospace">(${item.tenTaiKhoan})</small>`
                            : '';

                        html += `
                            <tr class="log-row">
                                <td class="text-muted align-top pt-3">
                                    <div class="mb-1"><i class="fa-regular fa-clock me-1 text-primary"></i><strong>${dateFormatted}</strong></div>
                                    <div class="d-flex align-items-start gap-2 mt-1">
                                        <i class="fa-solid fa-circle-user text-secondary fs-5 mt-1"></i>
                                        <div>
                                            <span class="text-dark fw-bold d-block">${hoTenDisplay}</span>
                                            ${subAccountInfo}
                                            ${ipText}
                                        </div>
                                    </div>
                                </td>
                                <td class="pt-3">
                                    <div class="text-action d-flex align-items-center gap-2 flex-wrap mb-1">
                                        ${getBadgeHanhDong(item.hanhDong)}
                                        <span class="text-dark">${item.moTa ?? 'Không có mô tả chi tiết'}</span>
                                    </div>

                                    ${hasChangeData ? `
                                    <div class="change-detail-box shadow-none">
                                        <div class="row g-3">
                                            <div class="col-md-6 border-end">
                                                <span class="data-label text-danger"><i class="fa-solid fa-arrow-rotate-left me-1"></i>Dữ liệu trước:</span>
                                                <div class="data-text">${formatLogData(item.duLieuCu)}</div>
                                            </div>
                                            <div class="col-md-6">
                                                <span class="data-label text-success"><i class="fa-solid fa-arrow-right-long me-1"></i>Dữ liệu sau:</span>
                                                <div class="data-text">${formatLogData(item.duLieuMoi)}</div>
                                            </div>
                                        </div>
                                    </div>` : ''}
                                </td>
                            </tr>`;
                    });

                    $body.html(html);
                    renderLogPagination(res.totalPages, res.currentPage);
                } else {
                    $body.html('<tr><td colspan="2" class="text-center py-5 text-muted"><i class="fa-regular fa-folder-open fa-2x mb-2 d-block"></i>Trung tâm hiện chưa có lịch sử thay đổi nào.</td></tr>');
                    $pagination.empty();
                }
            },
            error: function(xhr) {
                const err = xhr.responseJSON?.message || 'Không thể nạp nhật ký từ hệ thống.';
                $body.html(`<tr><td colspan="2" class="text-center py-4 text-danger"><i class="fa-solid fa-circle-exclamation me-1"></i>Lỗi: ${err}</td></tr>`);
            }
        });
    }

    function renderLogPagination(totalPages, currentPage) {
        if (!totalPages || totalPages <= 1) return;

        let html = '<ul class="pagination pagination-sm mb-0">';
        html += `<li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                        <a class="page-link" href="javascript:void(0)" onclick="loadLichSuThayDoi(${currentPage - 1})">&laquo;</a>
                     </li>`;

        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) {
                html += `<li class="page-item ${i === currentPage ? 'active' : ''}">
                                <a class="page-link" href="javascript:void(0)" onclick="loadLichSuThayDoi(${i})">${i}</a>
                             </li>`;
            } else if (i === currentPage - 3 || i === currentPage + 3) {
                html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
        }

        html += `<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                        <a class="page-link" href="javascript:void(0)" onclick="loadLichSuThayDoi(${currentPage + 1})">&raquo;</a>
                     </li>`;
        html += '</ul>';

        $('#logPagination').html(html);
    }

    $(document).ready(function() {
        loadLichSuThayDoi(1);
    });

    function capNhatBadgeSoLuongThongBao(idTrungTam = 0, maTrungTam = '') {
        let queryUrl = `${API_LICHSU_URL}?page=1&pageSize=1`;

        if (idTrungTam > 0) {
            queryUrl += `&idTrungTam=${idTrungTam}`;
        }
        if (maTrungTam && maTrungTam.trim() !== '') {
            queryUrl += `&maTrungTam=${encodeURIComponent(maTrungTam.trim())}`;
        }

        $.ajax({
            url: queryUrl,
            type: 'GET',
            xhrFields: { withCredentials: true },
            success: function (res) {
                // Lấy tổng số lượng bản ghi từ API trả về
                const totalItems = res.totalItems || res.totalCount || (res.data ? res.data.length : 0);
                const $badge = $('#badgeSoThongBao');

                if ($badge.length > 0) {
                    if (totalItems > 0) {
                        // Nếu lớn hơn 99 thông báo thì hiển thị 99+
                        $badge.text(totalItems > 99 ? '99+' : totalItems).removeClass('d-none');
                    } else {
                        $badge.addClass('d-none');
                    }
                }
            },
            error: function () {
                $('#badgeSoThongBao').addClass('d-none');
            }
        });
    }
</script>