<!-- Modal Hướng Dẫn Viết Chữ Hán -->
<div class="modal fade" id="hanziModal" tabindex="-1" aria-labelledby="hanziModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg px-2">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fs-6 fs-md-5 fw-bold" id="hanziModalLabel">Tập viết chữ: <span id="hanziModalWord" class="text-primary fw-bold fs-4"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <div id="hanzi-characters-container" class="d-flex flex-wrap justify-content-center gap-2 gap-md-3">
                    <!-- Ô chữ nhúng JS -->
                </div>
            </div>
            <div class="modal-footer border-top-0 justify-content-center pt-0">
                <button type="button" class="btn btn-primary btn-action shadow-sm" onclick="replayHanzi()">
                    <i class="bi bi-arrow-clockwise me-1"></i> Vẽ lại
                </button>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/hanzi-writer@3.5/dist/hanzi-writer.min.js"></script>
<script>
    let currentWriters = []; // Biến mảng lưu các đối tượng chữ hiện tại để gọi nút Vẽ lại

    function showStrokeOrder(word) {
        // 1. Cập nhật tiêu đề Modal và hiển thị nó lên
        document.getElementById('hanziModalWord').innerText = word;
        var myModal = new bootstrap.Modal(document.getElementById('hanziModal'));
        myModal.show();

        // 2. Xóa các chữ cũ từ lần bấm trước
        var container = document.getElementById('hanzi-characters-container');
        container.innerHTML = '';
        currentWriters = [];

        // 3. Tách từng ký tự Hán tự để vẽ (Hỗ trợ từ ghép nhiều chữ)
        // Loại bỏ các ký tự dấu câu, khoảng trắng nếu có
        let cleanWord = word.replace(/[^\u4e00-\u9fa5]/g, "");

        for (let i = 0; i < cleanWord.length; i++) {
            let char = cleanWord[i];

            // Tạo the DIV chứa từng chữ
            let boxId = 'hanzi-char-' + i;
            let div = document.createElement('div');
            div.id = boxId;
            div.className = 'hanzi-box border shadow-sm';
            container.appendChild(div);

            // Cấu hình vẽ chữ bằng thư viện
            let writer = HanziWriter.create(boxId, char, {
                width: 150,
                height: 150,
                padding: 5,
                strokeColor: '#2b3f63',   // Màu nét vẽ (Xanh Navy)
                radicalColor: '#c43c33',  // Màu bộ thủ (Đỏ)
                showOutline: true,        // Hiện chữ mờ phía sau để dễ nhìn form
                strokeAnimationSpeed: 1,
                delayBetweenStrokes: 200,
            });

            currentWriters.push(writer);
        }

        // 4. Bắt đầu vẽ sau khi modal đã hiện (delay 300ms để tránh lỗi render SVG bị sai kích thước)
        setTimeout(() => {
            replayHanzi();
        }, 300);
    }

    function replayHanzi() {
        // Duyệt qua tất cả các chữ đang có trên Modal và chạy lại animation
        currentWriters.forEach(writer => {
            writer.animateCharacter();
        });
    }
</script>
<script>
    const totalItems = @totalCount;
    let correctIds = [];
    let isDataSaved = false;
    const isAuthenticated = @(User.Identity.IsAuthenticated ? "true" : "false");
    const checkApiUrl = '@Url.Action("KiemTraDapAn", "QuanLyDanhSachTuVung")';

    document.addEventListener('DOMContentLoaded', async () => {
        // Khởi tạo chế độ ban đầu (Việt -> Hán)
        changeMode(2);

        if (isAuthenticated) {
            const pendingData = sessionStorage.getItem('pendingCorrectIds');
            if (pendingData) {
                const pendingIds = JSON.parse(pendingData);
                if (pendingIds && pendingIds.length > 0) {
                    sessionStorage.removeItem('pendingCorrectIds');
                    await handlePendingResultsAfterLogin(pendingIds);
                }
            }
        }

        document.querySelectorAll('.js-input').forEach(input => {
            // 1. Check tự động khi đang gõ
               // 1. Check tự động khi đang gõ
            input.addEventListener('input', function() {
                const index = this.getAttribute('data-index');
                const row = document.getElementById(`row-${index}`);
                const kieuCauHoi = parseInt(row.getAttribute('data-kieu-hien-tai'));

                // Sử dụng hàm cleanStringJS để chuẩn hóa câu trả lời của người dùng
                const userValueCleaned = cleanStringJS(this.value);

                if (!userValueCleaned) {
                    this.classList.remove("is-wrong", "is-correct");
                    return;
                }

                let isCorrectClient = false;

                if (kieuCauHoi === 1) {
                    // Xử lý kiểm tra Nghĩa Việt
                    const rawViet = row.getAttribute('data-viet') || "";
                    const cacNghia = rawViet.split(/[,,;|]/); // Tách các nghĩa đồng nghĩa trước

                    for (let n of cacNghia) {
                        // Check từng nghĩa xem có khớp kiểu A (B) không
                        if (checkMatchWithParenthesesJS(n, userValueCleaned)) {
                            isCorrectClient = true;
                            break;
                        }
                    }
                } else {
                    // Kiểm tra Chữ Hán hoặc Pinyin
                    const rawHan = row.getAttribute('data-han') || "";
                    const rawPinyin = row.getAttribute('data-pinyin') || "";

                    const cacChuHan = rawHan.split('|');
                    const cacPinyin = rawPinyin.split('|');

                    // Check xem có khớp với cụm chữ Hán nào không (có tính toán ngoặc)
                    for (let h of cacChuHan) {
                        if (checkMatchWithParenthesesJS(h, userValueCleaned)) {
                            isCorrectClient = true;
                            break;
                        }
                    }

                    // Nếu chữ Hán chưa đúng, check tiếp sang mảng Pinyin (có tính toán ngoặc)
                    if (!isCorrectClient) {
                        for (let p of cacPinyin) {
                            if (checkMatchWithParenthesesJS(p, userValueCleaned)) {
                                isCorrectClient = true;
                                break;
                            }
                        }
                    }
                }

                if (isCorrectClient) {
                    handleCorrectUI(index, row);
                } else {
                    this.classList.remove("is-wrong");
                }
            });

            // 2. Bấm Enter để check chính thức qua API
        input.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    if (!this.readOnly) {
                        triggerCheck(this.getAttribute('data-index'));
                    }
                }
            });

            // 3. Rời ô nhập tự động check
            input.addEventListener('blur', function() {
                if (this.value.trim() && !this.readOnly) {
                    triggerCheck(this.getAttribute('data-index'));
                }
            });
        });

        // Cảnh báo rời trang
        document.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', function(e) {
                if (correctIds.length > 0 && !isDataSaved) {
                    e.preventDefault();
                    const targetUrl = this.href;
                    Swal.fire({
                        title: 'Bạn chưa lưu kết quả!',
                        text: `Đã hoàn thành ${correctIds.length} từ. Lưu lại trước khi thoát?`,
                        icon: 'warning',
                        showDenyButton: true,
                        showCancelButton: true,
                        confirmButtonText: 'Lưu và đi tiếp',
                        denyButtonText: 'Thoát luôn',
                        cancelButtonText: 'Ở lại'
                    }).then(async (result) => {
                        if (result.isConfirmed) {
                            const saved = await saveResults(true);
                            if (saved) window.location.href = targetUrl;
                        } else if (result.isDenied) {
                            isDataSaved = true;
                            window.location.href = targetUrl;
                        }
                    });
                }
            });
        });
    });

    async function handlePendingResultsAfterLogin(pendingIds) {
        try {
            const response = await fetch('@Url.Content("~/api/QuanLyTuVung/luu-ket-qua-on-luyen")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(pendingIds)
            });
            const data = await response.json();

            if (data.success) {
                isDataSaved = true;

                document.querySelectorAll('.vocab-row').forEach((row) => {
                    const idTuVung = parseInt(row.getAttribute('data-id'));

                    if (pendingIds.includes(idTuVung)) {
                        const index = row.id.replace('row-', '');
                        const inputElem = document.getElementById(`input-${index}`);
                        const resultBox = document.getElementById(`result-${index}`);
                        const statusDiv = document.getElementById(`status-${index}`);
                        const kieuCauHoi = parseInt(row.getAttribute('data-kieu-hien-tai'));
                        const amThanhPath = row.getAttribute('data-amthanh');

                        if (kieuCauHoi === 1) {
                            inputElem.value = row.getAttribute('data-viet');
                        } else {
                            inputElem.value = row.getAttribute('data-han');
                        }

                        inputElem.classList.add("is-correct");
                        inputElem.readOnly = true;
                        resultBox.classList.add("show");

                        if (statusDiv) {
                            statusDiv.innerHTML = '<i class="bi bi-check-circle-fill text-success fs-4 animate__animated animate__bounceIn"></i>';
                        }

                        const btnAudio = document.getElementById(`btn-audio-${index}`);
                        if (btnAudio && amThanhPath && amThanhPath.trim() !== "") {
                            btnAudio.classList.remove('d-none');
                        }

                        if (!correctIds.includes(idTuVung)) {
                            correctIds.push(idTuVung);
                        }
                    }
                });

                updateProgress();

                Swal.fire({
                    title: 'Đăng nhập thành công!',
                    text: `Hệ thống đã khôi phục và đồng bộ thành công ${pendingIds.length} kết quả từ vựng của bạn!`,
                    icon: 'success',
                    timer: 3500,
                    showConfirmButton: false
                });
            }
        } catch (e) {
            console.error("Lỗi đồng bộ dữ liệu sau đăng nhập:", e);
        }
    }

    function playVocabAudio(index) {
        const row = document.getElementById(`row-${index}`);
        const amThanhPath = row.getAttribute('data-amthanh');

        if (amThanhPath && amThanhPath.trim() !== "") {
            const audioPlayer = document.getElementById('globalAudioPlayer');
            audioPlayer.src = amThanhPath.startsWith('/') ? amThanhPath : '/' + amThanhPath;
            audioPlayer.play().catch(err => console.log("Không thể phát âm thanh:", err));
        }
    }

    function handleCorrectUI(index, row) {
        const inputElem = document.getElementById(`input-${index}`);
        const resultBox = document.getElementById(`result-${index}`);
        const statusDiv = document.getElementById(`status-${index}`);
        const idTuVung = parseInt(row.getAttribute('data-id'));
        const amThanhPath = row.getAttribute('data-amthanh');

        inputElem.classList.remove("is-wrong");
        inputElem.classList.add("is-correct");
        inputElem.readOnly = true;
        resultBox.classList.add("show");

        if (statusDiv) {
            statusDiv.innerHTML = '<i class="bi bi-check-circle-fill text-success fs-4 animate__animated animate__bounceIn"></i>';
        }

        const btnAudio = document.getElementById(`btn-audio-${index}`);
        if (btnAudio && amThanhPath && amThanhPath.trim() !== "") {
            btnAudio.classList.remove('d-none');
        }

        if (!correctIds.includes(idTuVung)) {
            correctIds.push(idTuVung);
            isDataSaved = false;
            updateProgress();
            playVocabAudio(index);
        }

        const nextInput = document.getElementById(`input-${parseInt(index) + 1}`);
        if (nextInput && !nextInput.readOnly) nextInput.focus();

        if (correctIds.length === totalItems) {
            Swal.fire('Tuyệt vời!', 'Bạn đã hoàn thành tất cả thử thách!', 'success');
        }
    }

    function changeMode(modeType) {
        document.querySelectorAll('.vocab-row').forEach((row, idx) => {
            const han = row.getAttribute('data-han');
            const pinyin = row.getAttribute('data-pinyin');
            const viet = row.getAttribute('data-viet');
            const loai = row.getAttribute('data-loai');

            const qPrimary = row.querySelector('.question-primary');
            const qSecondary = row.querySelector('.question-secondary');
            const aPrimary = row.querySelector('.answer-primary');
            const aSecondary = row.querySelector('.answer-secondary');
            const inputField = document.getElementById(`input-${idx}`);

            let currentKieu = modeType;
            if (modeType === 3) {
                currentKieu = Math.random() < 0.5 ? 1 : 2;
            }

            row.setAttribute('data-kieu-hien-tai', currentKieu);

            // Cập nhật cấu trúc text hiển thị mà không phụ thuộc vào trạng thái làm bài xong hay chưa
            if (currentKieu === 1) {
                qPrimary.innerText = han;
                qPrimary.classList.add('text-success');
                qSecondary.innerText = `(${pinyin})`;
                if(!inputField.readOnly) inputField.placeholder = "Gõ nghĩa tiếng Việt...";
                aPrimary.innerText = viet;
                aPrimary.classList.remove('han-tu-display');
                aSecondary.innerText = loai;
            } else {
                qPrimary.innerText = viet;
                qPrimary.classList.remove('text-success');
                qSecondary.innerText = loai;
                if(!inputField.readOnly) inputField.placeholder = "Gõ chữ Hán hoặc Pinyin...";
                aPrimary.innerText = han;
                aPrimary.classList.add('han-tu-display');
                aSecondary.innerText = `(${pinyin})`;
            }
        });

        const firstActive = document.querySelector('.js-input:not([readonly])');
        if (firstActive) firstActive.focus();
    }

    async function triggerCheck(index) {
        const inputElem = document.getElementById(`input-${index}`);
        if (inputElem.readOnly) return;

        const userValue = inputElem.value.trim();
        if (!userValue) return;

        const row = document.getElementById(`row-${index}`);
        const idTuVung = parseInt(row.getAttribute('data-id'));
        const kieuCauHoi = parseInt(row.getAttribute('data-kieu-hien-tai'));
        const statusDiv = document.getElementById(`status-${index}`);
        const amThanhPath = row.getAttribute('data-amthanh');

        if (statusDiv) {
            statusDiv.innerHTML = '<div class="spinner-border spinner-border-sm text-primary" role="status"></div>';
        }
        inputElem.classList.remove("is-wrong", "is-correct");

        try {
            const response = await fetch(checkApiUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    IdTuVung: idTuVung,
                    KieuCauHoi: kieuCauHoi,
                    CauTraLoi: userValue,
                    AmThanhPath: amThanhPath
                })
            });

            const data = await response.json();

            if (data.success) {
                if (data.isCorrect) {
                    handleCorrectUI(index, row);
                } else {
                    inputElem.classList.add("is-wrong");
                    if (statusDiv) {
                        statusDiv.innerHTML = '<i class="bi bi-x-circle-fill text-danger fs-4 animate__animated animate__shakeX"></i>';
                    }
                }
            } else {
                Swal.fire('Lỗi', data.message || 'Có lỗi xảy ra', 'error');
                if (statusDiv) {
                    statusDiv.innerHTML = '<i class="bi bi-exclamation-circle text-warning fs-4"></i>';
                }
            }
        } catch (error) {
            console.error(error);
            Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ chấm điểm.', 'error');
            if (statusDiv) statusDiv.innerHTML = '';
        }
    }

    function revealOne(index) {
        document.getElementById(`result-${index}`).classList.toggle("show");
    }

    function revealAll() {
        Swal.fire({
            title: 'Hiện tất cả đáp án?',
            text: "Bạn sẽ không thể rèn luyện tập trung nếu biết trước đáp án.",
            icon: 'info',
            showCancelButton: true,
            confirmButtonText: 'Hiện hết đi!',
            cancelButtonText: 'Để tôi tự làm'
        }).then((result) => {
            if (result.isConfirmed) {
                document.querySelectorAll('.result-box').forEach(box => box.classList.add("show"));
            }
        });
    }

    function updateProgress() {
        const percent = Math.round((correctIds.length / totalItems) * 100);
        document.getElementById('correctCount').innerText = correctIds.length;
        document.getElementById('percentText').innerText = percent + '%';
        document.getElementById('learningProgress').style.width = percent + '%';
        if (correctIds.length > 0) {
            document.getElementById('btnSaveFinal').classList.remove('d-none');
        }
    }

    async function saveResults(isSilent = false) {
        if (correctIds.length === 0) return false;

        if (!isAuthenticated) {
            sessionStorage.setItem('pendingCorrectIds', JSON.stringify(correctIds));
            const currentUrl = window.location.pathname + window.location.search;
            const returnUrl = encodeURIComponent(currentUrl);
            const loginUrl = '@Url.Action("DangNhap", "QuanLyTaiKhoan")' + '?returnUrl=' + returnUrl;

            if (!isSilent) {
                Swal.fire({
                    title: 'Yêu cầu đăng nhập',
                    text: 'Bạn cần đăng nhập để hệ thống ghi nhận và lưu kết quả tiến độ!',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Đăng nhập ngay',
                    cancelButtonText: 'Ở lại trang này'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = loginUrl;
                    }
                });
            } else {
                window.location.href = loginUrl;
            }
            return false;
        }

        try {
            const response = await fetch('@Url.Content("~/api/QuanLyTuVung/luu-ket-qua-on-luyen")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(correctIds)
            });
            const data = await response.json();
            if (data.success) {
                isDataSaved = true;
                sessionStorage.removeItem('pendingCorrectIds');
                if (!isSilent) await Swal.fire('Thành công', 'Đã lưu tiến độ!', 'success');
                return true;
            }
        } catch (e) {
            console.error(e);
            return false;
        }
    }

    function confirmExit() {
        if (correctIds.length > 0 && !isDataSaved) {
            // Kích hoạt logic cảnh báo chưa lưu
            Swal.fire({
                title: 'Bạn chưa lưu kết quả!',
                text: 'Lưu lại tiến độ trước khi rời khỏi màn hình ôn luyện?',
                icon: 'warning',
                showDenyButton: true,
                showCancelButton: true,
                confirmButtonText: 'Lưu và thoát',
                denyButtonText: 'Thoát luôn',
                cancelButtonText: 'Ở lại'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    const saved = await saveResults(true);
                    window.location.href = '@Url.Action("Index", "Home")';
                } else if (result.isDenied) {
                    window.location.href = '@Url.Action("Index", "Home")';
                }
            });
        } else {
            window.location.href = '@Url.Action("Index", "Home")';
        }
    }
   // Lưu ý: Đặt hàm cleanStringJS này ra ngoài cùng (hoặc dưới cùng) của script, bên ngoài khối DOMContentLoaded để dùng chung
   // Hàm kiểm tra khớp cả 3 trường hợp: A, B, hoặc AB
        function checkMatchWithParenthesesJS(dbValue, userValueCleaned) {
            if (!dbValue) return false;

            // 1. Khớp toàn bộ chuỗi (sau khi đã xóa ngoặc) -> Khách nhập AB
            if (cleanStringJS(dbValue) === userValueCleaned) return true;

            // Pattern tìm nội dung trong ngoặc đơn () hoặc （）
            const pattern = /\((.*?)\)|（(.*?)）/g;

            if (dbValue.match(pattern)) {
                // 2. Lấy phần BÊN NGOÀI ngoặc (Khách nhập A)
                const outside = dbValue.replace(pattern, "").trim();
                if (outside && cleanStringJS(outside) === userValueCleaned) {
                    return true;
                }

                // 3. Lấy phần BÊN TRONG ngoặc (Khách nhập B)
                // Dùng matchAll để bắt được toàn bộ các group trong ngoặc
                const matches = [...dbValue.matchAll(/\((.*?)\)|（(.*?)）/g)];
                for (let match of matches) {
                    const inside = match[1] || match[2]; // match[1] là ngoặc Anh, match[2] là ngoặc Trung
                    if (inside && cleanStringJS(inside) === userValueCleaned) {
                        return true;
                    }
                }
            }

            return false;
        }
