@model List<HocTiengTrung_3._0_T.Models12.TuVung.CapDoModels>

@{
    ViewData["Title"] = "Chọn Cấp Độ HSK";
    // Đọc trạng thái lọc hiện tại từ Web Controller (nếu có)
    string currentStatus = ViewBag.CurrentStatus != null ? ViewBag.CurrentStatus.ToString().ToLower() : "all";
}

<style>
    .hsk-hover-card {
        transition: all 0.3s cubic-bezier(.25,.8,.25,1);
        cursor: pointer;
    }

        .hsk-hover-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 14px 28px rgba(0,0,0,0.1), 0 10px 10px rgba(0,0,0,0.08) !important;
            background-color: #f8f9fa;
        }

            .hsk-hover-card:hover .bg-primary {
                background-color: #0d6efd !important;
                transform: scale(1.1);
                transition: transform 0.2s ease;
            }

    /* CSS bổ sung để cố định vị trí nút Sửa trên card */
    .btn-edit-position {
        position: absolute;
        top: 15px;
        right: 15px;
        z-index: 10;
        opacity: 0.6;
        transition: opacity 0.2s ease;
    }

    .hsk-hover-card:hover .btn-edit-position {
        opacity: 1;
    }
</style>

<div class="container mt-5">
    <div class="row align-items-center mb-5 g-3">
        <div class="col-md-5">
            <h2 class="fw-bold m-0">Hệ Thống Học Tiếng Trung 3.0</h2>
            <p class="text-muted m-0">Vui lòng chọn cấp độ HSK bạn muốn ôn luyện</p>
        </div>

        <div class="col-md-7 d-flex justify-content-md-end align-items-center gap-3">
            <form asp-action="DanhSachCapDo" method="get" class="row g-3 align-items-end">
                <div class="d-flex align-items-center">
                    <label for="filterStatus" class="me-2 fw-semibold text-secondary text-nowrap m-0">Trạng thái:</label>

                    <select id="filterStatus" name="status" class="form-select shadow-sm" style="width: 180px;" onchange="this.form.submit()">
                        <option value="" selected="@(ViewBag.CurrentStatus == null ? "selected" : null)">🔄 Tất cả cấp độ</option>
                        <option value="true" selected="@(ViewBag.CurrentStatus != null && ViewBag.CurrentStatus == true ? "selected" : null)">🟢 Đang hoạt động</option>
                        <option value="false" selected="@(ViewBag.CurrentStatus != null && ViewBag.CurrentStatus == false ? "selected" : null)">🔴 Ngưng hoạt động</option>
                    </select>
                </div>
            </form>
            

            <button class="btn btn-success fw-bold px-4 py-2 shadow-sm text-nowrap" onclick="openModal(false)">
                ➕ Thêm Cấp Độ
            </button>
        </div>
    </div>

    <div class="row g-4" id="cardContainer">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4 card-item-wrapper" data-status="@item.TrangThai.ToString().ToLower()">
                <div class="card h-100 shadow-sm border-0 hsk-hover-card position-relative">

                    <button class="btn btn-sm btn-outline-primary btn-edit-position rounded-circle"
                            title="Sửa cấp độ"
                            onclick="openModal(true, @item.IdCapDo, '@item.TenCapDo', '@item.TrangThai')">
                        ✏️
                    </button>

                    <div class="card-body text-center p-4">
                        <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3"
                             style="width: 60px; height: 60px; font-size: 24px; font-weight: bold;">
                            @item.IdCapDo
                        </div>

                        <h4 class="card-title fw-bold text-dark">@item.TenCapDo</h4>
                        <p class="card-text text-muted">Luyện tập từ vựng và ví dụ chuẩn @item.TenCapDo.</p>

                        @if (item.TrangThai == true)
                        {
                            <span class="badge bg-light-success text-success border border-success px-3 py-1 rounded-pill">Hoạt động</span>
                        }
                        else
                        {
                            <span class="badge bg-light-danger text-danger border border-danger px-3 py-1 rounded-pill">Ngưng hoạt động</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="capDoModal" tabindex="-1" aria-labelledby="capDoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="fw-bold modal-title" id="capDoModalLabel">Thêm Cấp Độ Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="capDoForm">
                    <input type="hidden" id="txtIdCapDo" />

                    <div class="mb-3">
                        <label for="txtTenCapDo" class="form-label fw-semibold">Tên Cấp Độ</label>
                        <input type="text" class="form-control" id="txtTenCapDo" placeholder="Ví dụ: HSK 1, HSK 2..." required>
                    </div>
                    <div class="mb-3 form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="chkTrangThai" checked>
                        <label class="form-check-label fw-semibold" for="chkTrangThai">Kích hoạt trạng thái</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary px-4" id="btnSave" onclick="saveData()">Lưu lại</button>
            </div>
        </div>
    </div>
</div>

<script>
    let bootstrapModal;

    document.addEventListener("DOMContentLoaded", function() {
        // 1. Khởi tạo Modal của Bootstrap độc lập theo thư viện hiện có
        const modalElement = document.getElementById('capDoModal');
        if (typeof bootstrap !== 'undefined') {
            bootstrapModal = new bootstrap.Modal(modalElement);
        } else if (typeof bootstrapSession !== 'undefined') {
            bootstrapModal = new bootstrapSession.Modal(modalElement);
        }

        // 2. Thiết lập trạng thái được chọn mặc định cho Thanh lọc từ ViewBag gửi xuống
        const initialStatus = "@currentStatus";
        const ddlFilter = document.getElementById('filterStatus');
        if (ddlFilter) {
            ddlFilter.value = initialStatus;
            // Thực hiện chạy lọc dữ liệu hiển thị tương ứng ngay khi load trang xong
            filterCardsByStatus();
        }
    });

    // ==========================================
    // CHỨC NĂNG LỌC TẠI CHỖ (CLIENT-SIDE FILTER)
    // ==========================================
    function filterCardsByStatus() {
        const selectedValue = document.getElementById('filterStatus').value; // 'all', 'true', 'false'
        const cards = document.querySelectorAll('.card-item-wrapper');

        cards.forEach(card => {
            const cardStatus = card.getAttribute('data-status'); // Trạng thái 'true' hoặc 'false' từ HTML

            if (selectedValue === 'all' || cardStatus === selectedValue) {
                card.style.display = 'block'; // Hiển thị các card thoả mãn
            } else {
                card.style.display = 'none';  // Ẩn các card còn lại
            }
        });
    }

    // ==========================================
    // ĐIỀU HƯỚNG ĐÓNG/MỞ POPUP MODAL
    // ==========================================
    function openModal(isEdit, id = 0, name = '', status = 'True') {
        const modalTitle = document.getElementById('capDoModalLabel');

        if (isEdit) {
            modalTitle.innerText = "Chỉnh Sửa Cấp Độ";
            document.getElementById('txtIdCapDo').value = id;
            document.getElementById('txtTenCapDo').value = name;
            document.getElementById('chkTrangThai').checked = (status.toLowerCase() === 'true');
        } else {
            modalTitle.innerText = "Thêm Cấp Độ Mới";
            document.getElementById('txtIdCapDo').value = '';
            document.getElementById('capDoForm').reset();
            document.getElementById('chkTrangThai').checked = true;
        }

        if (bootstrapModal) {
            bootstrapModal.show();
        } else {
            console.error("Không tìm thấy thư viện hỗ trợ hiển thị Bootstrap Modal.");
        }
    }

    // ==========================================
    // XỬ LÝ GỬI DỮ LIỆU ĐẾN API BACKEND
    // ==========================================
    async function saveData() {
        const id = document.getElementById('txtIdCapDo').value;
        const tenCapDo = document.getElementById('txtTenCapDo').value.trim();
        const trangThai = document.getElementById('chkTrangThai').checked;

        if (!tenCapDo) {
            alert("Vui lòng nhập tên cấp độ!");
            return;
        }

        const dataPayload = {
            tenCapDo: tenCapDo,
            trangThai: trangThai
        };

        let url = '/api/quanlytuvung/ThemCapDo';
        let method = 'POST';

        if (id) {
            url = `/api/quanlytuvung/CapNhatCapDo/${id}`;
            method = 'PUT';
        }

        try {
            const btnSave = document.getElementById('btnSave');
            const originalText = btnSave.innerText;
            btnSave.disabled = true;
            btnSave.innerText = "Đang lưu...";

            const response = await fetch(url, {
                method: method,
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify(dataPayload)
            });

            if (response.ok) {
                const result = await response.json();
                alert(result.message || "Thao tác thành công!");

                if (bootstrapModal) {
                    bootstrapModal.hide();
                }

                // Đồng bộ bộ lọc: Lưu giữ lại trạng thái lọc của dropdown lên URL để sau khi reload không bị mất trạng thái đang xem
                const currentFilterValue = document.getElementById('filterStatus').value;
                if (currentFilterValue !== 'all') {
                    window.location.href = window.location.pathname + '?status=' + currentFilterValue;
                } else {
                    location.reload();
                }
            } else {
                const errorText = await response.text();
                alert("Lỗi xử lý từ hệ thống: " + errorText);
                btnSave.disabled = false;
                btnSave.innerText = originalText;
            }
        } catch (error) {
            console.error("Fetch Error:", error);
            alert("Không thể kết nối đến máy chủ API. Vui lòng kiểm tra lại cổng dịch vụ.");
            document.getElementById('btnSave').disabled = false;
            document.getElementById('btnSave').innerText = "Lưu lại";
        }
    }
</script>