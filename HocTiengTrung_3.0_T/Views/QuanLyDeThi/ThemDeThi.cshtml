<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thêm Đề Thi HSK - Gemini Adaptive UI</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <style>
        :root {
            --primary-color: #0d6efd;
        }

        .question-card {
            border-left: 5px solid var(--primary-color);
            margin-bottom: 1.5rem;
            transition: all 0.3s ease;
        }

            .question-card:hover {
                box-shadow: 0 5px 15px rgba(0,0,0,0.1) !important;
            }

        .section-title {
            border-bottom: 2px solid #dee2e6;
            padding-bottom: 0.5rem;
            margin-top: 2rem;
        }

        .badge-skill {
            font-size: 0.8rem;
        }

        .sticky-summary {
            position: sticky;
            top: 20px;
        }

        .bg-group {
            background-color: #f8f9fa;
            border-radius: 8px;
            padding: 15px;
        }
    </style>
</head>
<body class="bg-light">

    <div id="app" class="container py-4">
        <div class="row">
            <div class="col-lg-12 text-center mb-4">
                <h2 class="fw-bold text-primary">TẠO MỚI ĐỀ THI HSK (1 - 6)</h2>
                <p class="text-muted">Hệ thống tự động sinh cấu trúc JSON theo từng loại câu hỏi</p>
            </div>

            <div class="col-lg-12 mb-4">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white fw-bold"><i class="bi bi-info-circle"></i> Thông Tin Chung</div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label fw-semibold">Tên đề thi</label>
                                <input type="text" class="form-control" v-model="exam.info.tenDe" placeholder="Ví dụ: HSK 4 - Đề thi mẫu số 1">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Cấp độ</label>
                                <select class="form-select" v-model="exam.info.idCapDo">
                                    <option v-for="n in 6" :value="n">HSK Cấp {{ n }}</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">T.Gian Nghe (phút)</label>
                                <input type="number" class="form-control" v-model="exam.info.thoiGianNghe">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">T.Gian Đọc (phút)</label>
                                <input type="number" class="form-control" v-model="exam.info.thoiGianDoc">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">T.Gian Viết (phút)</label>
                                <input type="number" class="form-control" v-model="exam.info.thoiGianViet">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Nghỉ chuyển tiếp</label>
                                <input type="number" class="form-control" v-model="exam.info.thoiGianChuyenTiep">
                            </div>
                            <div class="col-md-12">
                                <label class="form-label text-danger fw-bold">File Âm Thanh Toàn Đề (MP3)</label>
                                <input type="file" class="form-control border-danger" v-on:change="handleGlobalAudio($event)">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-12">
                <div class="d-flex justify-content-between align-items-center section-title">
                    <h4 class="m-0 text-dark">Nội Dung Câu Hỏi ({{ exam.questions.length }})</h4>
                    <div class="btn-group shadow-sm">
                        <button class="btn btn-primary btn-sm" v-on:click="addQuestion('Nghe')">+ Nghe</button>
                        <button class="btn btn-success btn-sm" v-on:click="addQuestion('Doc')">+ Đọc</button>
                        <button class="btn btn-warning btn-sm text-white" v-on:click="addQuestion('Viet')">+ Viết</button>
                    </div>
                </div>

                <div v-for="(q, index) in exam.questions" :key="index" class="card question-card shadow-sm mt-4 border-0">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge bg-primary me-2">Câu {{ index + 1 }}</span>
                            <span :class="['badge', q.kyNang === 'Nghe' ? 'bg-info' : q.kyNang === 'Doc' ? 'bg-success' : 'bg-warning']">
                                {{ q.kyNang.toUpperCase() }}
                            </span>
                        </div>
                        <button class="btn btn-outline-danger btn-sm border-0" v-on:click="removeQuestion(index)">🗑 Xóa câu này</button>
                    </div>

                    <div class="card-body">
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-uppercase">Loại bài tập</label>
                                <select class="form-select border-primary" v-model="q.idLoai">
                                    <option v-for="loai in loaiDeThi" :key="loai.idLoai" :value="loai.idLoai">
                                        {{ loai.idLoai }}. {{ loai.tenLoai }}
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-6" v-if="q.idLoai === 1 || getGroup(q.idLoai) === 8">
                                <label class="form-label fw-bold small text-uppercase text-primary">Hình ảnh minh họa</label>
                                <input type="file" class="form-control" v-on:change="handleImageUpload($event, q)">
                            </div>
                        </div>

                        <div class="bg-group border shadow-inner">

                            <div v-if="getGroup(q.idLoai) === 1">
                                <label class="form-label fw-bold">Nội dung câu hỏi / Đoạn hội thoại</label>
                                <textarea class="form-control mb-3" v-model="q.jsonTemp.CauHoi" rows="3" placeholder="Nhập văn bản..."></textarea>
                                <div class="row g-2">
                                    <div class="col-md-6" v-for="opt in ['A','B','C','D']" :key="opt">
                                        <div class="input-group">
                                            <span class="input-group-text bg-light fw-bold">{{ opt }}</span>
                                            <input type="text" class="form-control" v-model="q.jsonTemp['Opt' + opt]">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div v-if="getGroup(q.idLoai) === 2">
                                <label class="form-label fw-bold">Phát biểu cần phán đoán</label>
                                <textarea class="form-control mb-3" v-model="q.jsonTemp.CauHoi" rows="2"></textarea>
                                <div class="d-flex gap-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" :name="'ds'+index" v-model="q.jsonTemp.DapAn" value="True">
                                        <label class="form-check-label fw-bold text-success">✔ Đúng (True)</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" :name="'ds'+index" v-model="q.jsonTemp.DapAn" value="False">
                                        <label class="form-check-label fw-bold text-danger">✘ Sai (False)</label>
                                    </div>
                                </div>
                            </div>

                            <div v-if="getGroup(q.idLoai) === 3">
                                <div class="alert alert-warning py-2 small">Lưu ý: Loại này thường có Options chung cho một cụm câu hỏi.</div>
                                <label class="form-label fw-bold text-primary">Phần Ví dụ (Nếu là câu đầu cụm)</label>
                                <input type="text" class="form-control mb-2" v-model="q.jsonTemp.ViDu" placeholder="Ví dụ: 她说话的 ( E ) 多好听啊!">
                                <label class="form-label fw-bold">Câu hỏi thành phần</label>
                                <input type="text" class="form-control mb-3" v-model="q.jsonTemp.CauHoi" placeholder="Ví dụ: 电影马上就要开始了, ( ) 手机关了吧。">
                                <div class="row g-2">
                                    <div class="col-md-4" v-for="opt in ['A','B','C','D','E','F']" :key="opt">
                                        <input type="text" class="form-control form-control-sm" :placeholder="'Option ' + opt" v-model="q.jsonTemp['Opt' + opt]">
                                    </div>
                                </div>
                            </div>

                            <div v-if="getGroup(q.idLoai) === 5">
                                <label class="form-label fw-bold text-primary">Nội dung 3 đoạn văn cần sắp xếp</label>
                                <div class="mb-2" v-for="opt in ['A','B','C']" :key="opt">
                                    <div class="input-group">
                                        <span class="input-group-text fw-bold">{{ opt }}</span>
                                        <textarea class="form-control" rows="1" v-model="q.jsonTemp['Opt' + opt]"></textarea>
                                    </div>
                                </div>
                                <label class="form-label fw-bold mt-2">Thứ tự đúng (Đáp án)</label>
                                <input type="text" class="form-control w-25 border-success" v-model="q.jsonTemp.DapAn" placeholder="CBA">
                            </div>

                            <div v-if="getGroup(q.idLoai) === 6">
                                <label class="form-label fw-bold text-primary">Các từ/vế câu (Ngăn cách bằng dấu phẩy)</label>
                                <input type="text" class="form-control mb-3" v-model="q.jsonTemp.WordsStr" placeholder="简单, 上午, 考试, 比较">
                                <label class="form-label fw-bold">Đáp án đúng</label>
                                <input type="text" class="form-control border-success" v-model="q.jsonTemp.DapAn">
                            </div>

                            <div v-if="getGroup(q.idLoai) === 7">
                                <div class="row">
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold">Pinyin gợi ý</label>
                                        <input type="text" class="form-control" v-model="q.jsonTemp.Pinyin">
                                    </div>
                                    <div class="col-md-8">
                                        <label class="form-label fw-bold">Ngữ cảnh (Context)</label>
                                        <input type="text" class="form-control" v-model="q.jsonTemp.Context" placeholder="没( )系, 别难过。">
                                    </div>
                                </div>
                            </div>

                            <div v-if="getGroup(q.idLoai) === 8">
                                <label class="form-label fw-bold">Từ gợi ý (Keyword)</label>
                                <input type="text" class="form-control mb-2" v-model="q.jsonTemp.Keyword">
                                <label class="form-label fw-bold">Hướng dẫn / Ghi chú</label>
                                <textarea class="form-control mb-3" v-model="q.jsonTemp.GhiChu" rows="2"></textarea>
                            </div>

                            <div v-if="getGroup(q.idLoai) === 4">
                                <label class="form-label fw-bold text-primary">Nhập cấu trúc JSON cho đoạn văn đục lỗ</label>
                                <textarea class="form-control font-monospace" v-model="q.noiDungJsonRaw" rows="6" placeholder='{"DoanVan": "...", "Questions": [...]}'></textarea>
                            </div>

                            <div class="mt-3 pt-3 border-top" v-if="[1,3,7,8].includes(getGroup(q.idLoai)) && getGroup(q.idLoai) !== 5">
                                <label class="form-label fw-bold text-success">Chọn đáp án đúng (DapAnDung)</label>
                                <select class="form-select w-25 border-success" v-model="q.jsonTemp.DapAn">
                                    <option value="A">A</option>
                                    <option value="B">B</option>
                                    <option value="C">C</option>
                                    <option value="D">D</option>
                                    <option v-if="getGroup(q.idLoai) === 3" value="E">E</option>
                                    <option v-if="getGroup(q.idLoai) === 3" value="F">F</option>
                                    <option v-if="getGroup(q.idLoai) === 8" value="Text">Tự luận/Đoạn văn</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Giải thích đáp án (Hiển thị cho HS)</label>
                                <textarea class="form-control" v-model="q.giaiThich" rows="1"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Ghi chú nội bộ</label>
                                <textarea class="form-control" v-model="q.ghiChu" rows="1"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-lg border-0 mt-5 mb-5 bg-primary text-white">
                    <div class="card-body d-flex justify-content-between align-items-center py-4">
                        <div>
                            <h5 class="mb-0">Xác nhận hoàn tất?</h5>
                            <small>Vui lòng kiểm tra kỹ nội dung và tệp đính kèm trước khi lưu.</small>
                        </div>
                        <button class="btn btn-light btn-lg fw-bold px-5" v-on:click="submitExam">💾 LƯU ĐỀ THI</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    loaiDeThi: [
                        { idLoai: 1, tenLoai: 'Nghe - Chọn tranh' },
                        { idLoai: 2, tenLoai: 'Nghe - Đúng/Sai' },
                        { idLoai: 3, tenLoai: 'Nghe - Trắc nghiệm' },
                        { idLoai: 4, tenLoai: 'Đọc - Ghép câu' },
                        { idLoai: 5, tenLoai: 'Đọc - Điền từ' },
                        { idLoai: 6, tenLoai: 'Đọc - Trắc nghiệm văn bản' },
                        { idLoai: 7, tenLoai: 'Viết - Sắp xếp câu' },
                        { idLoai: 8, tenLoai: 'Viết - Điền chữ Hán' },
                        { idLoai: 9, tenLoai: 'Đọc - Sắp xếp đoạn văn' },
                        { idLoai: 10, tenLoai: 'Viết - Nhìn tranh đặt câu' },
                        { idLoai: 11, tenLoai: 'Đọc - Chọn từ điền đoạn văn' },
                        { idLoai: 12, tenLoai: 'Viết - Viết đoạn văn (80 chữ)' },
                        { idLoai: 13, tenLoai: 'Đọc - Tìm câu sai' },
                        { idLoai: 14, tenLoai: 'Viết - Tóm tắt văn bản' }
                    ],
                    globalAudioFile: null,
                    exam: {
                        info: {
                            tenDe: '',
                            idCapDo: 1,
                            thoiGianNghe: 30,
                            thoiGianDoc: 40,
                            thoiGianViet: 25,
                            thoiGianChuyenTiep: 5
                        },
                        questions: []
                    }
                };
            },
            methods: {
                getGroup(idLoai) {
                    if ([1, 3, 6, 13].includes(idLoai)) return 1;
                    if (idLoai === 2) return 2;
                    if ([4, 5].includes(idLoai)) return 3;
                    if (idLoai === 11) return 4;
                    if (idLoai === 9) return 5;
                    if (idLoai === 7) return 6;
                    if (idLoai === 8) return 7;
                    if ([10, 12, 14].includes(idLoai)) return 8;
                    return 0;
                },

                addQuestion(kyNang) {
                    let defLoai = kyNang === 'Nghe' ? 1 : (kyNang === 'Doc' ? 6 : 7);
                    this.exam.questions.push({
                        kyNang: kyNang,
                        idLoai: defLoai,
                        hinhAnhPath: null,
                        giaiThich: '',
                        ghiChu: '',
                        noiDungJsonRaw: '',
                        jsonTemp: {
                            CauHoi: '', DapAn: 'A', ViDu: '',
                            OptA: '', OptB: '', OptC: '', OptD: '', OptE: '', OptF: '',
                            WordsStr: '', Keyword: '', GhiChu: '', Pinyin: '', Context: ''
                        }
                    });
                },

                removeQuestion(index) {
                    if(confirm("Bạn có chắc muốn xóa câu này?")) this.exam.questions.splice(index, 1);
                },

                handleGlobalAudio(e) { this.globalAudioFile = e.target.files[0]; },

                handleImageUpload(e, q) {
                    const file = e.target.files[0];
                    q.hinhAnhPath = file ? file.name : null;
                },

                buildNoiDungJson() {
                    this.exam.questions.forEach((q, idx) => {
                        q.thuTu = idx + 1;
                        let grp = this.getGroup(q.idLoai);
                        let final = {};

                        if (grp === 1) {
                            final = {
                                CauHoi: q.jsonTemp.CauHoi,
                                Options: { A: q.jsonTemp.OptA, B: q.jsonTemp.OptB, C: q.jsonTemp.OptC, D: q.jsonTemp.OptD },
                                DapAn: q.jsonTemp.DapAn
                            };
                        } else if (grp === 2) {
                            final = { CauHoi: q.jsonTemp.CauHoi, DapAn: q.jsonTemp.DapAn };
                        } else if (grp === 3) {
                            if(q.jsonTemp.ViDu) {
                                final = { GhiChu: "Ví dụ", "Ví dụ": q.jsonTemp.ViDu, Options: { A: q.jsonTemp.OptA, B: q.jsonTemp.OptB, C: q.jsonTemp.OptC, D: q.jsonTemp.OptD, E: q.jsonTemp.OptE, F: q.jsonTemp.OptF } };
                            } else {
                                final = { CauHoi: q.jsonTemp.CauHoi };
                            }
                        } else if (grp === 5) {
                            final = { Options: { A: q.jsonTemp.OptA, B: q.jsonTemp.OptB, C: q.jsonTemp.OptC }, DapAn: q.jsonTemp.DapAn };
                        } else if (grp === 6) {
                            final = { Words: q.jsonTemp.WordsStr.split(',').map(s => s.trim()), DapAn: q.jsonTemp.DapAn };
                        } else if (grp === 7) {
                            final = { Pinyin: q.jsonTemp.Pinyin, Context: q.jsonTemp.Context, DapAn: q.jsonTemp.DapAn };
                        } else if (grp === 8) {
                            final = { Image: q.hinhAnhPath, Keyword: q.jsonTemp.Keyword, GhiChu: q.jsonTemp.GhiChu, DapAn: q.jsonTemp.DapAn };
                        }

                        if (grp !== 4) q.noiDungJson = JSON.stringify(final);
                        else q.noiDungJson = q.noiDungJsonRaw;

                        q.dapAnDung = q.jsonTemp.DapAn;
                    });
                },

                async submitExam() {
                    this.buildNoiDungJson();
                    const payload = {
                        info: this.exam.info,
                        questions: this.exam.questions
                    };

                    console.log("SUBMITTING PAYLOAD:", payload);

                    // Demo API call
                    try {
                        const res = await fetch('/de-thi/them-de-thi', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });
                        const data = await res.json();
                        alert(data.success ? "Lưu thành công!" : "Lỗi: " + data.message);
                    } catch (e) {
                        alert("Đã xảy ra lỗi kết nối. Kiểm tra Console.");
                        console.error(e);
                    }
                }
            }
        }).mount('#app');
    </script>
</body>
</html>