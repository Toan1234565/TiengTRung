@{
    ViewData["Title"] = "Chọn Cấp Độ HSK";

    // Khởi tạo danh sách cấp độ tĩnh
    var staticCapDos = new List<dynamic>
    {
        new { Id = 3, Ten = "HSK 3", MoTa = "Giao tiếp cơ bản trong cuộc sống và học tập." },
        new { Id = 4, Ten = "HSK 4", MoTa = "Thảo luận về các chủ đề phức tạp hơn." },
        new { Id = 5, Ten = "HSK 5", MoTa = "Đọc hiểu báo chí và xem phim không cần sub." },
        new { Id = 6, Ten = "HSK 6", MoTa = "Sử dụng tiếng Trung thành thạo như người bản xứ." }
    };
}

<style>
    .hsk-hover-card {
        transition: all 0.3s cubic-bezier(.25,.8,.25,1);
        cursor: pointer;
        border-radius: 20px;
        overflow: hidden;
    }

        .hsk-hover-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 14px 28px rgba(0,0,0,0.1), 0 10px 10px rgba(0,0,0,0.08) !important;
            background-color: #fffaf5;
        }

            .hsk-hover-card:hover .circle-badge {
                transform: scale(1.1);
                transition: transform 0.2s ease;
            }
</style>

<div class="container mt-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-uppercase">
            <i class="fa-solid fa-book-open me-2 text-danger"></i>Luyện Thi HSK Trực Tuyến
        </h2>
        <p class="text-muted">Chọn cấp độ phù hợp để bắt đầu ôn luyện các kỹ năng Nghe - Đọc - Viết</p>
    </div>

    <div class="row g-4 justify-content-center">
        @foreach (var item in staticCapDos)
        {
            <div class="col-md-4 col-lg-3 mb-4">
                <div class="card h-100 shadow-sm border-0 hsk-hover-card">
                    <div class="card-body text-center p-4">
                        @* Vòng tròn hiển thị số cấp độ *@
                        <div class="circle-badge rounded-circle bg-danger text-white d-inline-flex align-items-center justify-content-center mb-3 shadow-sm"
                             style="width: 70px; height: 70px; font-size: 26px; font-weight: bold;">
                            @item.Id
                        </div>

                        <h4 class="card-title fw-bold text-dark">@item.Ten</h4>
                        <p class="card-text text-muted small" style="min-height: 40px;">@item.MoTa</p>

                        @* Chuyển hướng đến trang danh sách đề thi của cấp độ đó *@
                        <a asp-action="DanhSachDeThi"
                           asp-controller="QuanLyDeThi"
                           asp-route-idCapDo="@item.Id"
                           class="btn btn-outline-danger rounded-pill px-4 stretched-link shadow-sm mt-2">
                            Xem đề thi <i class="fa-solid fa-arrow-right ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>