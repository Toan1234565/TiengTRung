@using Newtonsoft.Json
@model List<HocTiengTrung_3._0_T.Models12.QuanLyDeThi.ChiTietDeThiModels>

<style>
    :root {
        --primary-color: #1a73e8;
        --bg-color: #f8f9fa;
        --card-bg: #ffffff;
        --text-main: #3c4043;
        --border-color: #dadce0;
        --success: #27ae60;
        --danger: #e74c3c;
    }

    body {
        background-color: var(--bg-color);
        color: var(--text-main);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* --- Header & Tabs --- */
    .exam-header {
        background: white;
        border-bottom: 1px solid var(--border-color);
        position: sticky;
        top: 0;
        z-index: 1000;
    }

    .section-tab {
        cursor: pointer;
        padding: 15px 20px;
        font-weight: 600;
        border-bottom: 3px solid transparent;
        transition: 0.3s;
        color: #5f6368;
        white-space: nowrap;
    }

        .section-tab.active {
            color: var(--primary-color);
            border-bottom-color: var(--primary-color);
            background: #f8f9fa;
        }

        .section-tab.completed-locked {
            opacity: 0.6;
            cursor: not-allowed;
            background: #e9ecef;
            pointer-events: none;
        }

        .section-tab.waiting {
            pointer-events: none;
            opacity: 0.5;
        }

    /* --- Layout chính --- */
    .main-container {
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 25px;
        padding: 20px;
        max-width: 1400px;
        margin: auto;
    }

    /* --- Trạng thái đã chọn (Trong câu hỏi) --- */
    .opt-box.selected, .opt-btn-circle.selected {
        border-color: var(--success) !important;
        background-color: #eafaf1 !important;
        color: var(--success) !important;
        font-weight: bold;
        box-shadow: 0 0 5px rgba(39, 174, 96, 0.3);
    }

    /* --- Sidebar & Câu hỏi --- */
    .num-circle {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 13px;
        background: white;
        transition: all 0.2s ease;
    }

        /* Fix lỗi: Đã xóa dấu chấm dư thừa để class answered hoạt động */
        .num-circle.answered {
            background-color: var(--success) !important;
            color: white !important;
            border-color: var(--success) !important;
            box-shadow: 0 2px 4px rgba(39, 174, 96, 0.4);
        }

        .num-circle:hover {
            border-color: var(--primary-color);
            background-color: #f0f7ff;
        }

    /* --- Responsive Sidebar --- */
    @@media (max-width: 992px) {
        .main-container {
            grid-template-columns: 1fr;
        }

        .sidebar-area {
            position: fixed;
            right: -350px;
            top: 0;
            height: 100vh;
            width: 300px;
            z-index: 2000;
            background: white;
            box-shadow: -5px 0 15px rgba(0,0,0,0.1);
            transition: 0.3s ease;
            padding-top: 20px;
        }

            .sidebar-area.open {
                right: 0;
            }

        .sidebar-toggle {
            display: flex !important;
        }
    }

    .sidebar-toggle {
        display: none;
        position: fixed;
        right: 20px;
        bottom: 80px;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: var(--primary-color);
        color: white;
        align-items: center;
        justify-content: center;
        z-index: 2001;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    }

    .exam-part {
        display: none;
    }

        .exam-part.active {
            display: block;
            animation: fadeIn 0.5s;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    /* --- Nút Scroll to Top --- */
    #btnScrollTop {
        display: none;
        position: fixed;
        bottom: 100px;
        right: 30px;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background-color: var(--primary-color);
        color: white;
        border: none;
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        z-index: 2000;
        cursor: pointer;
        font-size: 20px;
        transition: background-color 0.3s, transform 0.3s;
    }

        #btnScrollTop:hover {
            background-color: #1557b0;
            transform: scale(1.1);
        }

    /* Responsive để không đè lên nút sidebar-toggle ở Mobile */
    @@media (max-width: 992px) {
        #btnScrollTop {
            bottom: 140px; /* Nâng cao lên một chút để tránh nút Danh sách câu (bottom: 80px) */
            right: 20px;
        }
    }
</style>

<div class="sidebar-toggle shadow" onclick="toggleSidebar()">
    <i class="fas fa-th-list"></i>
</div>

<div class="exam-header shadow-sm">
    <div class="container-fluid d-flex justify-content-between align-items-center px-3 px-md-4">
        <div class="d-flex align-items-center overflow-auto">
            <h4 class="text-primary fw-bold mb-0 me-3 me-md-4">HSK @ViewBag.IdCapDo</h4>
            <div class="d-flex h-100" id="examTabs">
                <div class="section-tab active" data-part="1">PART I: NGHE</div>
                <div class="section-tab waiting" data-part="2">PART II: ĐỌC</div>
                <div class="section-tab waiting" data-part="3">PART III: VIẾT</div>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <div id="countdown" class="badge bg-light text-danger fs-5 border border-danger px-3 py-2">--:--</div>
            <button class="btn btn-success fw-bold rounded-pill d-none d-md-block" onclick="nopBai(true)">NỘP BÀI</button>
        </div>
    </div>
</div>

<div class="main-container">
    <div class="content-area">
        @{
            var groups = Model.GroupBy(x => x.KyNang).ToDictionary(g => g.Key, g => g.OrderBy(x => x.ThuTu).ToList());
        }

        @for (int i = 1; i <= 3; i++)
        {
            <div id="part-@i" class="exam-part @(i == 1 ? "active" : "")">
                <div class="alert @(i == 1 ? "alert-primary" : i == 2 ? "alert-info" : "alert-warning") mb-4 shadow-sm">
                    <i class="fas @(i == 1 ? "fa-volume-up" : i == 2 ? "fa-book-open" : "fa-pen-nib") me-2"></i>
                    <b>Hướng dẫn:</b> @(i == 1 ? "Nghe file và chọn đáp án." : i == 2 ? "Chọn đáp án đúng." : "Hoàn thành phần viết.")
                </div>

                @if (groups.ContainsKey(i))
                {
                    string lastImg = "";
                    foreach (var item in groups[i])
                    {
                        @* Luôn hiển thị âm thanh nếu có (bất kể kỹ năng nào) *@
                        @if (!string.IsNullOrEmpty(item.AmThanhPath))
                        {
                            <div class="audio-player-wrapper mb-3">
                                <button class="btn btn-danger rounded-pill px-4 btn-sm shadow-sm pulse-button"
                                        onclick="toggleAudio(this)"
                                        data-audio="@item.AmThanhPath">
                                    <i class="fas fa-volume-up me-2"></i> Bấm để nghe
                                </button>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(item.HinhAnhPath) && item.HinhAnhPath != lastImg)
                        {
                            <div class="group-image-header text-center my-4 p-3 bg-white shadow-sm rounded border border-primary">
                                <img src="@item.HinhAnhPath"
                                     class="img-fluid rounded shadow-sm"
                                     style="max-height: 400px; object-fit: contain;"
                                     alt="Hình ảnh câu hỏi"
                                     onerror="this.style.display='none'" />
                                @* onerror giúp ẩn khung ảnh nếu link bị lỗi *@
                            </div>
                            lastImg = item.HinhAnhPath;
                        }
                        @await Html.PartialAsync("_QuestionItem", item, new ViewDataDictionary(ViewData) { { "HideInternalImage", i == 1 } })
                    }
                }
            </div>
        }

        <div class="d-flex justify-content-between mt-5 mb-5 border-top pt-4">
            <button id="btnNext" class="btn btn-primary px-5 py-2 fw-bold ms-auto" onclick="nextPartHandle()">PHẦN TIẾP THEO <i class="fas fa-arrow-right ms-2"></i></button>
        </div>
    </div>

    <div class="sidebar-area" id="sidebar">
        <div class="card shadow-sm border-0 sticky-top" style="top: 100px;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0">DANH SÁCH CÂU</h6>
                    <span class="badge bg-light text-dark border" id="progressStatus">0/@Model.Count</span>
                </div>
                <div class="d-flex flex-wrap gap-2 overflow-auto" style="max-height: 70vh;">
                    @foreach (var item in Model)
                    {
                        <div id="nav-@item.ThuTu"
                             class="num-circle @(item.KyNang != 1 ? "d-none" : "")"
                             data-kynang="@item.KyNang"
                             onclick="scrollToQ(@item.ThuTu)">
                            @item.ThuTu
                        </div>
                    }
                </div>
                <button class="btn btn-success w-100 mt-4 d-md-none" onclick="nopBai(true)">NỘP BÀI</button>
            </div>
        </div>
        
    </div>
    <!-- Nút Scroll to Top -->
    <button id="btnScrollTop" onclick="scrollToTop()" title="Quay lại đầu trang">
        <i class="fas fa-arrow-up"></i>
    </button>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // --- SCROLL TO TOP LOGIC ---
    window.addEventListener('scroll', function() {
        const btnScroll = document.getElementById("btnScrollTop");
        if (document.body.scrollTop > 300 || document.documentElement.scrollTop > 300) {
            btnScroll.style.display = "block";
        } else {
            btnScroll.style.display = "none";
        }
    });

    function scrollToTop() {
        window.scrollTo({
            top: 0,
            behavior: 'smooth'
        });
    }
    // --- 1. CONFIG & KHỞI TẠO BIẾN TOÀN CỤC ---
    const timeConfig = {
        1: @(ViewBag.TimeNghe ?? 1800),
        2: @(ViewBag.TimeDoc ?? 1800),
        3: @(ViewBag.TimeViet ?? 900)
    };

    let currentPart = 1;
    let timeLeft = timeConfig[1];
    let timer;
    const totalQuestions = @Model.Count;
    let startTimeISO = new Date().toISOString();

    let currentAudio = null;
    let currentBtn = null;
    const isAuthenticated = @(User.Identity.IsAuthenticated ? "true" : "false");
    // answers là nguồn dữ liệu duy nhất (Single Source of Truth)
    let answers = JSON.parse(localStorage.getItem('hsk_temp_answers')) || {};

    window.onload = () => {
        startTimer();
        initAnswerListener(); // Lắng nghe sự kiện Click/Input chung
        restoreUI();         // Phục hồi trạng thái đã làm từ localStorage
        updateProgress();    // Cập nhật số câu đã làm
    };

    // --- 2. LOGIC XỬ LÝ ĐÁP ÁN (DÙNG CHUNG) ---
    function initAnswerListener() {
        const container = document.querySelector('.main-container');
        if(!container) return;

        // Xử lý Click (Trắc nghiệm, Đúng/Sai)
        container.addEventListener('click', function(e) {
            const optBox = e.target.closest('.opt-box') || e.target.closest('.opt-btn-circle') || e.target.closest('.opt-btn-square');
            if (optBox) {
                const stt = optBox.getAttribute('data-thutu') || optBox.getAttribute('data-stt');
                const val = optBox.getAttribute('data-value') || optBox.getAttribute('data-val');
                const group = optBox.getAttribute('data-group');
                if (stt && val) {
                    handleSelection(stt, val, group);
                }
            }
        });

        // Xử lý Input (Phần Viết - Textarea)
        container.addEventListener('input', function(e) {
            if (e.target.tagName === 'TEXTAREA') {
                const stt = e.target.getAttribute('data-thutu');
                if (stt) {
                    saveAnswerLocal(stt, e.target.value);
                }
            }
        });
    }

    /**
     * Hàm xử lý chính: Gọi từ EventListener hoặc trực tiếp từ onblur/onclick của Partial View
     */
        // Hàm này là "trái tim" để nhận dữ liệu từ mọi loại câu hỏi
    function handleSelection(stt, val, groupKey = null) {
        if (val === undefined || val === null) return;

        // 1. Làm sạch dữ liệu
        let finalVal = val.toString().trim();

        // 2. LOGIC VIẾT HOA (Cải tiến cho Case 9)
        // Nếu là trắc nghiệm (1 ký tự), điền từ ngắn (Case 8), hoặc sắp xếp đoạn văn (Case 9: ABC, BCA...)
        // Ta kiểm tra nếu chuỗi không chứa khoảng trắng (nghĩa là một mã đáp án liền nhau) và độ dài ngắn.
        if (!finalVal.includes(" ") && finalVal.length <= 10) {
            finalVal = finalVal.toUpperCase();
        }

        // 3. Kiểm tra trùng lặp (dành cho Case 8 - Điền từ vào chỗ trống theo nhóm)
        if (groupKey && finalVal !== "") {
            const duplicateStt = checkDuplicateInGroup(stt, finalVal, groupKey);
            if (duplicateStt) {
                Swal.fire({
                    icon: 'error',
                    title: 'Trùng đáp án',
                    text: `Đáp án '${finalVal}' đã được chọn ở câu ${duplicateStt}`,
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3000
                });

                // Xóa giá trị trong biến answers và UI nếu trùng
                delete answers[stt];
                localStorage.setItem('hsk_temp_answers', JSON.stringify(answers));
                resetInputUI(stt);
                updateSidebarStatus(stt, false);
                return;
            }
        }

        // 4. LƯU VÀO BIẾN TỔNG answers
        // Nếu giá trị rỗng thì xóa key đó luôn cho sạch dữ liệu nộp bài
        if (finalVal === "") {
            delete answers[stt];
        } else {
            answers[stt] = finalVal;
        }

        // 5. LƯU VÀO LOCALSTORAGE
        localStorage.setItem('hsk_temp_answers', JSON.stringify(answers));

        // 6. CẬP NHẬT GIAO DIỆN
        updateQuestionUI(stt, finalVal);
        updateSidebarStatus(stt, finalVal.length > 0);
        updateProgress();
    }

    function checkDuplicateInGroup(currentStt, newVal, groupKey) {
        for (let s in answers) {
            if (parseInt(s) !== parseInt(currentStt) && answers[s] === newVal) {
                // Kiểm tra xem câu đó có cùng groupKey không thông qua thuộc tính DOM
                const target = document.querySelector(`[data-group="${groupKey}"][data-thutu="${s}"], [data-group="${groupKey}"][data-stt="${s}"], input[onblur*="'${groupKey}'"][onblur*="(${s},"]`);
                if (target) return s;
            }
        }
        return null;
    }

    function saveAnswerLocal(thuTu, value) {
        answers[thuTu] = value;
        localStorage.setItem('hsk_temp_answers', JSON.stringify(answers));
        updateSidebarStatus(thuTu, value.toString().trim().length > 0);
        updateProgress();
    }

    // --- 3. CẬP NHẬT GIAO DIỆN (UI) ---
    // --- 3. CẬP NHẬT GIAO DIỆN (UI) ---
    function updateQuestionUI(thuTu, value) {
        // Không ép viết hoa ngay tại đây để giữ nguyên định dạng câu dài (Case 7)
        const rawVal = value ? value.toString() : "";
        const upperVal = rawVal.toUpperCase();

        // 1. Cập nhật các nút bấm (Trắc nghiệm, Square, Circle)
        const allBtns = document.querySelectorAll(`[data-thutu="${thuTu}"], [data-stt="${thuTu}"], .selection-item-${thuTu}, .opt-item-${thuTu}`);
        allBtns.forEach(btn => {
            const btnVal = (btn.getAttribute('data-value') || btn.getAttribute('data-val') || "").toUpperCase();

            // So sánh với bản viết hoa để kích hoạt trạng thái chọn cho trắc nghiệm
            if (btnVal === upperVal && upperVal !== "") {
                btn.classList.add('selected', 'active');
            } else {
                btn.classList.remove('selected', 'active');
            }
        });

        // 2. Cập nhật Input/Textarea (Case 9, Case 8, Case 7)
        const inputs = document.querySelectorAll(`input[data-thutu="${thuTu}"], textarea[data-thutu="${thuTu}"], input[onblur*="(${thuTu},"]`);
        inputs.forEach(input => {
            // Chỉ cập nhật nếu người dùng không đang trực tiếp gõ vào ô đó (tránh nhảy con trỏ chuột)
            if (document.activeElement !== input) {
                input.value = rawVal;
            }

            // Thêm class để hiệu ứng giao diện nếu có nội dung
            if (rawVal !== "") {
                input.classList.add('input-filled');
                input.style.borderColor = "#0d6efd"; // Highlight nhẹ viền ô đã điền
            } else {
                input.classList.remove('input-filled');
                input.style.borderColor = "";
            }
        });
    }

    function restoreUI() {
        Object.keys(answers).forEach(stt => {
            updateQuestionUI(stt, answers[stt]);
            updateSidebarStatus(stt, answers[stt].toString().trim().length > 0);
        });
    }

    function updateSidebarStatus(thuTu, isDone) {
        const navItem = document.getElementById(`nav-${thuTu}`);
        if (navItem) {
            navItem.classList.toggle('answered', isDone);
        }
    }

    function updateProgress() {
        const count = Object.keys(answers).filter(k => answers[k] && answers[k].toString().trim() !== "").length;
        const el = document.getElementById('progressStatus');
        if(el) el.innerText = `${count}/${totalQuestions}`;
    }

    function resetInputUI(stt) {
        const inputs = document.querySelectorAll(`input[data-thutu="${stt}"], input[onblur*="(${stt},"]`);
        inputs.forEach(i => { i.value = ""; i.classList.add('is-invalid-duplicate'); setTimeout(() => i.classList.remove('is-invalid-duplicate'), 600); });
        saveAnswerLocal(stt, "");
        updateQuestionUI(stt, "");
    }

    // --- 4. THỜI GIAN & ĐIỀU HƯỚNG ---
    function startTimer() {
        if (timer) clearInterval(timer);
        timer = setInterval(() => {
            if (timeLeft > 0) {
                timeLeft--;
                updateClock(timeLeft);
            } else {
                handleTimeUp();
            }
        }, 1000);
    }

    function updateClock(seconds) {
        const m = Math.floor(seconds / 60);
        const s = seconds % 60;
        const el = document.getElementById('countdown');
        if (el) el.innerText = `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
    }

    function handleTimeUp() {
        clearInterval(timer);
        Swal.fire({ icon: 'warning', title: 'Hết thời gian!', showConfirmButton: false, timer: 2000 }).then(() => {
            if (currentPart < 3) switchPart(currentPart + 1);
            else nopBai(false);
        });
    }

    function switchPart(partIdx) {
        if (currentAudio) { currentAudio.pause(); currentAudio = null; }

        document.querySelectorAll('.section-tab').forEach((tab, i) => {
            let idx = i + 1;
            tab.className = 'section-tab ' + (idx < partIdx ? 'completed-locked' : idx === partIdx ? 'active' : 'waiting');
        });

        document.querySelectorAll('.exam-part').forEach(p => p.classList.remove('active'));
        document.getElementById(`part-${partIdx}`).classList.add('active');

        document.querySelectorAll('.num-circle').forEach(c => {
            c.classList.toggle('d-none', parseInt(c.dataset.kynang) !== partIdx);
        });

        currentPart = partIdx;
        timeLeft = timeConfig[currentPart];
        if (currentPart === 3) document.getElementById('btnNext').innerText = "NỘP BÀI";

        window.scrollTo({ top: 0, behavior: 'smooth' });
        startTimer();
    }

    function nextPartHandle() {
        if (currentPart < 3) {
            Swal.fire({
                title: 'Chuyển phần thi?',
                text: "Bạn không thể quay lại sửa bài phần cũ!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Đồng ý'
            }).then((res) => { if (res.isConfirmed) switchPart(currentPart + 1); });
        } else {
            nopBai(true);
        }
    }

    function scrollToQ(thuTu) {
        const el = document.getElementById(`q-${thuTu}`);
        if (el) {
            window.scrollTo({ top: el.offsetTop - 120, behavior: 'smooth' });
            if (window.innerWidth < 992) toggleSidebar();
        }
    }
    

function toggleAudio(btn) {
        const url = btn.getAttribute('data-audio');
        if (!url) return;

        // Nếu đang phát chính bài này -> Pause
        if (currentAudio && currentAudio.src === url) {
            if (!currentAudio.paused) {
                currentAudio.pause();
                resetAudioBtn(btn);
                return;
            }
        }

        // Nếu đang phát bài khác -> Dừng bài cũ
        if (currentAudio) {
            currentAudio.pause();
            if (currentBtn) resetAudioBtn(currentBtn);
        }

        currentAudio = new Audio(url);
        currentBtn = btn;
        btn.classList.add('audio-playing', 'btn-warning'); // Đổi màu để nhận biết
        btn.innerHTML = '<i class="fas fa-pause-circle me-1"></i> Đang phát...';

        currentAudio.play().catch(e => {
            console.error("Lỗi phát audio:", e);
            resetAudioBtn(btn);
        });

        currentAudio.onended = () => resetAudioBtn(btn);
    }

    function resetAudioBtn(btn) {
        btn.classList.remove('audio-playing');
        btn.innerHTML = '<i class="fas fa-volume-up me-2"></i> Bấm để nghe';
    }

    function toggleSidebar() {
        document.getElementById('sidebar').classList.toggle('open');
    }

    // --- 5. NỘP BÀI ---
    // --- 5. NỘP BÀI ---
        function nopBai(confirm) {
        // 1. Hàm thực thi gửi dữ liệu lên Server
        const submitData = () => {
            if (typeof currentAudio !== 'undefined' && currentAudio) currentAudio.pause();
            if (typeof timer !== 'undefined' && timer) clearInterval(timer);

            // Hiển thị trạng thái nộp bài
            Swal.fire({
                title: 'Đang nộp bài...',
                html: 'Hệ thống đang chấm điểm, vui lòng chờ trong giây lát.',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            // Lọc lại đáp án (loại bỏ các câu trống)
            const finalAnswers = {};
            for (let key in answers) {
                if (answers[key] && answers[key].toString().trim() !== "") {
                    finalAnswers[key] = answers[key].toString();
                }
            }

            const payload = {
                examId: parseInt("@ViewBag.DeThiId"),
                userAnswers: finalAnswers,
                startTime: startTimeISO,
                endTime: new Date().toISOString(), // Thêm thời gian kết thúc thực tế
                hoTen: "@(User.Identity.IsAuthenticated? User.Identity.Name : "Khách")"
            };

            fetch('/api/quanlydethi/nop-bai', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(async res => {
                const result = await res.json();
                if (!res.ok) throw result;
                return result;
            })
            .then(result => {
                if (result.success) {
                    localStorage.removeItem('hsk_temp_answers'); // Xóa cache sau khi nộp thành công

                    Swal.fire({
                        icon: 'success',
                        title: 'Nộp bài thành công!',
                        html: `
                            <div class="mt-3 text-start p-3 bg-light rounded">
                                <p>🌟 Điểm số: <b class="fs-4 text-danger">${result.diemSo}</b></p>
                                <p>✅ Số câu đúng: <b>${result.soCauDung}/${result.tongSoCau}</b></p>
                            </div>
                        `,
                        confirmButtonText: 'Xem chi tiết kết quả',
                        allowOutsideClick: false
                    }).then(() => {
                        window.location.href = `/QuanLyDeThi/KetQuaBaiThi?id=${result.idKetQua}`;
                    });
                }
            })
            .catch(err => {
                console.error(err);
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi nộp bài',
                    text: err.message || 'Không thể kết nối với máy chủ. Vui lòng kiểm tra lại mạng!',
                    confirmButtonText: 'Thử lại'
                });
                // Nếu lỗi thì cho phép chạy lại timer để người dùng không bị mất thời gian
                if (typeof startTimer === 'function') startTimer();
            });
        };

        // 2. Logic kiểm tra số lượng câu hỏi đã làm
        const totalAnswered = Object.keys(answers).length;
        const totalQuestions = parseInt("@ViewBag.TongSoCau") || 0;
        let warningText = "Ngài có chắc chắn muốn nộp bài ngay không?";

        if (totalAnswered < totalQuestions) {
            warningText = `Ngài mới làm được ${totalAnswered}/${totalQuestions} câu. Nộp bây giờ sẽ không thể sửa đổi!`;
        }

        // 3. Logic xác nhận & Đăng nhập
        const handleConfirmSubmit = () => {
            if (confirm) {
                Swal.fire({
                    title: 'Xác nhận nộp bài',
                    text: warningText,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Vâng, nộp bài!',
                    cancelButtonText: 'Để ta làm thêm...'
                }).then((result) => {
                    if (result.isConfirmed) submitData();
                });
            } else {
                submitData();
            }
        };

        // Kiểm tra trạng thái đăng nhập
        if (typeof isAuthenticated !== 'undefined' && !isAuthenticated) {
            Swal.fire({
                title: 'Hoàng đế chưa đăng nhập!',
                text: "Thành tích của Ngài sẽ không được lưu vào lịch sử nếu nộp ở chế độ Khách.",
                icon: 'warning',
                showCancelButton: true,
                showDenyButton: true,
                confirmButtonText: 'Đăng nhập ngay',
                denyButtonText: 'Nộp không cần lưu',
                cancelButtonText: 'Làm tiếp'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = "/QuanLyTaiKhoan/DangNhap?ReturnUrl=" + encodeURIComponent(window.location.pathname + window.location.search);
                } else if (result.isDenied) {
                    handleConfirmSubmit();
                }
            });
            return;
        }

        handleConfirmSubmit();
    }

    // Hàm phụ hiển thị confirm nộp bài cho gọn code
    function showConfirmSubmit(callback) {
        Swal.fire({
            title: 'Nộp bài?',
            text: "Bạn có chắc chắn muốn kết thúc bài thi này?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Nộp bài',
            cancelButtonText: 'Khoan đã'
        }).then(r => { if (r.isConfirmed) callback(); });
    }
</script>