            {stt:50, char:"鳥", pinyin:"niǎo", nets:11, hv:"điểu", idea:"Chim, loài có cánh", eg:"鸟 (niǎo) – Chim, 鹰 (yīng) – Đại bàng"}
        ];

        const itemsPerPage = 10;
        let currentPage = 1;

        function displayRadicals(page) {
            const container = document.getElementById('radical-container');
            container.innerHTML = "";

            const start = (page - 1) * itemsPerPage;
            const end = start + itemsPerPage;
            const pageItems = radicals.slice(start, end);

            pageItems.forEach(item => {
                const card = document.createElement('div');
                card.className = 'radical-card';
                card.innerHTML = `
                    <div class="radical-left">
                        <span class="radical-stt">Bộ #${item.stt}</span>
                        <h2 class="radical-char">${item.char}</h2>
                        <span style="font-size: 12px; color: #666;">${item.nets} nét</span>
                    </div>
                    <div class="radical-right">
                        <div class="radical-header">
                            <span class="radical-name">${item.hv.toUpperCase()}</span>
                            <span class="radical-pinyin">/${item.pinyin}/</span>
                        </div>
                        <div class="radical-info">
                            <strong>Ý nghĩa:</strong> ${item.idea}
                        </div>
                        <div class="radical-example">
                            <i class="fa-solid fa-pen-nib"></i> <strong>Ví dụ:</strong> ${item.eg}
                        </div>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function setupPagination() {
            const paginationContainer = document.getElementById('pagination');
            paginationContainer.innerHTML = "";

            const pageCount = Math.ceil(radicals.length / itemsPerPage);

            for (let i = 1; i <= pageCount; i++) {
                const btn = document.createElement('button');
                btn.innerText = i;
                btn.className = `page-btn ${i === currentPage ? 'active' : ''}`;
                btn.addEventListener('click', () => {
                    currentPage = i;
                    displayRadicals(currentPage);
                    setupPagination();
                    window.scrollTo(0,0);
                });
                paginationContainer.appendChild(btn);
            }
        }

        // Khởi tạo
        displayRadicals(currentPage);
        setupPagination();
    </script>
