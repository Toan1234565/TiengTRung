@using System.Security.Claims
@{
    // 1. Kiểm tra vai trò từ Claims và Session
    string currentVaiTro = (User.FindFirst("TenVaiTro")?.Value
                            ?? Context.Session.GetString("TenVaiTro")
                            ?? "").Trim();

    var roleClaims = User.FindAll(ClaimTypes.Role).Select(c => c.Value.Trim()).ToList();

    bool isAdmin = currentVaiTro.Equals("Quản trị viên", StringComparison.OrdinalIgnoreCase)
                   || currentVaiTro.Equals("Admin", StringComparison.OrdinalIgnoreCase)
                   || roleClaims.Any(r => r.Equals("Quản trị viên", StringComparison.OrdinalIgnoreCase)
                                       || r.Equals("Admin", StringComparison.OrdinalIgnoreCase)
                                       || r == "1");

    // 2. Chặn truy cập nếu không phải Quản trị viên
    if (!isAdmin)
    {
        <!DOCTYPE html>
        <html lang="vi">
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>Từ chối quyền truy cập</title>
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        </head>
        <body class="bg-light d-flex align-items-center justify-content-center" style="min-height: 100vh;">
            <script>
                    document.addEventListener('DOMContentLoaded', function() {
                        Swal.fire({
                            icon: 'error',
                            title: 'Truy cập bị từ chối!',
                            text: 'Chỉ Quản trị viên hệ thống mới có quyền truy cập vào khu vực này!',
                            confirmButtonText: 'Quay về trang chủ',
                            confirmButtonColor: '#dc3545',
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        }).then((result) => {
                            window.location.href = '@Url.Action("Index", "Home")';
                        });
                    });
            </script>
        </body>
    </html>
    return; // Dừng không cho render tiếp nội dung bên dưới
}

string apiUrl = "https://hoctiengtrung13-001-site1.ftempurl.com";
// string apiUrl = "https://localhost:7151";

var idTrungTam = User.FindFirst("IdTrungTam")?.Value
                 ?? Context.Session.GetString("IdTrungTam")
                 ?? "0";

var maTrungTam = User.FindFirst("MaTrungTam")?.Value
                 ?? Context.Session.GetString("MaTrungTam")
                 ?? "";

var routeValue = (!string.IsNullOrEmpty(idTrungTam) && idTrungTam != "0")
                 ? idTrungTam
                 : maTrungTam;
}
