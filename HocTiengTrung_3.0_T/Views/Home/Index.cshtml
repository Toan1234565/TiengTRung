            @for (int i = 1; i <= 6; i++)
            {
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card hsk-card text-center h-100 shadow-sm p-3">
                        <div class="card-body p-2">
                            <div class="hsk-circle bg-hsk@(i)">
                                @i
                            </div>
                            <h5 class="fw-bold mb-1 text-dark">HSK @i</h5>
                            <p class="text-muted x-small mb-3" style="font-size: 0.75rem;">
                                Cấp độ @(i <= 2 ? "Sơ cấp" : i <= 4 ? "Trung cấp" : "Cao cấp")
                            </p>
                            <a href="/QuanLyDanhSachTuVung/DanhSachTuVung?capDo=@i" class="btn btn-primary w-100 rounded-pill btn-sm fw-semibold py-2 shadow-sm">
                                Học ngay
