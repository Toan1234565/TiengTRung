@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            kiemTraThoiHanVipUser();
        });

        function kiemTraThoiHanVipUser() {
            fetch('/api/quanlytaikhoannguoidung/kiem-tra-han-vip', {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
                .then(response => response.status === 200 ? response.json() : null)
                .then(data => {
                    if (data && data.sapHetHan) {
                        if (!sessionStorage.getItem('daThongBaoSapHetHanVip')) {
                            if (typeof Swal !== 'undefined') {
                                Swal.fire({
                                    title: 'Sắp Hết Hạn VIP! 👑',
                                    text: data.message,
                                    icon: 'warning',
                                    showCancelButton: true,
                                    confirmButtonColor: '#dc3545',
                                    cancelButtonColor: '#6c757d',
                                    confirmButtonText: 'Gia hạn ngay',
                                    cancelButtonText: 'Để sau',
                                    backdrop: `rgba(0,0,123,0.1)`
                                }).then((result) => {
                                    if (result.isConfirmed) {
                                        window.location.href = '/QuanLyTaiKhoan/CongThanhToan';
                                    }
                                });
                            } else {
                                var confirmGiaHan = confirm(data.message + "\n\nBấm OK để chuyển tới cổng thanh toán gia hạn.");
                                if (confirmGiaHan) {
                                    window.location.href = '/QuanLyTaiKhoan/CongThanhToan';
                                }
                            }
                            sessionStorage.setItem('daThongBaoSapHetHanVip', 'true');
                        }
                    }
                })
                .catch(error => console.error('Lỗi hệ thống kiểm tra VIP:', error));
        }
    </script>
}