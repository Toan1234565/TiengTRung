@{
    ViewData["Title"] = "Chọn Cấp Độ Luyện Nghe";

    // Khởi tạo danh sách cấp độ tĩnh (Static List)
    var staticCapDos = new List<dynamic>
    {
        new { Id = 1, Ten = "HSK 1", MoTa = "Cấp độ cơ bản nhất cho người mới bắt đầu." },
        new { Id = 2, Ten = "HSK 2", MoTa = "Sử dụng tiếng Trung trong các tình huống đơn giản." },
        new { Id = 3, Ten = "HSK 3", MoTa = "Giao tiếp cơ bản trong cuộc sống và học tập." },
        new { Id = 4, Ten = "HSK 4", MoTa = "Thảo luận về các chủ đề phức tạp hơn." },
        new { Id = 5, Ten = "HSK 5", MoTa = "Đọc hiểu báo chí và xem phim không cần sub." },
        new { Id = 6, Ten = "HSK 6", MoTa = "Sử dụng tiếng Trung thành thạo như người bản xứ." }
    };
}

<style>
    .hsk-hover-card {
        transition: all 0.3s cubic-bezier(.25,.8,.25,1);
        cursor: pointer;
        border-radius: 20px;
        overflow: hidden;
    }

        .hsk-hover-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 14px 28px rgba(0,0,0,0.1), 0 10px 10px rgba(0,0,0,0.08) !important;
            background-color: #fffaf5;
        }

            .hsk-hover-card:hover .bg-info {
                transform: scale(1.1);
                transition: transform 0.2s ease;
            }
</style>

<div class="container mt-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-uppercase">
            <i class="fa-solid fa-headphones me-2 text-info"></i>Luyện Nghe - Video
        </h2>
        <p class="text-muted">Chọn cấp độ để hiển thị danh sách video luyện nghe phù hợp</p>
    </div>

    <div class="row g-4">
        @foreach (var item in staticCapDos)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-0 hsk-hover-card position-relative">
                    <div class="card-body text-center p-4">
                        <div class="rounded-circle bg-info text-white d-inline-flex align-items-center justify-content-center mb-3 shadow-sm"
                             style="width: 65px; height: 65px; font-size: 24px; font-weight: bold;">
                            @item.Id
                        </div>

                        <h4 class="card-title fw-bold text-dark">@item.Ten</h4>
                        <p class="card-text text-muted small">@item.MoTa</p>

                        @* SỬA TẠI ĐÂY: Trỏ về Action DanhSachLuyeNghe trong cùng Controller *@
                        <a asp-action="DanhSachLuyeNghe"
                           asp-controller="QuanLyLuyenNghe"
                           asp-route-idCapDo="@item.Id"
                           class="btn btn-info text-white rounded-pill px-4 stretched-link shadow-sm mt-2">
                            Xem video <i class="fa-solid fa-play ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>