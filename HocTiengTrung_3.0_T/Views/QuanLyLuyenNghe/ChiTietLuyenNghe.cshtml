@model HocTiengTrung_3._0_T.Models12.QuanLyLuyenNghe.VideoLuyenNgheModels

@{
    ViewData["Title"] = Model.TieuDe;
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Gộp toàn bộ chữ Hán từ phụ đề để làm "Đáp án gốc", loại bỏ khoảng trắng thừa
    var originalTranscript = "";
    if (Model.VideoSubtitles != null)
    {
        originalTranscript = string.Join("", Model.VideoSubtitles.OrderBy(s => s.ThuTu).Select(s => s.HanTu));
    }
}

<style>
    :root {
        --bg-main: #09090b;
        --bg-panel: #18181b;
        --bg-header: #202024;
        --bg-input: #0f0f11;
        --border-color: #27272a;
        --border-focus: #f59e0b;
        --text-main: #f4f4f5;
        --text-muted: #a1a1aa;
        --accent-color: #f59e0b;
        --success-color: #10b981;
        --danger-color: #ef4444;
    }

    body {
        background-color: var(--bg-main);
        color: var(--text-main);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    .learning-workspace {
        display: grid;
        grid-template-columns: 5fr 4fr;
        gap: 20px;
        height: calc(100vh - 120px);
        min-height: 550px;
        margin-top: 15px;
    }

    .left-panel, .right-panel {
        display: flex;
        flex-direction: column;
        background: var(--bg-panel);
        border-radius: 12px;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        overflow: hidden;
    }

    /* --- VIDEO CONTAINER --- */
    .video-container {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        background: #000;
        border-bottom: 1px solid var(--border-color);
    }

    #youtube-player {
        width: 100%;
        height: 100%;
        border: none;
    }

    /* --- PANELS HEADER & FOOTER --- */
    .panel-header {
        padding: 12px 20px;
        background: var(--bg-header);
        border-bottom: 1px solid var(--border-color);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .controls-footer {
        padding: 12px 20px;
        background: var(--bg-header);
        border-top: 1px solid var(--border-color);
        display: flex;
        gap: 12px;
    }

    /* --- SUBTITLES WORKSPACE --- */
    .subtitle-wrapper {
        position: relative;
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background: var(--bg-panel);
    }

    .video-overlay-sub {
        position: absolute;
        bottom: 16px;
        left: 50%;
        transform: translateX(-50%) translateY(10px);
        width: 90%;
        text-align: center;
        background: rgba(15, 15, 17, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        padding: 12px 20px;
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        pointer-events: none;
        opacity: 0;
        visibility: hidden;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 10;
        box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    }

        .video-overlay-sub.show {
            opacity: 1;
            visibility: visible;
            transform: translateX(-50%) translateY(0);
        }

    .overlay-pinyin {
        color: var(--accent-color);
        font-size: 1rem;
        margin-bottom: 2px;
        letter-spacing: 0.5px;
    }

    .overlay-hantu {
        color: #ffffff;
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 2px;
        text-shadow: 0 2px 4px rgba(0,0,0,0.5);
    }

    .overlay-trans {
        color: var(--text-muted);
        font-size: 0.95rem;
    }

    .subtitle-list {
        flex: 1;
        overflow-y: auto;
        padding: 16px;
        scroll-behavior: smooth;
    }

    .subtitle-item {
        margin-bottom: 10px;
        padding: 12px 16px;
        cursor: pointer;
        border-radius: 8px;
        transition: all 0.2s ease;
        opacity: 0.4;
        border-left: 3px solid transparent;
        background: rgba(255, 255, 255, 0.01);
    }

        .subtitle-item:hover {
            background: rgba(255, 255, 255, 0.04);
            opacity: 0.8;
        }

        .subtitle-item.active {
            opacity: 1;
            background: rgba(245, 158, 11, 0.08);
            border-left-color: var(--accent-color);
        }

    .pinyin {
        color: var(--accent-color);
        font-size: 0.9rem;
        margin-bottom: 2px;
    }

    .hantu {
        color: var(--text-main);
        font-size: 1.35rem;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .translation {
        color: var(--text-muted);
        font-size: 0.9rem;
        margin-top: 4px;
    }

    /* Hiệu ứng làm mờ */
    .blur-text .hantu, .blur-text .pinyin,
    .blur-text.overlay-hantu, .blur-text.overlay-pinyin {
        filter: blur(5px);
        user-select: none;
        transition: filter 0.15s ease;
    }

        .blur-text .hantu:hover, .blur-text .pinyin:hover,
        .blur-text.overlay-hantu:hover, .blur-text.overlay-pinyin:hover {
            filter: blur(0px);
        }

    /* --- TEXTAREA NOTE PAD --- */
    .note-pad {
        flex: 1;
        width: 100%;
        background: var(--bg-input);
        color: #e4e4e7;
        border: none;
        padding: 20px;
        font-size: 1.1rem;
        line-height: 1.7;
        resize: none;
        outline: none;
        transition: box-shadow 0.2s;
    }

        .note-pad:focus {
            box-shadow: inset 0 0 0 1px var(--border-focus);
        }

    .btn-custom {
        border-radius: 6px;
        font-weight: 500;
        padding: 6px 14px;
        transition: all 0.15s ease;
    }

    /* --- SCROLLBAR --- */
    .subtitle-list::-webkit-scrollbar, .note-pad::-webkit-scrollbar, .compare-col::-webkit-scrollbar {
        width: 6px;
    }

    .subtitle-list::-webkit-scrollbar-thumb, .note-pad::-webkit-scrollbar-thumb, .compare-col::-webkit-scrollbar-thumb {
        background: #3f3f46;
        border-radius: 10px;
    }

    .subtitle-list::-webkit-scrollbar-track, .note-pad::-webkit-scrollbar-track, .compare-col::-webkit-scrollbar-track {
        background: transparent;
    }

    /* --- MODAL SO SÁNH --- */
    .compare-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.75);
        backdrop-filter: blur(6px);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 9999;
        opacity: 0;
        transition: opacity 0.2s ease;
    }

        .compare-modal-overlay.show {
            display: flex;
            opacity: 1;
        }

    .compare-modal-content {
        background: var(--bg-panel);
        width: 90%;
        max-width: 1000px;
        max-height: 80vh;
        border-radius: 12px;
        border: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        box-shadow: 0 20px 40px rgba(0,0,0,0.5);
        transform: scale(0.95);
        transition: transform 0.2s ease;
    }

    .compare-modal-overlay.show .compare-modal-content {
        transform: scale(1);
    }

    .modal-head {
        padding: 16px 20px;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--bg-header);
    }

    .modal-body {
        padding: 20px;
        overflow-y: auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        flex: 1;
    }

    .compare-col {
        background: var(--bg-input);
        padding: 16px;
        border-radius: 8px;
        border: 1px solid var(--border-color);
        font-size: 1.15rem;
        line-height: 1.8;
        overflow-y: auto;
    }

    .compare-title {
        font-size: 0.85rem;
        color: var(--text-muted);
        text-transform: uppercase;
        margin-bottom: 12px;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 6px;
        font-weight: bold;
    }

    .diff-correct {
        color: var(--success-color);
    }

    .diff-added {
        color: var(--danger-color);
        background: rgba(239, 68, 68, 0.12);
        font-weight: bold;
        padding: 0 2px;
        border-radius: 2px;
    }

    .diff-removed {
        color: #71717a;
        text-decoration: line-through;
        opacity: 0.5;
    }

    .legend {
        display: flex;
        gap: 20px;
        font-size: 0.9rem;
        padding: 12px 20px;
        background: var(--bg-header);
        border-top: 1px solid var(--border-color);
    }

    .legend-item span {
        display: inline-block;
        width: 12px;
        height: 12px;
        border-radius: 2px;
        margin-right: 6px;
    }
</style>

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mt-3 mb-2">
        <a asp-action="DanhSachLuyeNghe" class="text-decoration-none text-muted" style="transition: color 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='var(--text-muted)'">
            <i class="fas fa-arrow-left me-1"></i> Trở về danh sách
        </a>
        <h5 class="mb-0 text-white fw-bold">
            @Model.TieuDe
            <span class="badge bg-warning text-dark ms-2 align-middle" style="font-size:0.75rem">HSK @Model.IdCapDo</span>
        </h5>
    </div>

    <div class="learning-workspace">
        <div class="left-panel">
            <div class="video-container">
                <div id="youtube-player"></div>
            </div>

            <div class="panel-header">
                <span class="text-muted small fw-bold"><i class="fas fa-align-left me-1"></i> LỜI THOẠI</span>
                <div class="d-flex gap-1">
                    <button class="btn btn-sm btn-outline-info btn-custom" onclick="toggleOverlay()" id="btnOverlay">
                        <i class="fas fa-closed-captioning"></i> Tắt sub nổi
                    </button>
                    <button class="btn btn-sm btn-outline-warning btn-custom" onclick="toggleBlur()" id="btnBlur">
                        <i class="fas fa-eye-slash"></i> Che chữ Hán
                    </button>
                    <button class="btn btn-sm btn-outline-light btn-custom" onclick="toggleTranslation()" id="btnTrans">
                        <i class="fas fa-language"></i> Ẩn dịch
                    </button>
                </div>
            </div>

            <div class="subtitle-wrapper">
                <div class="video-overlay-sub" id="video-overlay">
                    <div class="overlay-pinyin" id="overlay-pinyin"></div>
                    <div class="overlay-hantu" id="overlay-hantu"></div>
                    <div class="overlay-trans" id="overlay-trans"></div>
                </div>

                <div class="subtitle-list" id="subtitle-list">
                    @if (Model.VideoSubtitles != null)
                    {
                        foreach (var sub in Model.VideoSubtitles.OrderBy(s => s.ThuTu))
                        {
                            double startSeconds = sub.StartTime?.ToTimeSpan().TotalSeconds ?? 0;
                            double endSeconds = sub.EndTime?.ToTimeSpan().TotalSeconds ?? 0;

                            <div class="subtitle-item" id="sub-@sub.IdSub" data-start="@startSeconds" data-end="@endSeconds" onclick="seekVideo(@startSeconds)">
                                <div class="pinyin">@sub.Pinyin</div>
                                <div class="hantu">@sub.HanTu</div>
                                <div class="translation">@sub.DichNghia</div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="controls-footer">
                <button class="btn btn-secondary btn-custom w-100 py-2" onclick="replaySentence()">
                    <i class="fas fa-redo-alt me-1"></i> Nghe lại câu hiện tại <kbd class="bg-dark ms-2">Ctrl + Space</kbd>
                </button>
            </div>
        </div>

        <div class="right-panel">
            <div class="panel-header">
                <span class="text-white small fw-bold"><i class="fas fa-pen-nib me-1"></i> DICTATION (CHÍNH TẢ)</span>
                <div>
                    <button class="btn btn-sm btn-success btn-custom" onclick="saveNotes()">
                        <i class="fas fa-save me-1"></i> Lưu lại
                    </button>
                    <button class="btn btn-sm btn-primary btn-custom ms-1" onclick="checkDictation()">
                        <i class="fas fa-check-double me-1"></i> Kiểm tra lỗi
                    </button>
                </div>
            </div>

            <textarea class="note-pad" id="dictation-textarea" placeholder="Nghe và gõ lại chữ Hán vào đây để luyện tập phản xạ chữ..."></textarea>

            <div class="controls-footer text-muted small">
                <div class="d-flex align-items-center gap-2">
                    <i class="fas fa-info-circle text-info"></i>
                    <span>Bấm <b>Kiểm tra lỗi</b> để đối chiếu. Phím tắt hệ thống: <kbd class="bg-secondary text-white">Shift + Space</kbd> để Dừng/Phát video.</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="compare-modal-overlay" id="compareModal">
    <div class="compare-modal-content">
        <div class="modal-head">
            <h6 class="mb-0 text-white fw-bold"><i class="fas fa-clipboard-check text-success me-2"></i> KẾT QUẢ ĐỐI CHIẾU CHÍNH TẢ</h6>
            <button class="btn btn-sm btn-link text-muted p-0" onclick="closeCompareModal()">
                <i class="fas fa-times fa-lg"></i>
            </button>
        </div>
        <div class="modal-body">
            <div class="compare-col">
                <div class="compare-title">Đáp án chuẩn hệ thống</div>
                <div id="result-original" style="color: #e4e4e7; letter-spacing: 0.5px;"></div>
            </div>
            <div class="compare-col">
                <div class="compare-title">Bài làm của bạn</div>
                <div id="result-diff" style="letter-spacing: 0.5px;"></div>
            </div>
        </div>
        <div class="legend small">
            <div class="legend-item"><span style="background: var(--success-color);"></span> Đúng chính tả</div>
            <div class="legend-item"><span style="background: var(--danger-color);"></span> Gõ sai/thừa</div>
            <div class="legend-item"><span style="background: #71717a;"></span> Bị bỏ sót</div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://www.youtube.com/iframe_api"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jsdiff/5.1.0/diff.min.js"></script>

    <script>
        let player;
        let currentActiveId = null; // Tối ưu hiệu năng: Lưu ID sub đang active để không re-render liên tục

        const subItems = document.querySelectorAll('.subtitle-item');
        const textArea = document.getElementById('dictation-textarea');
        const originalTranscript = @Html.Raw(Json.Serialize(originalTranscript));

        const subListEl = document.getElementById('subtitle-list');
        const overlayBox = document.getElementById('video-overlay');
        const overlayPinyin = document.getElementById('overlay-pinyin');
        const overlayHantu = document.getElementById('overlay-hantu');
        const overlayTrans = document.getElementById('overlay-trans');
        const compareModal = document.getElementById('compareModal');

        let isTransHidden = false;
        let isBlur = false;
        let isOverlayEnabled = true;

        // Tối ưu LocalStorage bằng cơ chế Debounce (Chờ 300ms sau khi ngừng gõ mới lưu)
        const storageKey = 'note_video_' + '@Model.IdVideo';
        if (localStorage.getItem(storageKey)) {
            textArea.value = localStorage.getItem(storageKey);
        }

        function debounce(func, timeout = 300){
            let timer;
            return (...args) => {
                clearTimeout(timer);
                timer = setTimeout(() => { func.apply(this, args); }, timeout);
            };
        }

        textArea.addEventListener('input', debounce(function() {
            localStorage.setItem(storageKey, textArea.value);
        }, 300));

        // ---------------- YOUTUBE API INTEGRATION ---------------- //
        function onYouTubeIframeAPIReady() {
            player = new YT.Player('youtube-player', {
                height: '100%',
                width: '100%',
                videoId: '@Model.VideoPath',
                playerVars: {
                    'rel': 0, 'modestbranding': 1, 'controls': 1, 'autoplay': 1, 'mute': 0, 'hl': 'zh'
                },
                events: { 'onReady': onPlayerReady }
            });
        }

        function onPlayerReady(event) {
            setInterval(updateSubtitles, 100); // 100ms kiểm tra một lần là tần suất chuẩn lý tưởng
        }

        // ---------------- TỐI ƯU REALTIME UPDATE SUBTITLES ---------------- //
        function updateSubtitles() {
            if (!player || typeof player.getCurrentTime !== 'function') return;

            const currentTime = player.getCurrentTime();
            let matchedItem = null;

            for (let i = 0; i < subItems.length; i++) {
                const item = subItems[i];
                const start = parseFloat(item.getAttribute('data-start'));
                const end = parseFloat(item.getAttribute('data-end'));

                if (currentTime >= start && currentTime <= end) {
                    matchedItem = item;
                    break;
                }
            }

            if (matchedItem) {
                const matchedId = matchedItem.id;

                // Chỉ chạy xử lý DOM khi thực sự đổi sang một câu mới
                if (currentActiveId !== matchedId) {
                    if (currentActiveId) {
                        const oldActive = document.getElementById(currentActiveId);
                        if (oldActive) oldActive.classList.remove('active');
                    }

                    matchedItem.classList.add('active');
                    currentActiveId = matchedId;

                    // Cuộn danh sách mượt mà
                    subListEl.scrollTo({
                        top: matchedItem.offsetTop - (subListEl.clientHeight / 2) + (matchedItem.clientHeight / 2),
                        behavior: 'smooth'
                    });

                    // Đồng bộ Text lên phụ đề nổi
                    overlayPinyin.innerHTML = matchedItem.querySelector('.pinyin').innerHTML;
                    overlayHantu.innerHTML = matchedItem.querySelector('.hantu').innerHTML;
                    overlayTrans.innerHTML = matchedItem.querySelector('.translation').innerHTML;
                }

                if (isOverlayEnabled) overlayBox.classList.add('show');
            } else {
                if (currentActiveId) {
                    const oldActive = document.getElementById(currentActiveId);
                    if (oldActive) oldActive.classList.remove('active');
                    currentActiveId = null;
                }
                overlayBox.classList.remove('show');
            }
        }

        // ---------------- HÀNH ĐỘNG ĐIỀU KHIỂN ---------------- //
        function seekVideo(seconds) {
            if (player?.seekTo) {
                player.seekTo(seconds, true);
                player.playVideo();
            }
        }

        function replaySentence() {
            const activeItem = document.querySelector('.subtitle-item.active');
            if (activeItem && player?.seekTo) {
                player.seekTo(parseFloat(activeItem.getAttribute('data-start')), true);
                player.playVideo();
            }
        }

        function toggleOverlay() {
            isOverlayEnabled = !isOverlayEnabled;
            const btn = document.getElementById('btnOverlay');
            if (isOverlayEnabled) {
                btn.innerHTML = '<i class="fas fa-closed-captioning"></i> Tắt sub nổi';
                btn.classList.replace('btn-info', 'btn-outline-info');
            } else {
                btn.innerHTML = '<i class="far fa-closed-captioning"></i> Bật sub nổi';
                btn.classList.replace('btn-outline-info', 'btn-info');
                overlayBox.classList.remove('show');
            }
        }

        function toggleTranslation() {
            isTransHidden = !isTransHidden;
            const btn = document.getElementById('btnTrans');
            const displayStyle = isTransHidden ? 'none' : 'block';

            document.querySelectorAll('.translation').forEach(t => t.style.display = displayStyle);
            overlayTrans.style.display = displayStyle;

            btn.innerHTML = isTransHidden ? '<i class="fas fa-language"></i> Hiện dịch' : '<i class="fas fa-language"></i> Ẩn dịch';
            isTransHidden ? btn.classList.replace('btn-outline-light', 'btn-light') : btn.classList.replace('btn-light', 'btn-outline-light');
        }

        function toggleBlur() {
            isBlur = !isBlur;
            const btn = document.getElementById('btnBlur');

            if (isBlur) {
                subListEl.classList.add('blur-text');
                overlayHantu.classList.add('blur-text');
                overlayPinyin.classList.add('blur-text');
                btn.innerHTML = '<i class="fas fa-eye"></i> Hiện chữ Hán';
                btn.classList.replace('btn-outline-warning', 'btn-warning');
            } else {
                subListEl.classList.remove('blur-text');
                overlayHantu.classList.remove('blur-text');
                overlayPinyin.classList.remove('blur-text');
                btn.innerHTML = '<i class="fas fa-eye-slash"></i> Che chữ Hán';
                btn.classList.replace('btn-warning', 'btn-outline-warning');
            }
        }

        // ---------------- TỐI ƯU CHẤM LỖI CHÍNH TẢ TIẾNG TRUNG ---------------- //
        function checkDictation() {
            const userText = textArea.value.trim();
            if (!userText) {
                alert("Bạn chưa gõ nội dung gì vào khung chính tả!");
                return;
            }

            // Loại bỏ khoảng trắng và tất cả các loại dấu câu đặc trưng của tiếng Trung để đối chiếu chính xác từ
            const regexPunctuation = /[\s+\.\!\?\,\=\+\-\_\(\)\{\}\[\]\:\;\'\"\,\，\。\？\！\、\；\：\“\”\‘\’\（\）\《\》]/g;
            const cleanOriginal = originalTranscript.replace(regexPunctuation, '');
            const cleanUser = userText.replace(regexPunctuation, '');

            const diff = Diff.diffChars(cleanOriginal, cleanUser);

            let diffHtml = '';
            diff.forEach((part) => {
                if (part.added) {
                    diffHtml += `<span class="diff-added">${part.value}</span>`;
                } else if (part.removed) {
                    diffHtml += `<span class="diff-removed">${part.value}</span>`;
                } else {
                    diffHtml += `<span class="diff-correct">${part.value}</span>`;
                }
            });

            document.getElementById('result-original').innerText = originalTranscript;
            document.getElementById('result-diff').innerHTML = diffHtml;
            compareModal.classList.add('show');

            if (player?.pauseVideo) player.pauseVideo();
        }

        function closeCompareModal() {
            compareModal.classList.remove('show');
        }

        // ---------------- API SAVE NOTES ---------------- //
        function saveNotes() {
            fetch('/api/quanlyluyennghe/save-notes', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ VideoId: @Model.IdVideo, Notes: textArea.value })
            })
            .then(res => {
                if (!res.ok) throw new Error('Lỗi phản hồi mạng');
                return res.json();
            })
            .then(data => alert(data.message || 'Hệ thống đã lưu lại bài làm thành công!'))
            .catch(err => {
                console.error(err);
                alert('Không thể kết nối đến máy chủ để lưu bài.');
            });
        }

        // ---------------- PHÍM TẮT NÂNG CAO (HOTKEYS) ---------------- //
        document.addEventListener('keydown', function(e) {
            // Phím tắt nghe lại câu hiện tại: Ctrl + Space
            if (e.ctrlKey && e.code === 'Space') {
                e.preventDefault();
                replaySentence();
            }
            // Phím tắt Dừng/Phát video tiện lợi: Shift + Space
            if (e.shiftKey && e.code === 'Space') {
                e.preventDefault();
                if (player && typeof player.getPlayerState === 'function') {
                    const state = player.getPlayerState();
                    if (state === 1) { // Đang phát -> Dừng
                        player.pauseVideo();
                    } else { // Đang dừng -> Phát tiếp
                        player.playVideo();
                    }
                }
            }
        });
    </script>
}