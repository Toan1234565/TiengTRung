@model dynamic
@{
    ViewData["Title"] = "Kho Tàng Bài Học";

    int currentCapDo = ViewBag.IdCapDo ?? 1;
    int currentIdGiaoTrinh = ViewBag.IdGiaoTrinh ?? 1;

    // Danh sách các cấp độ dành cho Hán Ngữ Boya (khi idGiaoTrinh = 2)
    var boyaLevels = new List<string> { "Sơ cấp 1", "Sơ cấp 2", "Trung cấp 1", "Trung cấp 2", "Cao cấp 1", "Cao cấp 2" };

    // Tên giáo trình hiển thị
    string currentGiaoTrinhText = currentIdGiaoTrinh == 1 ? "Chuẩn HSK" : (currentIdGiaoTrinh == 2 ? "Hán Ngữ Boya" : "Tân HSK Course");

    // Tên cấp độ hiển thị
    string currentCapDoText = currentIdGiaoTrinh == 2
        ? boyaLevels[Math.Min(Math.Max(currentCapDo - 1, 0), boyaLevels.Count - 1)]
        : $"HSK {currentCapDo}";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
            :root {
                --royal-gold: #d4af37;
                --royal-blue: #002366;
                --royal-light: #f1f4f9;
            }

            body {
                background-color: #f8f9fa;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            .royal-header {
                background: linear-gradient(135deg, var(--royal-blue) 0%, #003aaa 100%);
                color: white;
                border-radius: 20px;
                padding: 3rem 2rem;
                position: relative;
                overflow: hidden;
            }

                .royal-header::after {
                    content: '';
                    position: absolute;
                    top: -50%;
                    right: -20%;
                    width: 400px;
                    height: 400px;
                    background: rgba(212, 175, 55, 0.05);
                    border-radius: 50%;
                }

            .custom-card {
                border-radius: 20px;
                border: none;
                background: #ffffff;
                transition: transform 0.3s ease, box-shadow 0.3s ease;
            }

            .btn-rounded {
                border-radius: 50px;
                padding: 8px 20px;
                font-weight: 600;
                transition: all 0.3s ease;
            }

            /* Bộ lọc cấp độ */
            .filter-container {
                background: #ffffff;
                border-radius: 15px;
                padding: 16px;
            }

            .btn-filter-hsk {
                border-radius: 12px;
                padding: 10px 20px;
                font-weight: 700;
                border: 2px solid #edeef2;
                background: #fff;
                color: #495057;
                transition: all 0.2s ease-in-out;
                text-decoration: none;
                display: inline-block;
            }

                .btn-filter-hsk:hover {
                    border-color: var(--royal-blue);
                    background-color: rgba(0, 35, 102, 0.03);
                    color: var(--royal-blue);
                }

                .btn-filter-hsk.active {
                    background: var(--royal-blue);
                    border-color: var(--royal-blue);
                    color: #fff;
                    box-shadow: 0 4px 12px rgba(0, 35, 102, 0.2);
                }

            .badge-royal {
                background-color: rgba(214, 175, 87, 0.15);
                color: #b38f1d;
                border: 1px solid rgba(214, 175, 87, 0.3);
                font-weight: 600;
                border-radius: 10px;
                padding: 0.5rem 1rem;
            }

            .select-royal {
                border-radius: 12px;
                border: 2px solid #edeef2;
                padding: 10px 16px;
                font-weight: 600;
                color: var(--royal-blue);
                background-color: #fff;
                transition: all 0.2s ease;
                cursor: pointer;
            }

                .select-royal:focus {
                    border-color: var(--royal-blue);
                    box-shadow: 0 0 0 0.25rem rgba(0, 35, 102, 0.15);
                }

            .table-royal thead {
                background-color: var(--royal-light);
            }

            .table-royal th {
                color: var(--royal-blue);
                font-weight: 700;
                text-transform: uppercase;
                font-size: 0.85rem;
                letter-spacing: 0.5px;
                border: none;
                padding: 15px;
            }

            .table-royal td {
                padding: 18px 15px;
                vertical-align: middle;
                border-bottom: 1px solid #edeef2;
            }

            .pagination .page-item .page-link {
                border: none;
                color: var(--royal-blue);
                margin: 0 3px;
                border-radius: 50%;
                width: 40px;
                height: 40px;
                line-height: 24px;
                text-align: center;
                font-weight: 600;
            }

            .pagination .page-item.active .page-link {
                background-color: var(--royal-blue);
                color: #fff;
                box-shadow: 0 4px 10px rgba(0, 35, 102, 0.25);
            }

            .pagination .page-item .page-link:hover {
                background-color: rgba(0, 35, 102, 0.08);
                border-radius: 50%;
            }

            .btn-purple {
                background: linear-gradient(135deg, #6f42c1 0%, #a100ff 100%);
                border: none;
                transition: all 0.3s ease;
            }

                .btn-purple:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 4px 12px rgba(111, 66, 193, 0.3) !important;
                    color: #fff;
                }
    </style>
</head>
<body>

    <div class="container py-5">

        <!-- HEADER -->
        <div class="royal-header text-center mb-4 shadow-sm text-white">
            <h1 class="display-5 fw-bold mb-3">
                <i class="bi bi-gem text-warning me-2"></i>Kho Tàng Bài Học
            </h1>
            <p class="lead text-white-50 mx-auto mb-0" style="max-width: 700px;">
                Hệ thống lưu trữ toàn bộ giáo trình nâng cao năng lực Tiếng Trung.
            </p>
            <div class="mt-3">
                <span class="badge badge-royal text-warning">
                    <i class="fas fa-layer-group me-2"></i>Đang xem: @currentCapDoText | Giáo Trình: @currentGiaoTrinhText
                </span>
            </div>
        </div>

        <!-- BỘ LỌC TỔNG HỢP -->
        <div class="filter-container shadow-sm mb-4 border rounded-4 bg-white">
            <div class="row align-items-center g-3">
                <div class="col-lg-12 mb-2">
                    <a href="@Url.Action("DanhSachLoaiBaiTap", "QuanLyDanhSachBaiTap", new { capdo = currentCapDo, chuongTrinh = (currentIdGiaoTrinh == 3 ? "3" : "2") })"
                       class="btn btn-purple text-white fw-bold rounded-pill text-nowrap px-3 shadow-sm d-inline-flex align-items-center gap-1"
                       title="Chuyển sang trang làm bài tập">
                        <i class="fas fa-pen-to-square"></i>
                        <span class="d-none d-sm-inline">Chuyển sang trang bài tập thực hành (tổng hợp)</span>
                    </a>
                </div>

                <!-- BỘ LỌC GIÁO TRÌNH -->
                <div class="col-lg-4 col-md-5">
                    <div class="d-flex align-items-center">
                        <label for="selectGiaoTrinh" class="fw-bold text-dark me-2 text-nowrap">
                            <i class="fas fa-book text-warning me-1"></i> Giáo trình:
                        </label>
                        <select id="selectGiaoTrinh" class="form-select select-royal" onchange="changeGiaoTrinh(this.value)">
                            <option value="1" selected="@(currentIdGiaoTrinh == 1)">Lộ Trình Hán Ngữ HSK (Khung HSK 2.0)</option>
                            <option value="2" selected="@(currentIdGiaoTrinh == 2)">Lộ Trình Hán Ngữ Bổ Trợ (Khung Boya V3)</option>
                            <option value="3" selected="@(currentIdGiaoTrinh == 3)">Lộ Trình Hán Ngữ Chuẩn HSK 3.0</option>
                        </select>
                    </div>
                </div>

                <!-- BỘ LỌC CẤP ĐỘ -->
                <div class="col-lg-8 col-md-7">
                    <div class="d-flex align-items-center flex-wrap gap-2 justify-content-md-end">
                        <span class="fw-bold text-dark d-none d-xl-inline me-2">
                            <i class="fas fa-filter text-primary me-1"></i> Cấp độ:
                        </span>
                        <div class="d-flex flex-wrap gap-2 w-100 w-md-auto">
                            @if (currentIdGiaoTrinh == 2)
                            {
                                @for (int i = 1; i <= boyaLevels.Count; i++)
                                {
                                    <a href="@Url.Action("DanhSachBaiHoc", "QuanLyDanhSachBaiHoc", new { capdo = i, idGiaoTrinh = currentIdGiaoTrinh, page = 1 })"
                                       class="btn btn-filter-hsk rounded-pill flex-fill flex-md-grow-0 px-3 py-2 fw-semibold transition-all @(currentCapDo == i ? "active" : "")">
                                        <i class="fas fa-graduation-cap small me-1 @(currentCapDo == i ? "text-warning" : "opacity-50")"></i> @boyaLevels[i - 1]
                                    </a>
                                }
                            }
                            else
                            {
                                @for (int i = 1; i <= 6; i++)
                                {
                                    <a href="@Url.Action("DanhSachBaiHoc", "QuanLyDanhSachBaiHoc", new { capdo = i, idGiaoTrinh = currentIdGiaoTrinh, page = 1 })"
                                       class="btn btn-filter-hsk rounded-pill flex-fill flex-md-grow-0 px-3 py-2 fw-semibold transition-all @(currentCapDo == i ? "active" : "")">
                                        <i class="fas fa-crown small me-1 @(currentCapDo == i ? "text-warning" : "opacity-50")"></i> HSK @i
                                    </a>
                                }
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- DANH SÁCH BÀI HỌC -->
        <div class="card custom-card shadow-sm p-4">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                <div>
                    <h3 class="fw-bold text-dark m-0">
                        <i class="fas fa-book-open text-primary me-2"></i>Danh Sách Chương Trình Học
                    </h3>
                    <small class="text-muted">
                        Hiển thị kết quả thuộc phân khu: <strong>@currentCapDoText</strong>
                    </small>
                </div>
            </div>

            @if (Model != null && Model.data != null && Model.data.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-royal table-hover align-middle">
                        <thead>
                            <tr>
                                <th class="text-center" style="width: 12%">Thứ tự bài</th>
                                <th style="width: 48%">Tên Bài Học</th>
                                <th style="width: 25%">Mô Tả Chi Tiết</th>
                                <th class="text-center" style="width: 15%">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.data)
                            {
                                <tr>
                                    <td class="text-center">
                                        <span class="fw-bold text-dark bg-light px-3 py-2 rounded-3 border">
                                            Bài @item.soThuTuBai
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <span class="fw-bold text-primary fs-5">@item.tenBaiHoc</span>
                                        </div>

                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1 small" style="font-size: 0.75rem;">
                                            <i class="fas fa-check-circle me-1"></i>Đang hoạt động
                                        </span>
                                    </td>
                                    <td>
                                        <div class="text-muted text-truncate-2" style="max-width: 450px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; white-space: normal;">
                                            @(item.moTa ?? "Chưa có mô tả bổ sung cho bài học này.")
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <a href="@Url.Action("ChiTietBaiHoc", "QuanLyDanhSachBaiHoc", new { id = item.idBaiHoc })" class="btn btn-primary text-white btn-rounded shadow-sm btn-sm">
                                            <i class="fas fa-play me-1"></i> Học ngay
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.totalPages > 1)
                {
                    <nav class="mt-5">
                        <ul class="pagination justify-content-center align-items-center">

                            <!-- Nút Trở Về -->
                            <li class="page-item @(Model.currentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("DanhSachBaiHoc", "QuanLyDanhSachBaiHoc", new { capdo = currentCapDo, idGiaoTrinh = currentIdGiaoTrinh, page = (int)Model.currentPage - 1 })" aria-label="Previous">
                                    <i class="fas fa-chevron-left small"></i>
                                </a>
                            </li>

                            <!-- Danh Sách Trang -->
                            @for (int i = 1; i <= (int)Model.totalPages; i++)
                            {
                                <li class="page-item @(i == (int)Model.currentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("DanhSachBaiHoc", "QuanLyDanhSachBaiHoc", new { capdo = currentCapDo, idGiaoTrinh = currentIdGiaoTrinh, page = i })">@i</a>
                                </li>
                            }

                            <!-- Nút Trang Kế Tiếp -->
                            <li class="page-item @(Model.currentPage == Model.totalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("DanhSachBaiHoc", "QuanLyDanhSachBaiHoc", new { capdo = currentCapDo, idGiaoTrinh = currentIdGiaoTrinh, page = (int)Model.currentPage + 1 })" aria-label="Next">
                                    <i class="fas fa-chevron-right small"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-folder-open text-muted display-4 mb-3"></i>
                    <p class="text-muted fs-5">Không tìm thấy bài học nào phù hợp với bộ lọc hiện tại.</p>
                </div>
            }

        </div>
    </div>

    <script>
            function changeGiaoTrinh(selectedId) {
                window.location.href = '@Url.Action("DanhSachBaiHoc", "QuanLyDanhSachBaiHoc")' + '?capdo=1&idGiaoTrinh=' + selectedId + '&page=1';
            }
    </script>
</body>
</html>