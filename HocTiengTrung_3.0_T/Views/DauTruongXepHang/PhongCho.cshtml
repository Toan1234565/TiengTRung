@{
    ViewData["Title"] = "Đấu Trường Xếp Hạng HSK 3.0";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var currentUserName = User.Identity?.IsAuthenticated == true
        ? (User.FindFirst("FullName")?.Value ?? User.Identity.Name)
        : "Thí sinh " + new Random().Next(100, 999);
}

<!-- Google Fonts & FontAwesome -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    :root {
        --primary: #4f46e5;
        --primary-hover: #4338ca;
        --secondary: #8b5cf6;
        --bg-main: #f0f4ff;
        --card-bg: rgba(255, 255, 255, 0.85);
        --text-main: #1e293b;
        --text-muted: #64748b;
        --success: #10b981;
        --warning: #f59e0b;
        --danger: #ef4444;
        --radius-xl: 24px;
        --radius-lg: 16px;
        --radius-md: 12px;
        --shadow-glow: 0 0 20px rgba(79, 70, 229, 0.2);
        --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        --shadow-md: 0 10px 25px -5px rgba(79, 70, 229, 0.15);
    }

    body {
        background: linear-gradient(-45deg, #f0f4ff, #e0e7ff, #ede9fe, #f5f3ff);
        background-size: 400% 400%;
        animation: gradientBG 15s ease infinite;
        color: var(--text-main);
        font-family: 'Plus Jakarta Sans', sans-serif;
        min-height: 100vh;
    }

    @@keyframes gradientBG {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    .arena-container {
        max-width: 1140px;
        margin: 0 auto;
        padding: 30px 15px;
    }

    .screen-section {
        display: none;
        min-height: 75vh;
        animation: slideFadeUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .screen-active {
        display: block;
    }

    @@keyframes slideFadeUp {
        0% {
            opacity: 0;
            transform: translateY(20px) scale(0.98);
        }

        100% {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .smart-card {
        background: var(--card-bg);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow-md);
        border: 1px solid rgba(255, 255, 255, 0.6);
        padding: 32px;
        margin-bottom: 24px;
        position: relative;
    }

    .room-header {
        background: rgba(255, 255, 255, 0.9);
        border-radius: var(--radius-lg);
        padding: 16px 24px;
        box-shadow: var(--shadow-sm);
        border: 1px solid rgba(255, 255, 255, 0.8);
    }

    .room-badge {
        background: linear-gradient(135deg, #e0e7ff, #ede9fe);
        color: var(--primary);
        font-weight: 900;
        letter-spacing: 3px;
        padding: 8px 20px;
        border-radius: var(--radius-md);
        display: inline-flex;
        align-items: center;
        gap: 12px;
    }

    .btn-copy {
        background: transparent;
        border: none;
        color: var(--secondary);
        cursor: pointer;
        transition: transform 0.2s;
    }

        .btn-copy:hover {
            transform: scale(1.2);
            color: var(--primary);
        }

    /* PLAYER CARD */
    .player-card {
        background: rgba(255,255,255,0.6);
        border: 2px dashed #cbd5e1;
        border-radius: var(--radius-lg);
        text-align: center;
        padding: 20px 10px;
        position: relative;
        min-height: 170px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        transition: all 0.3s;
    }

        .player-card.occupied {
            border-style: solid;
            border-color: transparent;
            background: #ffffff;
            box-shadow: var(--shadow-sm);
        }

        .player-card.is-ready {
            border-color: var(--success);
            background: linear-gradient(to bottom, #f0fdf4, #ffffff);
            box-shadow: 0 0 15px rgba(16, 185, 129, 0.3);
        }

        .player-card .avatar {
            width: 65px;
            height: 65px;
            border-radius: 50%;
            border: 3px solid #e2e8f0;
            object-fit: cover;
            background: #f1f5f9;
            margin-bottom: 12px;
        }

        .player-card.is-ready .avatar {
            border-color: var(--success);
            transform: scale(1.05);
        }

    .host-crown {
        position: absolute;
        top: -12px;
        left: 50%;
        transform: translateX(-50%);
        background: linear-gradient(135deg, #fbbf24, #f59e0b);
        color: #fff;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        box-shadow: 0 4px 10px rgba(245, 158, 11, 0.4);
    }

    .btn-kick {
        position: absolute;
        top: 8px;
        right: 8px;
        background: #fee2e2;
        color: var(--danger);
        border: none;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        font-size: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        opacity: 0;
    }

    .player-card:hover .btn-kick {
        opacity: 1;
    }

    .btn-kick:hover {
        background: var(--danger);
        color: #fff;
    }

    /* BUTTONS */
    .btn-smart-primary {
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        color: #ffffff;
        border: none;
        font-weight: 800;
        padding: 14px 32px;
        border-radius: var(--radius-lg);
        box-shadow: 0 6px 0 #312e81, 0 10px 20px rgba(79, 70, 229, 0.3);
        transition: all 0.15s ease;
        text-transform: uppercase;
    }

        .btn-smart-primary:hover {
            transform: translateY(2px);
            box-shadow: 0 4px 0 #312e81;
            color: #fff;
        }

        .btn-smart-primary:active {
            transform: translateY(6px);
            box-shadow: none;
        }

    .btn-smart-success {
        background: linear-gradient(135deg, #10b981, #059669);
        color: #ffffff;
        border: none;
        font-weight: 800;
        padding: 14px 32px;
        border-radius: var(--radius-lg);
        box-shadow: 0 6px 0 #064e3b, 0 10px 20px rgba(16, 185, 129, 0.3);
        transition: all 0.15s ease;
    }

        .btn-smart-success:hover {
            color: #fff;
            transform: translateY(2px);
        }

        .btn-smart-success:active {
            transform: translateY(6px);
            box-shadow: none;
        }

    .btn-smart-warning {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: #ffffff;
        border: none;
        font-weight: 800;
        padding: 14px 32px;
        border-radius: var(--radius-lg);
        box-shadow: 0 6px 0 #78350f, 0 10px 20px rgba(245, 158, 11, 0.3);
        transition: all 0.15s ease;
    }

        .btn-smart-warning:hover {
            color: #fff;
            transform: translateY(2px);
        }

        .btn-smart-warning:active {
            transform: translateY(6px);
            box-shadow: none;
        }

    .join-room-box {
        display: flex;
        gap: 12px;
        max-width: 420px;
        margin: 0 auto;
    }

        .join-room-box input {
            border: 2px solid transparent;
            background: rgba(255,255,255,0.9);
            border-radius: var(--radius-lg);
            padding: 12px 20px;
            font-size: 1.2rem;
            font-weight: 800;
            text-align: center;
            letter-spacing: 4px;
            outline: none;
            text-transform: uppercase;
        }

            .join-room-box input:focus {
                border-color: var(--secondary);
                background: #fff;
            }

    /* QUESTION ARENA STYLES */
    .question-card {
        background: rgba(255,255,255,0.95);
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow-md);
        padding: 40px;
    }

    .option-btn {
        background: #f8fafc;
        border: 2px solid #e2e8f0;
        border-radius: var(--radius-lg);
        padding: 18px 24px;
        text-align: left;
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text-main);
        transition: all 0.2s;
        width: 100%;
        display: flex;
        align-items: center;
        gap: 16px;
    }

        .option-btn:hover:not(:disabled) {
            border-color: var(--secondary);
            background: #faf5ff;
            transform: translateX(6px);
        }

        .option-btn.correct {
            background: var(--success) !important;
            color: white !important;
            border-color: var(--success) !important;
        }

        .option-btn.wrong {
            background: var(--danger) !important;
            color: white !important;
            border-color: var(--danger) !important;
        }

    .timer-badge {
        font-size: 1.4rem;
        font-weight: 900;
        color: #ef4444;
        background: #fee2e2;
        padding: 10px 24px;
        border-radius: 30px;
    }

    /* 3D PODIUM STYLES */
    .podium-container {
        display: flex;
        align-items: flex-end;
        justify-content: center;
        gap: 20px;
        margin-top: 40px;
        height: 320px;
        padding-bottom: 20px;
    }

    .podium-place {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 120px;
        position: relative;
    }

        .podium-place .avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            border: 4px solid #fff;
            box-shadow: 0 10px 20px rgba(0,0,0,0.2);
            margin-bottom: -20px;
            z-index: 2;
            object-fit: cover;
        }

    .podium-block {
        width: 100%;
        border-radius: 12px 12px 4px 4px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        color: white;
        font-weight: 900;
        font-size: 1.5rem;
        padding-top: 25px;
    }

    .place-1 .podium-block {
        height: 180px;
        background: linear-gradient(180deg, #fbbf24, #d97706);
    }

    .place-2 .podium-block {
        height: 130px;
        background: linear-gradient(180deg, #94a3b8, #475569);
    }

    .place-3 .podium-block {
        height: 90px;
        background: linear-gradient(180deg, #d97706, #92400e);
    }
</style>

<div class="arena-container">
    <input type="hidden" id="currentMaPhong" value="" />

    <!-- MÀN HÌNH 0: TRANG CHỦ -->
    <div id="home-screen" class="screen-section screen-active text-center pt-4">
        <div class="mb-5">
            <h2 class="fw-extrabold" style="font-weight: 900; font-size: 2.8rem; background: linear-gradient(to right, var(--primary), var(--secondary)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                <i class="fas fa-fire me-2" style="-webkit-text-fill-color: initial; color: var(--warning);"></i>ĐẤU TRƯỜNG HSK 3.0
            </h2>
            <p class="text-muted fs-5">Xin chào <strong>@currentUserName</strong>! Sẵn sàng thử thách chưa?</p>
        </div>

        <div class="smart-card mx-auto" style="max-width: 560px;">
            <h6 class="fw-bold text-uppercase text-muted mb-4"><i class="fas fa-sign-in-alt me-2"></i>Tham gia bằng mã phòng</h6>
            <div class="join-room-box mb-4">
                <input type="text" id="txtMaPhongInput" class="form-control" placeholder="MÃ PHÒNG" maxlength="6">
                <button class="btn btn-smart-primary px-4" onclick="vaoPhong()">
                    <i class="fas fa-arrow-right fs-4"></i>
                </button>
            </div>

            <div class="position-relative my-5">
                <hr style="border-color: #cbd5e1; border-width: 2px;">
                <span class="position-absolute top-50 start-50 translate-middle px-4 text-muted fw-bold" style="background: var(--card-bg); font-size: 0.85rem;">HOẶC TẠO PHÒNG MỚI</span>
            </div>

            <div class="text-start mb-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-secondary">CẤP ĐỘ HSK</label>
                        <select id="selectCapDo" class="form-select form-select-lg border-2 shadow-sm rounded-3">
                            <option value="1">HSK 1</option>
                            <option value="2">HSK 2</option>
                            <option value="3" selected>HSK 3 (Tiêu chuẩn)</option>
                            <option value="4">HSK 4</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-secondary">SỐ CÂU HỎI</label>
                        <select id="selectSoCau" class="form-select form-select-lg border-2 shadow-sm rounded-3">
                            <option value="5">5 Câu</option>
                            <option value="10" selected>10 Câu</option>
                            <option value="15">15 Câu</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-secondary">THỜI GIAN / CÂU</label>
                        <select id="selectThoiGian" class="form-select form-select-lg border-2 shadow-sm rounded-3">
                            <option value="10">10 Giây</option>
                            <option value="15" selected>15 Giây</option>
                            <option value="20">20 Giây</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-secondary">LOẠI BÀI</label>
                        <select id="select-loai" class="form-select form-select-lg border-2 shadow-sm rounded-3">
                            <option value="">Trộn ngẫu nhiên</option>
                            <option value="1005">Từ vựng</option>
                            <option value="1008">Dịch thuật</option>
                        </select>
                    </div>
                </div>
            </div>

            <button class="btn btn-smart-success w-100 py-3 fs-5 mt-2" onclick="taoPhong()">
                <i class="fas fa-magic me-2"></i>TẠO PHÒNG NGAY
            </button>
        </div>
    </div>

    <!-- MÀN HÌNH 1: SẢNH CHỜ (LOBBY) -->
    <div id="lobby-screen" class="screen-section">
        <div class="room-header d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center gap-3">
                <span class="text-muted fw-bold">MÃ PHÒNG:</span>
                <div class="room-badge fs-3">
                    <span id="lblMaPhong">------</span>
                    <button class="btn-copy" onclick="copyMaPhong()" title="Sao chép mã"><i class="far fa-copy"></i></button>
                </div>
            </div>
            <button class="btn btn-outline-danger fw-bold rounded-pill px-4 py-2 shadow-sm" onclick="roiPhong()">
                <i class="fas fa-sign-out-alt me-2"></i> Thoát
            </button>
        </div>

        <div class="smart-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-extrabold text-dark mb-0">
                    <i class="fas fa-users text-primary me-2"></i>CHIẾN BINH (<span id="lblPlayerCount">0/15</span>)
                </h5>
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 fs-6 px-3 py-2 rounded-pill shadow-sm" id="lblRoomInfo">HSK 3 - 10 Câu - 15s</span>
            </div>

            <div class="row g-4" id="player-list">
                <!-- Dynamic Player Slots -->
            </div>
        </div>

        <div class="text-center mt-5">
            <button id="btnSanSang" class="btn btn-lg btn-smart-success px-5 py-3 fs-4 w-50" onclick="toggleSanSang()">
                <i class="fas fa-check-circle me-2"></i>SẴN SÀNG
            </button>
            <button id="btnBatDau" class="btn btn-lg btn-smart-primary px-5 py-3 fs-4 w-50 d-none" onclick="batDauTranDau()">
                <i class="fas fa-play me-2"></i>BẮT ĐẦU CHIẾN THẦN
            </button>
        </div>
    </div>

    <!-- MÀN HÌNH 2: GIAO DIỆN THI ĐẤU -->
    <div id="game-screen" class="screen-section">
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="question-card text-center">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="badge bg-secondary fs-5 px-4 py-2 rounded-pill shadow-sm" id="lblCauHieuHienTai">Câu 1 / 10</span>
                        <div class="timer-badge">
                            <i class="fas fa-stopwatch me-2"></i><span id="lblTimer">15</span>s
                        </div>
                    </div>

                    <div class="mb-5 py-4 bg-light rounded-4 border">
                        <h2 class="fw-extrabold text-dark mb-3" style="font-size: 2.2rem;" id="lblNoiDungCauHoi">Đang tải câu hỏi...</h2>
                        <p class="text-primary fs-4 mb-0 fw-bold" id="lblPinyinOrMeaning"></p>
                    </div>

                    <div class="row g-3 text-start" id="options-container">
                        <div class="col-md-6"><button class="option-btn" data-key="A" onclick="chonDapAn('A', this)"><span class="badge bg-white text-dark border fs-5 shadow-sm">A</span><span class="option-text fs-5">...</span></button></div>
                        <div class="col-md-6"><button class="option-btn" data-key="B" onclick="chonDapAn('B', this)"><span class="badge bg-white text-dark border fs-5 shadow-sm">B</span><span class="option-text fs-5">...</span></button></div>
                        <div class="col-md-6"><button class="option-btn" data-key="C" onclick="chonDapAn('C', this)"><span class="badge bg-white text-dark border fs-5 shadow-sm">C</span><span class="option-text fs-5">...</span></button></div>
                        <div class="col-md-6"><button class="option-btn" data-key="D" onclick="chonDapAn('D', this)"><span class="badge bg-white text-dark border fs-5 shadow-sm">D</span><span class="option-text fs-5">...</span></button></div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="smart-card p-4">
                    <h5 class="fw-extrabold text-primary mb-4 border-bottom pb-3">
                        <i class="fas fa-trophy text-warning me-2"></i>BẢNG XẾP HẠNG
                    </h5>
                    <div id="live-scoreboard" class="d-flex flex-column gap-3">
                        <!-- Scoreboard Items -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MÀN HÌNH 3: KẾT QUẢ CHUNG CUỘC -->
    <div id="result-screen" class="screen-section text-center pt-4">
        <h1 class="fw-extrabold text-warning mb-2" style="font-size: 3.5rem;">
            <i class="fas fa-crown"></i> VINH DANH
        </h1>
        <p class="text-muted fs-4 mb-5">Thử thách HSK 3.0 đã khép lại. Chúc mừng các cao thủ!</p>

        <div class="smart-card mx-auto" style="max-width: 700px;">
            <div id="final-podium" class="podium-container mb-5">
                <!-- Render Podium JS -->
            </div>

            <div id="final-leaderboard" class="text-start mb-5 bg-light rounded-4 p-4 border">
                <!-- List Leaderboard -->
            </div>

            <button class="btn btn-smart-primary px-5 py-3 w-100 fs-5" onclick="veTrangChu()">
                <i class="fas fa-home me-2"></i>VỀ TRANG CHỦ
            </button>
        </div>
    </div>
</div>

<!-- SignalR JS Library -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<script>
    const MAX_SLOTS = 15;
    const realUserName = "@currentUserName";

    // 1. Khởi tạo đối tượng người chơi
    const currentUser = {
        idNguoiChoi: "USER_" + Math.floor(Math.random() * 10000),
        tenNguoiChoi: realUserName,
        avatar: "https://api.dicebear.com/7.x/bottts/svg?seed=" + encodeURIComponent(realUserName),
        isHost: false,
        trangThai: 0,
        score: 0
    };

    let currentRoomId = "";
    let timerInterval = null;
    let timeRemaining = 15;
    let timePerQuestion = 15;
    let dapAnDung = null;
    let hasAnsweredCurrentQuestion = false;

    window.gameQuestions = [];
    window.currentQuestionIndex = 0;
    window.roomPlayers = [];

    /* ======================================================== */
    /* 1. CHỐNG THOÁT TRANG / TẢI LẠI TRANG KHI ĐANG CHƠI       */
    /* ======================================================== */
    window.addEventListener("beforeunload", function(e) {
        // Nếu đã vào phòng (có ID phòng) thì hiện cảnh báo
        if (currentRoomId !== "") {
            const confirmationMessage = "Bạn đang trong phòng thi đấu. Bạn có chắc chắn muốn thoát không?";
            e.returnValue = confirmationMessage; // Dành cho các trình duyệt cũ
            return confirmationMessage; // Dành cho trình duyệt hiện đại
        }
    });

    /* SIGNALR CONNECTION SETUP */
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/dautruong-th2-hub")
        .withAutomaticReconnect()
        .build();

    async function startSignalR() {
        try {
            await connection.start();
            console.log("%c[SignalR] Ket noi thanh cong!", "color: green; font-weight: bold;");
        } catch (err) {
            console.warn("[SignalR] Chua the ket noi voi máy chủ (Se dung che do Du phong local):", err);
            setTimeout(startSignalR, 5000);
        }
    }
    startSignalR();

    // Safe Invoke: Gọi hàm server an toàn, nếu mất kết nối sẽ fallback nhẹ nhàng
    async function safeInvoke(method, ...args) {
        if (connection.state === signalR.HubConnectionState.Connected) {
            try {
                await connection.invoke(method, ...args);
                return true;
            } catch (err) {
                console.error(`Loi goi method ${method}:`, err);
                return false;
            }
        } else {
            console.warn(`SignalR disconnected. Che do du phong Mockup duoc kich hoat cho ${method}.`);
            return false;
        }
    }

    /* LẮNG NGHE SỰ KIỆN SIGNALR */
    connection.on("RoomUpdated", (roomData) => {
        const list = roomData?.danhSachNguoiChoi || roomData?.DanhSachNguoiChoi;
        if (list) {
            window.roomPlayers = list;
            const me = window.roomPlayers.find(p => getProp(p, "idNguoiChoi") === currentUser.idNguoiChoi);
            if (me) {
                currentUser.isHost = getProp(me, "isHost");
                currentUser.trangThai = getProp(me, "trangThai");
            }
            renderLobby(roomData);
        }
    });

    connection.on("KickedFromRoom", (msg) => {
        alert(msg || "Bạn đã bị chủ phòng mời ra khỏi phòng!");
        veTrangChu(true); // Tham số true để bỏ qua cảnh báo thoát
    });

    connection.on("GameStarted", (matchData) => {
        const questions = matchData?.data?.danhSachCauHoi || matchData?.danhSachCauHoi || matchData?.DanhSachCauHoi || [];
        if (questions.length > 0) {
            window.gameQuestions = questions;
            window.currentQuestionIndex = 0;
            window.roomPlayers.forEach(p => setProp(p, "score", 0));
            currentUser.score = 0;
            chuyenManHinh("game-screen");
            renderScoreboard();
            loadCurrentQuestion();
        }
    });

    connection.on("UpdateScoreboard", (scores) => {
        if (Array.isArray(scores)) {
            scores.forEach(s => {
                const sId = getProp(s, "idNguoiChoi");
                const sScore = getProp(s, "score");
                const p = window.roomPlayers.find(x => getProp(x, "idNguoiChoi") === sId);
                if (p) setProp(p, "score", sScore);
            });
        }
        renderScoreboard();
    });

    /* HELPER GET/SET PROPERTIES (Tránh lỗi phân biệt hoa/thường của JSON) */
    function getProp(obj, propName) {
        if (!obj) return null;
        const pascal = propName.charAt(0).toUpperCase() + propName.slice(1);
        const camel = propName.charAt(0).toLowerCase() + propName.slice(1);
        return obj[propName] !== undefined ? obj[propName] : (obj[pascal] !== undefined ? obj[pascal] : obj[camel]);
    }

    function setProp(obj, propName, val) {
        if (!obj) return;
        const pascal = propName.charAt(0).toUpperCase() + propName.slice(1);
        const camel = propName.charAt(0).toLowerCase() + propName.slice(1);
        if (obj[pascal] !== undefined) obj[pascal] = val;
        else obj[camel] = val;
        obj[propName] = val;
    }

    async function taoPhong() {
        const idCapDo = document.getElementById("selectCapDo").value;
        const soCau = document.getElementById("selectSoCau").value;
        const thoiGian = document.getElementById("selectThoiGian")?.value;
        const idLoai = document.getElementById("select-loai")?.value;

        try {
            const res = await fetch("/api/dau-truong/th2/tao-phong", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    IdNguoiChoi: currentUser.IdNguoiChoi,
                    TenNguoiChoi: currentUser.TenNguoiChoi,
                    Avatar: currentUser.Avatar,
                    IdCapDo: parseInt(idCapDo),
                    SoLuongCauHoi: parseInt(soCau),
                    ThoiGianMoiCau: thoiGian ? parseInt(thoiGian) : 15,
                    IdLoaiBaiTap: idLoai ? parseInt(idLoai) : null
                })
            });

            const responseData = await res.json();
            if (!res.ok || !responseData.success) {
                throw new Error(responseData.message || "Tạo phòng thất bại!");
            }

            const room = responseData.data;
            currentRoomId = room.maPhong || room.MaPhong;
            timePerQuestion = room.thoiGianMoiCau || room.ThoiGianMoiCau || parseInt(thoiGian) || 15;

            currentUser.IsHost = true;
            currentUser.TrangThai = 1;

            await joinSignalRGroup(currentRoomId);
            renderLobby(room);
            chuyenManHinh("lobby-screen");

        } catch (error) {
            console.error("Lỗi tạo phòng:", error);
            alert(error.message || "Không thể tạo phòng lúc này. Vui lòng thử lại!");
        }
    }

    async function vaoPhong() {
        const maInput = document.getElementById("txtMaPhongInput").value.trim().toUpperCase();
        if (!maInput) { alert("Vui lòng nhập mã phòng!"); return; }

        currentRoomId = maInput;
        document.getElementById("currentMaPhong").value = currentRoomId;
        currentUser.isHost = false;
        currentUser.trangThai = 0;

        if (!window.roomPlayers.some(p => getProp(p, "idNguoiChoi") === currentUser.idNguoiChoi)) {
            window.roomPlayers.push(currentUser);
        }

        await safeInvoke("JoinRoom", currentRoomId, currentUser);
        renderLobby({ maPhong: currentRoomId, danhSachNguoiChoi: window.roomPlayers });
        chuyenManHinh("lobby-screen");
    }

    async function toggleSanSang() {
        currentUser.trangThai = currentUser.trangThai === 1 ? 0 : 1;
        const pMe = window.roomPlayers.find(p => getProp(p, "idNguoiChoi") === currentUser.idNguoiChoi);
        if (pMe) setProp(pMe, "trangThai", currentUser.trangThai);

        renderLobby({ maPhong: currentRoomId, danhSachNguoiChoi: window.roomPlayers });
        await safeInvoke("ToggleReady", currentRoomId, currentUser.idNguoiChoi, currentUser.trangThai);
    }

    async function kickNguoiChoi(idPlayer) {
        if (!confirm("Bạn có chắc chắn muốn mời người chơi này ra khỏi phòng?")) return;
        window.roomPlayers = window.roomPlayers.filter(p => getProp(p, "idNguoiChoi") !== idPlayer);
        renderLobby({ maPhong: currentRoomId, danhSachNguoiChoi: window.roomPlayers });
        await safeInvoke("KickPlayer", currentRoomId, idPlayer);
    }

    /* ======================================================== */
    /* 2. CẢNH BÁO KHI CLICK NÚT THOÁT PHÒNG                    */
    /* ======================================================== */
    function roiPhong() {
        if (confirm("Bạn có chắc chắn muốn thoát? Tiến trình trận đấu sẽ bị hủy bỏ.")) {
            safeInvoke("LeaveRoom", currentRoomId, currentUser.idNguoiChoi);
            veTrangChu(true);
        }
    }

    function veTrangChu(force = false) {
        clearInterval(timerInterval);
        currentRoomId = ""; // Reset room ID để tắt chặn beforeunload
        window.roomPlayers = [];
        currentUser.isHost = false;
        currentUser.trangThai = 0;
        chuyenManHinh("home-screen");
    }

    function copyMaPhong() {
        navigator.clipboard.writeText(currentRoomId);
        alert("Đã chép mã phòng: " + currentRoomId);
    }

    function chuyenManHinh(id) {
        document.querySelectorAll(".screen-section").forEach(s => s.classList.remove("screen-active"));
        document.getElementById(id).classList.add("screen-active");
    }

    /* RENDER HIỂN THỊ SẢNH CHỜ */
    function renderLobby(room) {
        if (!room) return;
        document.getElementById("lblMaPhong").innerText = currentRoomId;
        document.getElementById("lblPlayerCount").innerText = `${window.roomPlayers.length}/${MAX_SLOTS}`;

        const btnSanSang = document.getElementById("btnSanSang");
        const btnBatDau = document.getElementById("btnBatDau");

        if (currentUser.isHost) {
            btnSanSang.classList.add("d-none");
            btnBatDau.classList.remove("d-none");
        } else {
            btnSanSang.classList.remove("d-none");
            btnBatDau.classList.add("d-none");

            if (currentUser.trangThai === 1) {
                btnSanSang.className = "btn btn-lg btn-smart-warning px-5 py-3 fs-4 w-50";
                btnSanSang.innerHTML = `<i class="fas fa-times-circle me-2"></i>HỦY SẴN SÀNG`;
            } else {
                btnSanSang.className = "btn btn-lg btn-smart-success px-5 py-3 fs-4 w-50";
                btnSanSang.innerHTML = `<i class="fas fa-check-circle me-2"></i>SẴN SÀNG`;
            }
        }

        const playerList = document.getElementById("player-list");
        playerList.innerHTML = "";

        for (let i = 0; i < MAX_SLOTS; i++) {
            const p = window.roomPlayers[i];
            const col = document.createElement("div");
            col.className = "col-4 col-md-3 col-lg-2";

            if (p) {
                const isReady = getProp(p, "trangThai") === 1;
                const isHost = getProp(p, "isHost") === true;
                const idP = getProp(p, "idNguoiChoi");
                const nameP = getProp(p, "tenNguoiChoi") || "Người chơi";
                const avatarP = getProp(p, "avatar") || "https://api.dicebear.com/7.x/bottts/svg?seed=User";

                const isReadyClass = isReady ? "is-ready" : "";
                const hostCrown = isHost ? `<div class="host-crown"><i class="fas fa-crown"></i></div>` : "";
                const kickBtn = (currentUser.isHost && idP !== currentUser.idNguoiChoi)
                    ? `<button class="btn-kick" onclick="kickNguoiChoi('${idP}')"><i class="fas fa-times"></i></button>` : "";

                col.innerHTML = `
                                <div class="player-card occupied ${isReadyClass}">
                                    ${hostCrown}
                                    ${kickBtn}
                                    <img src="${avatarP}" class="avatar" alt="avt">
                                    <span class="fw-bold fs-6 text-truncate w-100 px-1">${nameP}</span>
                                    <small class="text-muted mt-1 fw-bold">${isReady ? '<span class="text-success"><i class="fas fa-check"></i> Ready</span>' : 'Waiting...'}</small>
                                </div>`;
            } else {
                col.innerHTML = `
                                <div class="player-card">
                                    <div class="avatar d-flex align-items-center justify-content-center text-muted" style="border-style:dashed; background:transparent;">
                                        <i class="fas fa-user-plus fs-4 opacity-50"></i>
                                    </div>
                                    <span class="text-muted small fw-bold opacity-50">Trống</span>
                                </div>`;
            }
            playerList.appendChild(col);
        }
    }

    /* ======================================================== */
    /* 3. LẤY CÂU HỎI TỪ DATABASE QUA API                       */
    /* ======================================================== */
    async function batDauTranDau() {
        const btnBatDau = document.getElementById("btnBatDau");
        if (btnBatDau) btnBatDau.innerHTML = `<i class="fas fa-spinner fa-spin me-2"></i>Đang tải câu hỏi...`;

        try {
            // Lấy thông số từ UI phòng
            const capDo = document.getElementById("selectCapDo").value || "HSK1";
            const soCau = document.getElementById("selectSoCau").value || "10";

            // LƯU Ý: Thay đổi URL này thành Endpoint API lấy câu hỏi thực tế của Backend của bạn
            const apiUrl = `/api/CauHoi/GetDanhSach?capDo=${capDo}&soLuong=${soCau}`;

            const response = await fetch(apiUrl);

            if (response.ok) {
                const dbQuestions = await response.json();
                if (dbQuestions && dbQuestions.length > 0) {
                    window.gameQuestions = dbQuestions;
                } else {
                    throw new Error("API không trả về câu hỏi nào!");
                }
            } else {
                throw new Error("Lỗi Server khi gọi API câu hỏi");
            }
        } catch (error) {
            console.warn("⚠️ Không kết nối được API, đang tải dữ liệu dự phòng (Mockup):", error);

            // Dữ liệu dự phòng nếu API lỗi hoặc chưa code API
            window.gameQuestions = [
                { noiDung: "Anh ấy đang làm gì?", pinyin: "Tā zài zuò shénme?", dapAnA: "Ngủ", dapAnB: "Ăn", dapAnC: "Chơi", dapAnD: "Học", dapAnDung: "D" },
                { noiDung: "你好 có nghĩa là gì?", pinyin: "Nǐ hǎo", dapAnA: "Tạm biệt", dapAnB: "Xin chào", dapAnC: "Cảm ơn", dapAnD: "Xin lỗi", dapAnDung: "B" },
                { noiDung: "Điền từ: 我___去中国学习。", pinyin: "Wǒ ___ qù Zhōngguó xuéxí.", dapAnA: "想 (Muốn)", dapAnB: "在 (Đang)", dapAnC: "很 (Rất)", dapAnD: "和 (Với)", dapAnDung: "A" }
            ];
        }

        // Báo cho Server biết game bắt đầu với bộ câu hỏi đã lấy
        const isSuccess = await safeInvoke("StartMatch", currentRoomId, window.gameQuestions);

        // Nếu Server SignalR rớt, Host tự chạy local để test
        if (!isSuccess) {
            window.currentQuestionIndex = 0;
            window.roomPlayers.forEach(p => setProp(p, "score", 0));
            currentUser.score = 0;
            chuyenManHinh("game-screen");
            renderScoreboard();
            loadCurrentQuestion();
        }

        if (btnBatDau) btnBatDau.innerHTML = `<i class="fas fa-play me-2"></i>BẮT ĐẦU`;
    }

    /* LOGIC THI ĐẤU (GAMEPLAY) */
    function loadCurrentQuestion() {
        if (window.currentQuestionIndex >= window.gameQuestions.length) {
            hienThiKetQua();
            return;
        }

        hasAnsweredCurrentQuestion = false;
        const q = window.gameQuestions[window.currentQuestionIndex];
        dapAnDung = getProp(q, "dapAnDung");

        document.getElementById("lblCauHieuHienTai").innerText = `Câu ${window.currentQuestionIndex + 1} / ${window.gameQuestions.length}`;
        document.getElementById("lblNoiDungCauHoi").innerText = getProp(q, "noiDung");
        document.getElementById("lblPinyinOrMeaning").innerText = getProp(q, "pinyin") || "";

        const optionsContainer = document.getElementById("options-container");
        const btns = optionsContainer.querySelectorAll(".option-btn");

        btns.forEach(btn => {
            btn.classList.remove("correct", "wrong");
            btn.disabled = false;
            const key = btn.getAttribute("data-key");
            btn.querySelector(".option-text").innerText = getProp(q, `dapAn${key}`) || getProp(q, `DapAn${key}`);
        });

        timeRemaining = timePerQuestion;
        document.getElementById("lblTimer").innerText = timeRemaining;

        clearInterval(timerInterval);
        timerInterval = setInterval(demNguocThoiGian, 1000);
    }

    function demNguocThoiGian() {
        timeRemaining--;
        document.getElementById("lblTimer").innerText = timeRemaining;

        if (timeRemaining <= 0) {
            clearInterval(timerInterval);
            if (!hasAnsweredCurrentQuestion) {
                hienThiDapAnDung();
            }
            setTimeout(chuyenCauHoiTiepTheo, 2000);
        }
    }

    async function chonDapAn(selectedKey, btnElement) {
        if (hasAnsweredCurrentQuestion) return;
        hasAnsweredCurrentQuestion = true;
        clearInterval(timerInterval);

        document.querySelectorAll(".option-btn").forEach(b => b.disabled = true);

        if (selectedKey === dapAnDung) {
            btnElement.classList.add("correct");
            const diemDatDuoc = 10 + (timeRemaining * 2);
            currentUser.score += diemDatDuoc;

            const pMe = window.roomPlayers.find(p => getProp(p, "idNguoiChoi") === currentUser.idNguoiChoi);
            if (pMe) setProp(pMe, "score", currentUser.score);

            renderScoreboard();
            safeInvoke("UpdateScore", currentRoomId, currentUser.idNguoiChoi, currentUser.score);
        } else {
            btnElement.classList.add("wrong");
            hienThiDapAnDung();
        }

        setTimeout(chuyenCauHoiTiepTheo, 2000);
    }

    function hienThiDapAnDung() {
        document.querySelectorAll(".option-btn").forEach(b => {
            if (b.getAttribute("data-key") === dapAnDung) {
                b.classList.add("correct");
            }
        });
    }

    function chuyenCauHoiTiepTheo() {
        window.currentQuestionIndex++;
        loadCurrentQuestion();
    }

    function renderScoreboard() {
        const sb = document.getElementById("live-scoreboard");
        if (!sb) return;
        sb.innerHTML = "";

        const sortedPlayers = [...window.roomPlayers].sort((a, b) => (getProp(b, "score") || 0) - (getProp(a, "score") || 0));

        sortedPlayers.forEach((p, index) => {
            const name = getProp(p, "tenNguoiChoi");
            const score = getProp(p, "score") || 0;
            const isMe = getProp(p, "idNguoiChoi") === currentUser.idNguoiChoi;
            const bgClass = isMe ? "bg-primary bg-opacity-10 border border-primary" : "bg-white border";

            let rankIcon = `<span class="fw-bold text-muted px-2">#${index + 1}</span>`;
            if (index === 0) rankIcon = `<i class="fas fa-medal text-warning fs-4"></i>`;
            else if (index === 1) rankIcon = `<i class="fas fa-medal text-secondary fs-4" style="color: #94a3b8 !important;"></i>`;
            else if (index === 2) rankIcon = `<i class="fas fa-medal text-danger fs-4" style="color: #d97706 !important;"></i>`;

            sb.innerHTML += `
                            <div class="d-flex align-items-center justify-content-between p-3 rounded-3 shadow-sm ${bgClass}">
                                <div class="d-flex align-items-center gap-3">
                                    ${rankIcon}
                                    <span class="fw-bold ${isMe ? 'text-primary' : 'text-dark'}">${name}</span>
                                </div>
                                <span class="badge bg-success bg-opacity-25 text-success rounded-pill px-3 py-2 fs-6 border border-success">${score} pt</span>
                            </div>
                        `;
        });
    }

    function hienThiKetQua() {
        // Hủy chặn đóng trang vì game đã xong
        currentRoomId = "";
        chuyenManHinh("result-screen");

        const sortedPlayers = [...window.roomPlayers].sort((a, b) => (getProp(b, "score") || 0) - (getProp(a, "score") || 0));
        const podium = document.getElementById("final-podium");
        podium.innerHTML = "";

        const createPodiumPlace = (player, place) => {
            if (!player) return `<div class="podium-place place-${place}" style="opacity: 0.3"><div class="podium-block"></div></div>`;
            const name = getProp(player, "tenNguoiChoi");
            const avatar = getProp(player, "avatar");
            const score = getProp(player, "score") || 0;
            return `
                            <div class="podium-place place-${place}">
                                <img src="${avatar}" class="avatar" alt="avt">
                                <div class="podium-block shadow-sm">
                                    <div class="fs-4">#${place}</div>
                                    <div class="fs-6 mt-2 text-truncate w-100 px-2 text-center" title="${name}">${name}</div>
                                    <div class="fs-6 text-white-50 mt-1">${score} pt</div>
                                </div>
                            </div>
                        `;
        };

        const p1 = sortedPlayers[0];
        const p2 = sortedPlayers[1];
        const p3 = sortedPlayers[2];

        podium.innerHTML = `
                        ${createPodiumPlace(p2, 2)}
                        ${createPodiumPlace(p1, 1)}
                        ${createPodiumPlace(p3, 3)}
                    `;

        const lbList = document.getElementById("final-leaderboard");
        lbList.innerHTML = `<h5 class="fw-bold text-center mb-4 text-muted"><i class="fas fa-list-ol me-2"></i>BẢNG XẾP HẠNG CHI TIẾT</h5>`;

        sortedPlayers.forEach((p, i) => {
            const name = getProp(p, "tenNguoiChoi");
            const score = getProp(p, "score") || 0;
            const isMeClass = getProp(p, "idNguoiChoi") === currentUser.idNguoiChoi ? 'bg-primary bg-opacity-10 rounded-3 border-primary' : '';

            lbList.innerHTML += `
                            <div class="d-flex justify-content-between align-items-center border-bottom py-3 px-3 ${isMeClass}">
                                <div class="d-flex align-items-center">
                                    <span class="fw-bold text-muted me-3" style="width: 30px">#${i + 1}</span>
                                    <span class="fw-bold text-dark fs-5">${name}</span>
                                </div>
                                <span class="badge bg-primary rounded-pill px-3 py-2 fs-6">${score} Điểm</span>
                            </div>
                        `;
        });
    }
</script>