@{
    ViewData["Title"] = "Luyện Nghe Phản Xạ Từ Vựng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- CSS Tùy Chỉnh -->
<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
    }

    .icon-box {
        width: 50px;
        height: 50px;
        line-height: 50px;
    }

    .card-mode {
        cursor: pointer;
        transition: all 0.25s ease-in-out;
        border-color: #e9ecef;
    }

        .card-mode:hover {
            transform: translateY(-4px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.08);
        }

    .btn-check:checked + .card-mode {
        border-color: #0d6efd !important;
        background-color: rgba(13, 110, 253, 0.03);
        box-shadow: 0 0.25rem 0.75rem rgba(13, 110, 253, 0.15);
    }

    .hover-scale {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .hover-scale:hover {
            transform: scale(1.02);
            box-shadow: 0 0.5rem 1.2rem rgba(13, 110, 253, 0.25) !important;
        }

    .bounce-icon {
        animation: bounce 2s infinite;
    }

    @@keyframes bounce {
        0%, 20%, 50%, 80%, 100% {
            transform: translateY(0);
        }

        40% {
            transform: translateY(-8px);
        }

        60% {
            transform: translateY(-4px);
        }
    }

    .question-card {
        border-left: 5px solid #0d6efd;
        transition: 0.3s;
    }

        .question-card:hover {
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

    .timer-badge {
        font-size: 1.1rem;
        font-weight: bold;
    }

    .sound-wave-icon {
        color: #0d6efd;
        animation: pulse-sound 1.5s infinite;
    }

    @@keyframes pulse-sound {
        0% {
            transform: scale(1);
            opacity: 0.8;
        }

        50% {
            transform: scale(1.15);
            opacity: 1;
        }

        100% {
            transform: scale(1);
            opacity: 0.8;
        }
    }
</style>

<div class="container py-5">

    <!-- PHẦN 1: CÀI ĐẶT BÀI LUYỆN -->
    <div id="setup-section" class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-gradient bg-primary text-white text-center py-4 position-relative">
                    <div class="mb-2"><i class="fas fa-headphones-alt fa-3x bounce-icon"></i></div>
                    <h2 class="fw-bold text-uppercase mb-1">Luyện Nghe Phản Xạ Từ Vựng</h2>
                    <p class="mb-0 text-white-50">Nâng cao phản xạ nghe - hiểu tiếng Trung & Hán Việt qua âm thanh</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form id="formTaoBaiLuyen">
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark fs-6 mb-3">
                                <i class="fas fa-sliders-h text-primary me-2"></i>1. Chọn chế độ phát âm:
                            </label>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <input type="radio" class="btn-check" name="ModeNghe" id="modeMixed" value="MIXED" checked>
                                    <label class="card card-mode h-100 p-3 text-center border-2" for="modeMixed">
                                        <div class="icon-box mx-auto mb-2 bg-primary-subtle text-primary rounded-circle"><i class="fas fa-random fa-lg"></i></div>
                                        <div class="fw-bold text-dark">Hỗn Hợp (Khuyên Dùng)</div>
                                        <small class="text-muted d-block mt-1">Trộn ngẫu nhiên Trung & Việt</small>
                                    </label>
                                </div>
                                <div class="col-md-4">
                                    <input type="radio" class="btn-check" name="ModeNghe" id="modeZH" value="ZH">
                                    <label class="card card-mode h-100 p-3 text-center border-2" for="modeZH">
                                        <div class="icon-box mx-auto mb-2 bg-danger-subtle text-danger rounded-circle"><i class="fas fa-volume-up fa-lg"></i></div>
                                        <div class="fw-bold text-dark">Phát Âm Tiếng Trung</div>
                                        <small class="text-muted d-block mt-1">Nghe Trung ➔ Nhập Việt/Hán</small>
                                    </label>
                                </div>
                                <div class="col-md-4">
                                    <input type="radio" class="btn-check" name="ModeNghe" id="modeVI" value="VI">
                                    <label class="card card-mode h-100 p-3 text-center border-2" for="modeVI">
                                        <div class="icon-box mx-auto mb-2 bg-success-subtle text-success rounded-circle"><i class="fas fa-language fa-lg"></i></div>
                                        <div class="fw-bold text-dark">Phát Âm Tiếng Việt</div>
                                        <small class="text-muted d-block mt-1">Nghe Việt ➔ Nhập Hán/Pinyin</small>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4 text-muted opacity-25">

                        <div class="row g-4">
                            <div class="col-md-4">
                                <label for="IdCapDo" class="form-label fw-bold text-dark fs-6">
                                    <i class="fas fa-layer-group text-primary me-2"></i>2. Cấp độ HSK:
                                </label>
                                <select class="form-select form-select-lg rounded-3 fs-6" id="IdCapDo" name="IdCapDo">
                                    <option value="">-- Tất cả cấp độ --</option>
                                    <option value="1">HSK 1</option>
                                    <option value="2">HSK 2</option>
                                    <option value="3">HSK 3 </option>
                                    <option value="4">HSK 4</option>
                                    <option value="5">HSK 5</option>
                                    <option value="6">HSK 6</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label for="SoLuong" class="form-label fw-bold text-dark fs-6">
                                    <i class="fas fa-list-ol text-primary me-2"></i>3. Số lượng từ vựng:
                                </label>
                                <select class="form-select form-select-lg rounded-3 fs-6" id="SoLuong" name="SoLuong">
                                    <option value="5">5 Từ vựng (Khởi động)</option>
                                    <option value="10" selected>10 Từ vựng (Tiêu chuẩn)</option>
                                    <option value="20">20 Từ vựng (Thử thách)</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label for="ThoiGianSuyNghi" class="form-label fw-bold text-dark fs-6">
                                    <i class="fas fa-clock text-primary me-2"></i>4. Thời gian/câu:
                                </label>
                                <select class="form-select form-select-lg rounded-3 fs-6" id="ThoiGianSuyNghi" name="ThoiGianSuyNghi">
                                    <option value="5">5 Giây (Siêu tốc)</option>
                                    <option value="10">10 Giây (Nhanh)</option>
                                    <option value="15" selected>15 Giây (Mặc định)</option>
                                    <option value="20">20 Giây (Trung bình)</option>
                                    <option value="30">30 Giây (Thoải mái)</option>
                                </select>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-5">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold py-3 shadow-sm hover-scale" id="btnStart">
                                <i class="fas fa-play-circle me-2"></i>BẮT ĐẦU LUYỆN NGHE PHẢN XẠ
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- PHẦN 2: LÀM BÀI (ẨN LÚC ĐẦU) -->
    <div id="test-section" class="row justify-content-center d-none">
        <div class="col-lg-8 col-md-10">
            <!-- THANH ĐỒNG HỒ & NÚT THOÁT -->
            <div class="card mb-4 border-0 shadow-sm bg-primary text-white sticky-top" style="top: 15px; z-index: 1020;">
                <div class="card-body d-flex align-items-center justify-content-between py-2 px-4">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-stopwatch me-2 fs-5"></i>
                        <span class="fw-bold me-2">Thời gian:</span>
                        <span class="badge bg-white text-primary timer-badge px-3 py-2" id="global-timer">00:00</span>
                    </div>
                    <button type="button" class="btn btn-outline-light btn-sm rounded-pill px-3 fw-bold" onclick="yeuCauThoat()">
                        <i class="fas fa-sign-out-alt me-1"></i>Thoát bài
                    </button>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="fw-bold text-primary mb-0"><i class="fas fa-headphones sound-wave-icon me-2"></i>Đang làm bài...</h3>
                <small class="text-muted"><i class="fas fa-info-circle me-1"></i>Âm thanh sẽ tự động phát khi chọn vào ô đáp án</small>
            </div>

            <div id="questions-container">
                <!-- Danh sách câu hỏi render từ JS -->
            </div>

            <div class="d-grid mt-4">
                <button type="button" class="btn btn-success btn-lg rounded-pill fw-bold py-3 shadow" id="btnSubmitTest">
                    <i class="fas fa-check-circle me-2"></i>NỘP BÀI & CHẤM ĐIỂM
                </button>
            </div>
        </div>
    </div>

    <!-- PHẦN 3: KẾT QUẢ (ẨN LÚC ĐẦU) -->
    <div id="result-section" class="row justify-content-center d-none">
        <div class="col-lg-10">
            <div class="card border-0 shadow rounded-4 mb-4">
                <div class="card-header bg-success text-white text-center py-4">
                    <h2 class="fw-bold mb-0"><i class="fas fa-trophy me-2"></i>KẾT QUẢ LUYỆN TẬP</h2>
                </div>
                <div class="card-body p-4 text-center">
                    <h1 class="display-1 fw-bold text-primary" id="final-score">0.0</h1>
                    <h4 class="text-muted mb-4">Số câu đúng: <span id="correct-count">0</span> / <span id="total-count">0</span></h4>

                    <div class="table-responsive text-start">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Phát âm</th>
                                    <th>Kết quả</th>
                                    <th>Bạn nhập</th>
                                    <th>Đáp án chuẩn</th>
                                    <th>Thông tin từ</th>
                                </tr>
                            </thead>
                            <tbody id="result-tbody">
                                <!-- Chi tiết kết quả render từ JS -->
                            </tbody>
                        </table>
                    </div>

                    <button class="btn btn-primary btn-lg mt-4 rounded-pill px-5 fw-bold" onclick="resetUI()">
                        <i class="fas fa-redo me-2"></i>Luyện tập lại
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- MODAL XÁC NHẬN THOÁT BÀI LUYỆN -->
<div class="modal fade" id="modalThoat" tabindex="-1" aria-labelledby="modalThoatLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-warning text-dark border-0">
                <h5 class="modal-title fw-bold" id="modalThoatLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Xác nhận thoát
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4 fs-5">
                Bạn có muốn thoát không?<br />
                <small class="text-muted fs-6">Kết quả làm bài hiện tại sẽ không được lưu.</small>
            </div>
            <div class="modal-footer border-0 justify-content-center pb-4">
                <button type="button" class="btn btn-light rounded-pill px-4 me-2 fw-bold" data-bs-dismiss="modal">Ở lại làm tiếp</button>
                <button type="button" class="btn btn-danger rounded-pill px-4 fw-bold" onclick="xacNhanThoatBai()">Đồng ý thoát</button>
            </div>
        </div>
    </div>
</div>

<!-- Thẻ audio ẩn dùng để phát âm thanh -->
<audio id="global-audio-player" class="d-none"></audio>

<script src="~/js/quanlytuvung/luyennghetuvung.js" asp-append-version="true"></script>   