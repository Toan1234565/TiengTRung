@using HocTiengTrung_3._0_T.Models12
@model HocTiengTrung_3._0_T.Models12.QuanLyTaiKhoan.NguoiDungModels
@{
    ViewData["Title"] = "Hồ sơ cá nhân - " + (Model?.HoTen ?? "Học viên");
    var taiKhoan = Model?.IdTaiKhoanNavigation;

    // Giải mã an toàn Email và Số điện thoại hiển thị
    string? plainEmail = GiaiMaHelper.GiaiMaAnToan(Model?.Email);
    string? plainPhone = GiaiMaHelper.GiaiMaAnToan(Model?.SoDienThoai);

    // Xử lý avatar hiển thị
    string avatarHienThi = string.IsNullOrEmpty(Model?.AnhDaiDien) || Model.AnhDaiDien == "default_avatar.png"
        ? "https://ui-avatars.com/api/?name=" + Uri.EscapeDataString(Model?.HoTen ?? "Học viên") + "&background=random"
        : Model.AnhDaiDien;

    // Lấy ID học viên cho liên kết bài tập
    int idHocVien = Model?.IdUser ?? 0;
}

<div class="container mt-4 mb-5">
    <div class="row g-4">
        <!-- Cột trái: Thông tin cá nhân & Thao tác nhanh -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body text-center p-4">
                    <div class="position-relative d-inline-block mb-3">
                        <img id="imgAvatarProfile"
                             src="@avatarHienThi"
                             alt="Avatar"
                             class="rounded-circle border border-3 border-white shadow-sm object-fit-cover"
                             style="width: 120px; height: 120px;" />
                        <span class="position-absolute bottom-0 end-0 badge rounded-pill bg-success border border-2 border-white p-2"
                              title="Tài khoản hoạt động">
                            <i class="fa-solid fa-check"></i>
                        </span>
                    </div>

                    <h4 class="fw-bold mb-1 text-dark" id="lblHoTenCard">@(Model?.HoTen ?? "Chưa cập nhật")</h4>
                    <p class="text-muted small mb-2">
                        <span class="font-monospace text-primary">@@@(taiKhoan?.TenDangNhap ?? "---")</span>
                    </p>
                    <span class="badge bg-primary-subtle text-primary border rounded-pill px-3 py-2">
                        <i class="fa-solid fa-graduation-cap me-1"></i> @(taiKhoan?.TenVaiTro ?? "Học viên chính thức")
                    </span>

                    <hr class="my-4 opacity-50">

                    <!-- Danh sách thông tin chi tiết -->
                    <div class="text-start p-3 bg-light rounded-3">
                        <div class="mb-3 d-flex align-items-center">
                            <div class="icon-box bg-info-subtle text-info rounded-3 p-2 me-3">
                                <i class="fa-solid fa-id-card"></i>
                            </div>
                            <div class="overflow-hidden">
                                <small class="text-muted d-block">Họ và tên</small>
                                <span class="fw-600 text-dark text-truncate d-block" id="lblHoTenDetail">@(Model?.HoTen ?? "Chưa cập nhật")</span>
                            </div>
                        </div>

                        <div class="mb-3 d-flex align-items-center">
                            <div class="icon-box bg-primary-subtle text-primary rounded-3 p-2 me-3">
                                <i class="fa-solid fa-envelope"></i>
                            </div>
                            <div class="overflow-hidden">
                                <small class="text-muted d-block">Email</small>
                                <span class="fw-600 text-dark text-truncate d-block" id="lblEmailDetail">@(plainEmail ?? "Chưa cập nhật")</span>
                            </div>
                        </div>

                        <div class="mb-3 d-flex align-items-center">
                            <div class="icon-box bg-success-subtle text-success rounded-3 p-2 me-3">
                                <i class="fa-solid fa-phone"></i>
                            </div>
                            <div class="overflow-hidden">
                                <small class="text-muted d-block">Số điện thoại</small>
                                <span class="fw-600 text-dark text-truncate d-block" id="lblPhoneDetail">@(plainPhone ?? "Chưa cập nhật")</span>
                            </div>
                        </div>

                        <div class="mb-3 d-flex align-items-center">
                            <div class="icon-box bg-warning-subtle text-warning rounded-3 p-2 me-3">
                                <i class="fa-solid fa-cake-candles"></i>
                            </div>
                            <div class="overflow-hidden">
                                <small class="text-muted d-block">Ngày sinh</small>
                                <span class="fw-600 text-dark" id="lblDobDetail">@(Model?.NgaySinh?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center">
                            <div class="icon-box bg-secondary-subtle text-secondary rounded-3 p-2 me-3">
                                <i class="fa-solid fa-school"></i>
                            </div>
                            <div class="overflow-hidden">
                                <small class="text-muted d-block">Cơ sở trực thuộc</small>
                                <span class="fw-600 text-dark text-truncate d-block">@(Model?.TenTrungTam ?? "Hệ thống chung")</span>
                            </div>
                        </div>
                    </div>

                    <!-- Các nút hành động -->
                    <div class="d-grid mt-4 gap-2">
                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill py-2 fw-semibold shadow-sm"
                                data-bs-toggle="modal" data-bs-target="#updateProfileModal">
                            <i class="fa-solid fa-user-pen me-1"></i> Chỉnh sửa hồ sơ
                        </button>

                        <a asp-controller="QuanLyDanhSachBaiTap"
                           asp-action="LichSuLuyenTap"
                           asp-route-idHocVien="@idHocVien"
                           class="btn btn-success btn-sm rounded-pill py-2 fw-semibold shadow-sm">
                            <i class="fa-solid fa-clock-rotate-left me-1"></i> Lịch sử bài tập của tôi
                        </a>

                        <a href="@Url.Action("LichSuaDeThi", "QuanLyDeThi")"
                           class="btn btn-danger btn-sm rounded-pill py-2 fw-semibold shadow-sm">
                            <i class="fa-solid fa-medal me-1"></i> Lịch sử đề thi
                        </a>

                        <button type="button" class="btn btn-outline-warning btn-sm rounded-pill py-2 fw-semibold mt-1"
                                data-bs-toggle="modal" data-bs-target="#changePasswordModal">
                            <i class="fa-solid fa-key me-1"></i> Đổi mật khẩu
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: KPI Thống kê & Tiến độ học tập -->
        <div class="col-lg-8">
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 bg-primary text-white h-100">
                        <div class="card-body p-4 d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1 text-white-50">Từ vựng đã thuộc</h6>
                                <h2 class="mb-0 fw-bold">@(Model?.DanhSachTuVungs?.Count(x => x.DaThuoc == true) ?? 0)</h2>
                            </div>
                            <i class="fa-solid fa-book-bookmark fa-3x opacity-25"></i>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 bg-info text-white h-100">
                        <div class="card-body p-4 d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1 text-white-50">Tổng từ đang học</h6>
                                <h2 class="mb-0 fw-bold">@(Model?.DanhSachTuVungs?.Count ?? 0)</h2>
                            </div>
                            <i class="fa-solid fa-layer-group fa-3x opacity-25"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bảng Lịch sử học từ vựng -->
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="mb-0 fw-bold text-dark">
                        <i class="fa-solid fa-list-check text-primary me-2"></i>Lịch sử học từ vựng
                    </h5>
                    <a href="@Url.Action("DanhSachTuVung", "QuanLyDanhSachTuVung", new { capdo = 1, trangThai = "learned" })"
                       class="btn btn-link btn-sm text-decoration-none">
                        Xem tất cả từ đã thuộc <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-secondary small text-uppercase">
                                <tr>
                                    <th class="ps-4">Từ vựng</th>
                                    <th>Trạng thái</th>
                                    <th>Ngày đánh dấu</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model?.DanhSachTuVungs != null && Model.DanhSachTuVungs.Any())
                                {
                                    var top10Vocs = Model.DanhSachTuVungs
                                        .OrderByDescending(x => x.NgayDanhDau)
                                        .Take(10);

                                    foreach (var item in top10Vocs)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-bold text-primary">@item.TuVung</td>
                                            <td>
                                                @if (item.DaThuoc == true)
                                                {
                                                    <span class="badge bg-success-subtle text-success rounded-pill px-3">
                                                        <i class="fa-solid fa-check-double me-1"></i> Đã thuộc
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-3">
                                                        <i class="fa-solid fa-clock me-1"></i> Đang học
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-muted small">
                                                @(item.NgayDanhDau.HasValue ? item.NgayDanhDau.Value.ToString("dd/MM/yyyy HH:mm") : "---")
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center py-5 text-muted">
                                            <i class="fa-solid fa-folder-open fa-3x mb-3 d-block opacity-25"></i>
                                            Bạn chưa bắt đầu học từ vựng nào.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- 1. MODAL CẬP NHẬT THÔNG TIN HỒ SƠ CÁ NHÂN -->
<!-- ========================================== -->
<div class="modal fade" id="updateProfileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold">
                    <i class="fa-solid fa-user-pen me-2"></i>Cập nhật thông tin cá nhân
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="updateProfileForm" onsubmit="submitUpdateProfile(event)">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                        <input type="text" id="updHoTen" class="form-control" value="@Model?.HoTen" required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Email</label>
                            <input type="email" id="updEmail" class="form-control" value="@plainEmail" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Số điện thoại</label>
                            <input type="tel" id="updSoDienThoai" class="form-control" value="@plainPhone" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Ngày sinh</label>
                        <input type="date" id="updNgaySinh" class="form-control" value="@(Model?.NgaySinh?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Ảnh đại diện</label>
                        <div class="d-flex align-items-center gap-3">
                            <img id="imgPreviewAvatarModal"
                                 src="@avatarHienThi"
                                 alt="Avatar Preview"
                                 class="rounded-circle border object-fit-cover shadow-sm"
                                 style="width: 60px; height: 60px;" />
                            <div class="flex-grow-1">
                                <input type="file" class="form-control" id="fileAvatarInput" accept="image/*" onchange="previewAvatar(event)">
                                <small class="text-muted d-block mt-1">Định dạng JPG, PNG, WEBP (Tối đa 5MB).</small>
                            </div>
                        </div>
                        <input type="hidden" id="updAnhDaiDienHienTai" value="@(Model?.AnhDaiDien ?? "")" />
                    </div>
                </div>

                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" id="btnSubmitProfile" class="btn btn-primary fw-bold px-4">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- 2. MODAL ĐỔI MẬT KHẨU                      -->
<!-- ========================================== -->
<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-warning-subtle text-warning-emphasis">
                <h5 class="modal-title fw-bold">
                    <i class="fa-solid fa-key me-2"></i>Đổi mật khẩu tài khoản
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="changePasswordForm" onsubmit="submitChangePassword(event)">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mật khẩu hiện tại <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="password" id="oldPass" class="form-control" required placeholder="Nhập mật khẩu đang dùng" />
                            <button class="btn btn-outline-secondary" type="button" onclick="togglePass('oldPass', this)">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mật khẩu mới <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="password" id="newPass" class="form-control" required minlength="6" placeholder="Tối thiểu 6 ký tự" />
                            <button class="btn btn-outline-secondary" type="button" onclick="togglePass('newPass', this)">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                        <input type="password" id="confirmPass" class="form-control" required minlength="6" placeholder="Nhập lại mật khẩu mới" />
                        <div class="invalid-feedback" id="feedbackConfirmPass">Mật khẩu xác nhận không khớp!</div>
                    </div>
                </div>

                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" id="btnSubmitPass" class="btn btn-warning fw-bold px-4">
                        <i class="fa-solid fa-check me-1"></i> Xác nhận đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .fw-600 {
        font-weight: 600;
    }

    .bg-primary-subtle {
        background-color: #e7f1ff;
    }

    .bg-success-subtle {
        background-color: #e1f7ec;
    }

    .bg-warning-subtle {
        background-color: #fff8e6;
    }

    .icon-box {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // Xem trước ảnh khi chọn file từ máy
    function previewAvatar(event) {
        const file = event.target.files[0];
        if (file) {
            if (file.size > 5 * 1024 * 1024) {
                Swal.fire('Cảnh báo', 'Ảnh đại diện không được vượt quá 5MB!', 'warning');
                event.target.value = '';
                return;
            }

            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('imgPreviewAvatarModal').src = e.target.result;
            };
            reader.readAsDataURL(file);
        }
    }

    // Ẩn/Hiện mật khẩu
    function togglePass(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }

    // ==========================================
    // 1. CẬP NHẬT HỒ SƠ (DÙNG FORMDATA GỬI FILE)
    // ==========================================
    async function submitUpdateProfile(e) {
        e.preventDefault();

        const hoTen = document.getElementById('updHoTen').value.trim();
        const email = document.getElementById('updEmail').value.trim();
        const soDienThoai = document.getElementById('updSoDienThoai').value.trim();
        const ngaySinh = document.getElementById('updNgaySinh').value;

        if (!hoTen) {
            Swal.fire('Cảnh báo', 'Họ tên không được để trống!', 'warning');
            return;
        }

        const formData = new FormData();
        formData.append('HoTen', hoTen);
        if (email) formData.append('Email', email);
        if (soDienThoai) formData.append('SoDienThoai', soDienThoai);
        if (ngaySinh) formData.append('NgaySinh', ngaySinh);

        const fileInput = document.getElementById('fileAvatarInput');
        if (fileInput && fileInput.files.length > 0) {
            formData.append('fileAnhDaiDien', fileInput.files[0]);
        } else {
            const currentAvatar = document.getElementById('updAnhDaiDienHienTai').value;
            if (currentAvatar) formData.append('AnhDaiDien', currentAvatar);
        }

        const btn = document.getElementById('btnSubmitProfile');
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Đang lưu...';

        try {
            const response = await fetch('/api/quanlytaikhoannguoidung/cap-nhat-thong-tin', {
                method: 'POST',
                body: formData
            });

            const result = await response.json();

            if (response.ok && result.success) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('updateProfileModal'));
                if (modal) modal.hide();

                Swal.fire({
                    icon: 'success',
                    title: 'Thành công!',
                    text: result.message || 'Cập nhật thông tin thành công!',
                    timer: 1500,
                    showConfirmButton: false
                }).then(() => {
                    location.reload();
                });
            } else {
                Swal.fire('Thất bại', result.message || 'Có lỗi xảy ra khi cập nhật.', 'error');
            }
        } catch (err) {
            Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ.', 'error');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-floppy-disk me-1"></i> Lưu thay đổi';
        }
    }

    // ==========================================
    // 2. ĐỔI MẬT KHẨU
    // ==========================================
    async function submitChangePassword(e) {
        e.preventDefault();

        const matKhauCu = document.getElementById('oldPass').value.trim();
        const matKhauMoi = document.getElementById('newPass').value.trim();
        const xacNhan = document.getElementById('confirmPass').value.trim();
        const confirmInput = document.getElementById('confirmPass');

        if (matKhauMoi !== xacNhan) {
            confirmInput.classList.add('is-invalid');
            return;
        }
        confirmInput.classList.remove('is-invalid');

        const btn = document.getElementById('btnSubmitPass');
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Đang đổi...';

        try {
            const response = await fetch('/api/quanlytaikhoannguoidung/doi-mat-khau', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    matKhauCu: matKhauCu,
                    matKhauMoi: matKhauMoi
                })
            });

            const result = await response.json();

            if (response.ok && result.success) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('changePasswordModal'));
                if (modal) modal.hide();

                Swal.fire({
                    icon: 'success',
                    title: 'Thành công!',
                    text: result.message || 'Đổi mật khẩu thành công!',
                    confirmButtonText: 'Đóng'
                });

                document.getElementById('changePasswordForm').reset();
            } else {
                Swal.fire('Thất bại', result.message || 'Mật khẩu cũ không chính xác.', 'error');
            }
        } catch (err) {
            Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ.', 'error');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-check me-1"></i> Xác nhận đổi';
        }
    }
</script>